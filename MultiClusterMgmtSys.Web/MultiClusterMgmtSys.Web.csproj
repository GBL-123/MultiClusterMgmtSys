<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>MUD0002</WarningsAsErrors>
    <UserSecretsId>1569137f-c939-4023-8b73-9a7de10cc0cf</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Extensions.MudBlazor.StaticInput" Version="4.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MultiClusterMgmtSys.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\js\show-password.js" />
    <!-- 由 vite 构建产出(见下方 BuildChartBundle target),产物不入 git -->
    <None Include="wwwroot\js\dashboard-trend.js" Condition="Exists('wwwroot\js\dashboard-trend.js')" />
  </ItemGroup>

  <!-- 图表 bundle:vite 构建 eucharts 入口脚本到 wwwroot/js。
       前置条件:本目录已执行 npm install(node_modules 存在);Docker 走独立 node 阶段,传 -p:SkipVite=true 跳过。 -->
  <Target Name="BuildChartBundle" BeforeTargets="AssignTargetPaths" Condition="'$(SkipVite)' != 'true'"
          Inputs="package.json;vite.config.mjs;Assets\Scripts\**"
          Outputs="wwwroot\js\dashboard-trend.js">
    <Message Importance="high" Text="vite: 构建图表 bundle (npm run build)" Condition="Exists('node_modules\.bin\vite.cmd')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="Exists('node_modules\.bin\vite.cmd')" ConsoleToMsBuild="false" />
    <Warning Code="MCMS001" Text="未找到 node_modules,跳过图表 bundle 构建(先执行: cd MultiClusterMgmtSys.Web &amp;&amp; npm install)" Condition="!Exists('node_modules\.bin\vite.cmd') and !Exists('node_modules/.bin/vite')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MultiClusterMgmtSys.Domain\MultiClusterMgmtSys.Domain.csproj" />
    <ProjectReference Include="..\MultiClusterMgmtSys.Application\MultiClusterMgmtSys.Application.csproj" />
    <ProjectReference Include="..\MultiClusterMgmtSys.Infrastructure\MultiClusterMgmtSys.Infrastructure.csproj" />
  </ItemGroup>

</Project>
