@using MultiClusterMgmtSys.Application.ViewModels

<MudCard Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">运行状态</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">副本数</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@Detail.DesiredCount</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">就绪</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@Detail.ReadyCount</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">已更新</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@Detail.UpdatedCount</MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">标签选择器</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Detail.Selector) ? "—" : Detail.Selector)</MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">UID</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@Detail.Uid</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">创建时间</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(Detail.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudText>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public WorkloadDetailViewModel Detail { get; set; } = default!;
}
