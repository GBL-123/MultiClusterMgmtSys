@page "/not-found"
@layout EmptyLayout

<PageTitle>页面不存在</PageTitle>

<MudPaper Elevation="0" Class="fallback-page">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudText Typo="Typo.caption" Class="fallback-code font-mono">404 // NOT FOUND</MudText>
        <MudText Typo="Typo.h5" Class="fallback-title">页面不存在</MudText>
        <MudText Class="fallback-hint">你访问的地址没有对应页面,可能已被移动或删除。</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/clusters">返回集群列表</MudButton>
    </MudStack>
</MudPaper>
