@page "/Error"
@layout EmptyLayout
@using System.Diagnostics

<PageTitle>请求处理出错</PageTitle>

<MudPaper Elevation="0" Class="fallback-page">
    <MudStack AlignItems="AlignItems.Center" Spacing="3">
        <MudText Typo="Typo.caption" Class="fallback-code font-mono">500 // INTERNAL ERROR</MudText>
        <MudText Typo="Typo.h5" Class="fallback-title">请求处理出错</MudText>
        <MudText Class="fallback-hint">请稍后重试;若问题持续出现,请携带以下请求 ID 联系管理员。</MudText>
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.caption" Class="fallback-request-id font-mono">REQUEST ID // @RequestId</MudText>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/clusters">返回集群列表</MudButton>
    </MudStack>
</MudPaper>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
