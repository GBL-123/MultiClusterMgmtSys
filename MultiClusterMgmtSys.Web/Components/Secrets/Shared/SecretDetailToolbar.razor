@using MultiClusterMgmtSys.Application.ViewModels

@inject NavigationManager NavigationManager

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => NavigationManager.NavigateTo($"/secrets/{ClusterId}"))">
            返回列表
        </MudButton>
        <MudText Typo="Typo.h4" Class="flex-auto ml-2">@Name</MudText>
        @if (Detail?.CanOperate == true)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled">
                键数： @Detail.Entries.Count
            </MudChip>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRefresh"
                   Disabled="Processing">
            @if (Processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            刷新
        </MudButton>
        @if (Detail?.CanOperate == true)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Key"
                       OnClick="OnEditYaml">
                编辑 YAML
            </MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public SecretDetailViewModel? Detail { get; set; }

    [Parameter]
    public bool Processing { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public EventCallback OnEditYaml { get; set; }
}
