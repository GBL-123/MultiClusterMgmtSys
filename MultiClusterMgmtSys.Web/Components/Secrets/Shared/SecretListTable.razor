@using MultiClusterMgmtSys.Application.ViewModels

<MudTable T="SecretListViewModel"
          Items="@Items"
          Hover="true"
          FixedHeader="true"
          Loading="Loading"
          Class="secrets-table">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="SecretListViewModel" SortBy="@(x => x.Name)" SortLabel="Name">名称</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SecretListViewModel" SortBy="@(x => x.Namespace)" SortLabel="Namespace">命名空间</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SecretListViewModel" SortBy="@(x => x.Type)" SortLabel="Type">类型</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SecretListViewModel" SortBy="@(x => x.KeyCount)" SortLabel="KeyCount">键数</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SecretListViewModel" SortBy="@(x => x.CreatedAt)" SortLabel="CreatedAt">创建时间</MudTableSortLabel></MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            <MudText Class="font-mono link-primary"
                     @onclick="() => OnNavigateDetail.InvokeAsync((context.Namespace, context.Name))">
                @context.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="命名空间">
            <MudChip T="string" Size="Size.Small" Class="font-mono">@context.Namespace</MudChip>
        </MudTd>
        <MudTd DataLabel="类型"><span class="font-mono">@(context.Type ?? "—")</span></MudTd>
        <MudTd DataLabel="键数"><span class="font-mono">@context.KeyCount</span></MudTd>
        <MudTd DataLabel="创建时间"><span class="font-mono">@(context.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></MudTd>
        <MudTd DataLabel="操作">
            <div class="d-flex" style="gap: 4px;">
                <TooltipIconButton Text="详情"
                                   Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnNavigateDetail.InvokeAsync((context.Namespace, context.Name)))" />
                @if (context.CanOperate)
                {
                    <TooltipIconButton Text="编辑 YAML"
                                       Icon="@Icons.Material.Filled.Code"
                                       OnClick="@(() => OnNavigateEdit.InvokeAsync((context.Namespace, context.Name)))" />
                    <TooltipIconButton Text="删除"
                                       Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error"
                                       OnClick="@(() => OnDelete.InvokeAsync((context.Namespace, context.Name)))" />
                }
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="每页条数：" InfoFormat="共 {all_items} 条" />
    </PagerContent>
    <LoadingContent>
        <MudText Class="pa-4 font-mono mud-text-secondary">// 正在加载...</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <div class="empty-state">[ 暂无密钥 ]</div>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public IReadOnlyList<SecretListViewModel> Items { get; set; } = new List<SecretListViewModel>();

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnNavigateDetail { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnNavigateEdit { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnDelete { get; set; }
}
