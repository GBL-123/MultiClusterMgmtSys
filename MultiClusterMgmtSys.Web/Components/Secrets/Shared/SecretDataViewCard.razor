@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Application.Services

@inject ExceptionPresenter ExHandler

<MudCard Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">键值</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (Entries.Count == 0)
        {
            <div class="empty-state">[ 暂无键值 ]</div>
        }
        else
        {
            <MudTable T="SecretKeyItemViewModel"
                      Items="@Entries.OrderBy(e => e.Key).ToList()"
                      Hover="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh Style="width:22%;">键</MudTh>
                    <MudTh Style="width:14%;">类型</MudTh>
                    <MudTh>内容</MudTh>
                    <MudTh Style="width:120px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="键">
                        <span class="font-mono">@context.Key</span>
                    </MudTd>
                    <MudTd DataLabel="类型">
                        @if (context.IsText)
                        {
                            <span>文本 · @context.ByteCount 字节</span>
                        }
                        else
                        {
                            <span>二进制 · @context.ByteCount 字节</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="内容">
                        @if (!context.IsText)
                        {
                            <span class="font-mono secret-base64-cell">@context.Base64</span>
                        }
                        else if (_revealed.ContainsKey(context.Key))
                        {
                            <div class="secret-revealed-value font-mono">@_revealed[context.Key]</div>
                        }
                        else
                        {
                            <span class="font-mono secret-masked-value">••••••••</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="操作">
                        @if (context.IsText)
                        {
                            <span class="d-inline-flex" style="gap: 4px;">
                                @if (_revealed.ContainsKey(context.Key))
                                {
                                    <TooltipIconButton Text="隐藏"
                                                       Icon="@Icons.Material.Filled.VisibilityOff"
                                                       OnClick="@(() => Hide(context.Key))" />
                                }
                                else
                                {
                                    <TooltipIconButton Text="查看明文"
                                                       Icon="@Icons.Material.Filled.Visibility"
                                                       Color="Color.Primary"
                                                       Disabled="@(_revealing is not null)"
                                                       OnClick="@(() => Reveal(context.Key))" />
                                }
                            </span>
                        }
                        else
                        {
                            <span class="mud-text-secondary">—</span>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public IReadOnlyList<SecretKeyItemViewModel> Entries { get; set; } = [];

    [Parameter]
    public Func<string, Task<string>>? OnReveal { get; set; }

    private Dictionary<string, string> _revealed = new();

    private string? _revealing;

    private async Task Reveal(string key)
    {
        if (OnReveal is null)
        {
            return;
        }
        _revealing = key;
        try
        {
            var plaintext = await OnReveal(key);
            if (plaintext is not null)
            {
                _revealed[key] = plaintext;
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "查看明文");
        }
        finally
        {
            _revealing = null;
        }
    }

    private void Hide(string key)
    {
        _revealed.Remove(key);
    }
}
