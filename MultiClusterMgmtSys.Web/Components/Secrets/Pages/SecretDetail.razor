@attribute [Authorize]
@page "/secrets/{ClusterId:int}/{Namespace}/{Name}"

@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Web.Components.Secrets.Shared

@inject SecretService SecretService
@inject ClusterSelectionState ClusterSelection
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>Secret 详情: @Name</PageTitle>

<MudStack Class="flex-auto d-flex" Style="align-self: stretch; min-height: 0;">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_detail is null)
    {
        <MudCard Class="pa-4" Elevation="2">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">Secret 不存在或已被删除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/secrets/{ClusterId}"))">
                        返回列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <SecretDetailToolbar ClusterId="@ClusterId"
                             Name="@Name"
                             Detail="@_detail"
                             Processing="@_loading"
                             OnRefresh="LoadAsync"
                             OnEditYaml="@(() => NavigationManager.NavigateTo($"/secrets/{ClusterId}/{Namespace}/{Name}/yaml"))" />
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex"
                 Class="detail-tabs"
                 Elevation="0"
                 Rounded="false"
                 TabPanelsClass="detail-tabs-panels">
            <MudTabPanel Text="YAML">
                @if (_detail.CanOperate)
                {
                    <SecretYamlViewCard Yaml="@_detail.Yaml" />
                }
                else
                {
                    <MudCard Class="pa-4" Elevation="1">
                        <MudCardContent>
                            <MudText Align="Align.Center" Class="mud-text-secondary">无权查看该 Secret 的内容</MudText>
                        </MudCardContent>
                    </MudCard>
                }
            </MudTabPanel>
            <MudTabPanel Text="键值">
                @if (_detail.CanOperate)
                {
                    <SecretDataViewCard Entries="@_detail.Entries" OnReveal="RevealKeyAsync" />
                }
                else
                {
                    <MudCard Class="pa-4" Elevation="1">
                        <MudCardContent>
                            <MudText Align="Align.Center" Class="mud-text-secondary">无权查看该 Secret 的内容</MudText>
                        </MudCardContent>
                    </MudCard>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Namespace { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";


    private SecretDetailViewModel? _detail;

    private bool _loading = true;

    private int _activeTabIndex;

    protected override async Task OnInitializedAsync()
    {
        ClusterSelection.Set(ClusterId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _detail = await SecretService.GetSecretDetailAsync(new SecretKeyRequest(ClusterId, Name, Namespace));
            if (_detail is null)
            {
                Snackbar.Add("Secret 不存在或已被删除", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载详情");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<string> RevealKeyAsync(string key)
    {
        var plaintext = await SecretService.RevealSecretKeyAsync(new SecretRevealRequest(ClusterId, Name, Namespace, key));
        return plaintext;
    }
}
