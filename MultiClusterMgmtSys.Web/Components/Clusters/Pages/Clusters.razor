@attribute [Authorize]
@page "/clusters"
@implements IDisposable

@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Web.Components.Clusters.Shared
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.ViewModels

@inject ClusterService ClusterService
@inject GroupService GroupService
@inject ClusterSyncSettingService SyncSettingSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject RedirectManager RedirectManager
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>集群管理</PageTitle>

<MudStack Row="true" Class="d-flex flex-auto">
    <GroupSidebar Groups="@_groups"
                  UngroupedCount="@_ungroupedCount"
                  OnGroupSelected="SelectGroup"
                  OnCreateGroup="OpenCreateGroupDialog"
                  OnRenameGroup="OpenRenameGroupDialog"
                  OnDeleteGroup="DeleteGroup" />

    <MudStack Class="flex-auto">
        <MudPaper Class="pa-4">
            <MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h5">集群管理</MudText>
                    <MudSpacer />
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Inherit"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Disabled="@_isRefreshingAll"
                                       OnClick="RefreshAllClustersAsync">
                                @(_isRefreshingAll ? "刷新中..." : "刷新所有集群")
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <MudButton Variant="@(_isBatchMode ? Variant.Filled : Variant.Text)"
                                       Color="@(_isBatchMode ? Color.Secondary : Color.Inherit)"
                                       StartIcon="@(_isBatchMode ? Icons.Material.Filled.Close : Icons.Material.Filled.Checklist)"
                                       OnClick="ToggleBatchMode">
                                @(_isBatchMode ? "退出批量" : "批量操作")
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <MudButton Variant="Variant.Filled"
                                        Color="Color.Primary"
                                        StartIcon="@Icons.Material.Filled.Add"
                                        OnClick="OpenAddClusterDialog">
                                添加集群
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudStack>

                @if (_isRefreshingAll)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudSpacer />
                        <MudProgressLinear Color="Color.Primary"
                                           Value="@((double)_refreshAllCurrent / Math.Max(_refreshAllTotal, 1) * 100)"
                                           Class="progress-signal"
                                           Style="max-width:300px;" />
                        <MudText Class="mud-text-secondary">@_refreshAllCurrent / @_refreshAllTotal</MudText>
                    </MudStack>
                }

                <MudText Typo="Typo.caption" Class="font-mono sync-hint">@_autoSyncHint</MudText>

                <ClusterFilterBar Query="@_query"
                                  AvailableVersions="@_availableVersions"
                                  OnFilterChanged="RefreshTable"
                                  OnReset="ResetTable"/>
            </MudStack>
        </MudPaper>

        <ClusterTable Query="@_query"
                      OnRefreshCluster="RefreshCluster"
                      OnEditCluster="OpenEditClusterDialog"
                      OnDeleteCluster="DeleteCluster"
                      OnNavigateClusterDetail="NavigateToDetail"
                      ProcessingIds="_processingClusterIds"
                      RefreshingAll="_isRefreshingAll"
                      MultiSelectVisible="_isBatchMode"
                      SelectedIds="_selectedClusterIds"
                      OnSelectedIdsChanged="OnSelectionChanged"
                      @ref="_tableComponent" />

        <AuthorizeView Roles="Admin">
            <Authorized>
                @if (_isBatchMode && _selectedClusterIds.Count > 0)
                {
                    <MudPaper Class="pa-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText>@_selectedClusterIds.Count 个集群已选</MudText>
                            <MudSpacer />
                            <MudMenu Label="移动到分组" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DriveFileMove">
                                <MudMenuItem OnClick="@(() => MoveClustersAsync(0))">未分组</MudMenuItem>
                                @foreach (var group in _groups)
                                {
                                    <MudMenuItem OnClick="@(() => MoveClustersAsync(group.Id))">@group.Name</MudMenuItem>
                                }
                            </MudMenu>
                            <MudButton Variant="Variant.Text" OnClick="ClearSelection" StartIcon="@Icons.Material.Filled.Clear">清空选择</MudButton>
                        </MudStack>
                    </MudPaper>
                }
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudStack>

@code {
    private List<ClusterGroupViewModel> _groups = [];

    private List<string> _availableVersions = [];

    private string _autoSyncHint = "";

    private ClusterQueryRequest _query = new();

    private HashSet<int> _processingClusterIds = new();

    private bool _isRefreshingAll = false;

    private int _refreshAllCurrent = 0;

    private int _refreshAllTotal;

    private int? _selectedGroupId;

    private int _ungroupedCount;

    private bool _isBatchMode = false;

    private HashSet<int> _selectedClusterIds = new();

    private ClusterTable? _tableComponent;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        try
        {
            var hintTask = SyncSettingSvc.GetClusterSyncSettingsAsync();
            await LoadSidebarAndVersionsAsync();
            _autoSyncHint = BuildSyncHint(await hintTask);
            ApplyGroupFromUrl();
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载数据");
        }
    }

    private static string BuildSyncHint(ClusterSyncSettingsViewModel settings)
    {
        return settings.Enabled
            ? $"// 每 {settings.IntervalMinutes} 分钟自动同步"
            : "// 自动同步已停用";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task LoadSidebarAndVersionsAsync()
    {
        var groupsTask = GroupService.GetGroupsAsync();
        var versionsTask = ClusterService.GetAvailableVersionsAsync();
        var ungroupedCountTask = GroupService.GetUngroupedClusterCountAsync();
        await Task.WhenAll(groupsTask, versionsTask, ungroupedCountTask);
        _groups = groupsTask.Result;
        _availableVersions = versionsTask.Result;
        _ungroupedCount = ungroupedCountTask.Result;
    }

    private void ApplyGroupFromUrl()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var queryPart = uri.Contains('?') ? uri.Substring(uri.IndexOf('?') + 1) : "";
        var parameters = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryPart);
        if (parameters.TryGetValue("group", out var value) && int.TryParse(value, out var gid))
        {
            if (gid == 0 || _groups.Any(g => g.Id == gid))
            {
                _selectedGroupId = gid;
                _query.GroupId = gid;
            }
            else
            {
                Snackbar.Add("分组不存在", Severity.Warning);
            }
        }
        else
        {
            _selectedGroupId = null;
            _query.GroupId = null;
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ApplyGroupFromUrl();
        await Task.WhenAll(LoadSidebarAndVersionsAsync(), _tableComponent?.ReloadDataAsync() ?? Task.CompletedTask);
        await InvokeAsync(StateHasChanged);
    }

    private Task RefreshTable() => _tableComponent?.ReloadDataAsync() ?? Task.CompletedTask;

    private Task ResetTable() => _tableComponent?.ResetSortAsync() ?? Task.CompletedTask;

    private void SelectGroup(int? id)
    {
        var url = "/clusters" + (id.HasValue ? $"?group={id.Value}" : "");
        RedirectManager.RedirectTo(url);
    }

    private void ToggleBatchMode()
    {
        _isBatchMode = !_isBatchMode;
        if (!_isBatchMode)
        {
            ClearSelection();
        }
    }

    private Task OnSelectionChanged(HashSet<int> newSelection)
    {
        _selectedClusterIds = newSelection;
        return Task.CompletedTask;
    }

    private void ClearSelection()
    {
        _selectedClusterIds.Clear();
        _tableComponent?.ClearSelection();
    }

    private async Task MoveClustersAsync(int targetGroupId)
    {
        if (_selectedClusterIds.Count == 0) return;

        if (targetGroupId != 0 && !_groups.Any(g => g.Id == targetGroupId))
        {
            Snackbar.Add("目标分组不存在", Severity.Error);
            return;
        }

        // targetGroupId == 0 → move to "未分组"; translate sentinel to null before service call.
        int? effectiveGroupId = targetGroupId == 0 ? null : targetGroupId;

        try
        {
            var affected = await GroupService.MoveClustersToGroupAsync(new MoveClustersRequest(_selectedClusterIds.ToList(), effectiveGroupId));
            Snackbar.Add($"已移动 {affected} 个集群到分组", Severity.Success);
            ClearSelection();
            await LoadSidebarAndVersionsAsync();
            StateHasChanged();   // force sidebar refresh
            await _tableComponent?.ReloadDataAsync();
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "移动集群");
        }
    }

    private async Task OpenAddClusterDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditClusterDialog>("添加集群", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await RefreshVersionsIfNeeded();
            await LoadSidebarAndVersionsAsync();
            await _tableComponent?.ReloadDataAsync();
        }
    }

    private async Task OpenCreateGroupDialog()
    {
        var options = new DialogOptions { FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditGroupDialog>("新建分组", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadSidebarAndVersionsAsync();
        }
    }

    private async Task OpenRenameGroupDialog(ClusterGroupViewModel group)
    {
        var parameters = new DialogParameters
        {
            { "GroupId", group.Id },
            { "InitialName", group.Name }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditGroupDialog>("重命名分组", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadSidebarAndVersionsAsync();
            await RefreshTable();
        }
    }

    private async Task OpenEditClusterDialog(int id)
    {
        var parameters = new DialogParameters { { "ClusterId", id } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditClusterDialog>("编辑集群", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await RefreshVersionsIfNeeded();
            await _tableComponent?.ReloadDataAsync();
        }
    }

    private async Task DeleteGroup(ClusterGroupViewModel group)
    {
        var parameters = new DialogParameters
        {
            { "Message", $"确认删除分组「{group.Name}」？分组内集群将变为未分组。" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await GroupService.DeleteGroupAsync(group.Id);
                Snackbar.Add("分组已删除", Severity.Success);

                // If the deleted group was selected, reset the URL; the LocationChanged handler will reload.
                if (_selectedGroupId == group.Id)
                {
                    SelectGroup(null);
                }
                await LoadSidebarAndVersionsAsync();
                await _tableComponent?.ReloadDataAsync();
            }
            catch (Exception ex)
            {
                await ExHandler.HandleAsync(ex, "删除分组");
            }
        }
    }

    private async Task RefreshCluster(int id)
    {
        _processingClusterIds.Add(id);
        StateHasChanged();
        try
        {
            await ClusterService.RefreshClusterStatusAsync(id);
            await _tableComponent?.ReloadDataAsync();
            Snackbar.Add("集群状态已刷新", Severity.Success);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "刷新状态");
        }
        finally
        {
            _processingClusterIds.Remove(id);
            StateHasChanged();
        }
    }

    private async Task RefreshAllClustersAsync()
    {
        _isRefreshingAll = true;
        _refreshAllCurrent = 0;
        _refreshAllTotal = 0;
        StateHasChanged();
        try
        {
            var progress = new Progress<(int current, int total)>(p =>
            {
                _refreshAllCurrent = p.current;
                _refreshAllTotal = p.total;
                StateHasChanged();
            });
            var succeeded = await ClusterService.RefreshAllClustersStatusAsync(progress);
            await RefreshVersionsIfNeeded();
            await _tableComponent?.ReloadDataAsync();
            Snackbar.Add($"已刷新 {succeeded} 个集群状态", Severity.Success);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "刷新所有集群");
        }
        finally
        {
            _isRefreshingAll = false;
            StateHasChanged();
        }
    }

    private async Task DeleteCluster(ClusterViewModel cluster)
    {
        var parameters = new DialogParameters
        {
            { "Message", $"确认删除集群「{cluster.Name}」？此操作不可撤销。" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            _processingClusterIds.Add(cluster.Id);
            StateHasChanged();
            try
            {
                await ClusterService.DeleteClusterAsync(cluster.Id);
                Snackbar.Add("集群已删除", Severity.Success);
                await RefreshVersionsIfNeeded();
                await LoadSidebarAndVersionsAsync();
                await _tableComponent?.ReloadDataAsync();

                // Remove from cross-page selection if previously selected.
                _selectedClusterIds.Remove(cluster.Id);
            }
            catch (Exception ex)
            {
                await ExHandler.HandleAsync(ex, "删除集群");
            }
            finally
            {
                _processingClusterIds.Remove(cluster.Id);
                StateHasChanged();
            }
        }
    }

    private void NavigateToDetail(int id)
    {
        RedirectManager.RedirectTo($"/clusters/{id}");
    }

    private async Task RefreshVersionsIfNeeded()
    {
        try
        {
            _availableVersions = await ClusterService.GetAvailableVersionsAsync();
        }
        catch
        {
            // 版本下拉刷新失败不影响主流程
        }
    }
}