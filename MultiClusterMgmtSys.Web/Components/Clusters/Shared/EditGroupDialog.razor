@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services

@inject GroupService GroupService
@inject ISnackbar Snackbar
@inject ExceptionPresenter ExHandler

<MudDialog ContentClass="group-dialog">
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="@_groupName"
                          Label="分组名称"
                          Required="true"
                          RequiredError="请输入分组名称"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()"
                   Variant="Variant.Text"
                   Disabled="_saving">
            取消
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_saving"
                   StartIcon="@(_saving ? null : (IsRename ? Icons.Material.Filled.Save : Icons.Material.Filled.Add))">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            @(IsRename ? "保存" : "添加")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public int? GroupId { get; set; }

    [Parameter]
    public string? InitialName { get; set; }

    private MudForm _form = default!;

    private string _groupName = "";

    private bool _saving;

    private bool IsRename => GroupId.HasValue;

    protected override void OnInitialized()
    {
        _groupName = InitialName ?? "";
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            if (GroupId is null)
            {
                await GroupService.AddGroupAsync(_groupName);
                Snackbar.Add("分组已创建", Severity.Success);
            }
            else
            {
                await GroupService.RenameGroupAsync(new GroupRenameRequest(GroupId.Value, _groupName));
                Snackbar.Add("分组已重命名", Severity.Success);
            }
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "保存分组");
        }
        finally
        {
            _saving = false;
        }
    }
}