@attribute [Authorize(Roles="Admin")]
@page "/configmaps/{ClusterId:int}/{Namespace}/{Name}/yaml"

@using MultiClusterMgmtSys.Domain.Exceptions
@using MultiClusterMgmtSys.Application.Abstractions
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Abstractions
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.Abstractions
@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Application.Abstractions
@using MultiClusterMgmtSys.Web.Components.Configmaps.Shared
@using MultiClusterMgmtSys.Application.Abstractions

@inject ConfigMapService ConfigMapService
@inject IYamlValidator YamlValidator
@inject ClusterSelectionState ClusterSelection
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>编辑 YAML: @Name</PageTitle>

<MudStack Class="flex-auto d-flex" Style="align-self: stretch; min-height: 0;">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_loadError)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary" Typo="Typo.h6">ConfigMap 不存在或已被删除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}"))">
                        返回列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}"))">
                    返回列表
                </MudButton>
                <MudText Typo="Typo.h4" Class="flex-auto ml-2">编辑 YAML: @Name</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="Save"
                           Disabled="_saving">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    保存
                </MudButton>
            </MudStack>
        </MudPaper>

        <ConfigMapYamlEditCard @bind-Yaml="_yamlContent" />
    }
</MudStack>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Namespace { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";


    private string _yamlContent = "";

    private bool _loading = true;

    private bool _loadError;

    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        ClusterSelection.Set(ClusterId);
        try
        {
            _loadError = false;
            var detail = await ConfigMapService.GetConfigMapAsync(new ConfigMapKeyRequest(ClusterId, Name, Namespace));
            if (detail is null)
            {
                Snackbar.Add("ConfigMap 不存在或已被删除", Severity.Warning);
                _loadError = true;
                return;
            }
            _yamlContent = detail.Yaml;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载 ConfigMap 详情");
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        try
        {
            YamlValidator.ValidateConfigMap(_yamlContent);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(new ValidationException($"YAML 格式错误:{ex.Message}"), "保存");
            return;
        }

        _saving = true;
        try
        {
            await ConfigMapService.UpdateConfigMapFromYamlAsync(new ConfigMapUpdateRequest(ClusterId, Name, Namespace, _yamlContent));
            Snackbar.Add("修改成功", Severity.Success);
            NavigationManager.NavigateTo($"/configmaps/{ClusterId}");
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "保存配置");
        }
        finally
        {
            _saving = false;
        }
    }
}
