@implements IAsyncDisposable
@using Microsoft.JSInterop
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels

@inject TopologyService TopologyService
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler
@inject ILogger<TopologyGraphCard> Logger

<MudCard Class="pa-4 topology-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">资源拓扑</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (_topo is { Nodes.Count: > 0 })
            {
                <TooltipIconButton Icon="@Icons.Material.Filled.OpenInFull" Text="放大查看" OnClick="OpenFullscreenAsync" />
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
            <MudText Align="Align.Center" Class="mud-text-secondary font-mono">// 正在加载拓扑...</MudText>
        }
        else if (_error is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="my-2">
                <MudText Class="mud-text-secondary">@_error</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync">重试</MudButton>
            </MudStack>
        }
        else if (_chartFailed)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="my-2">
                <MudText Class="mud-text-secondary">拓扑图渲染失败，请重试</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ReloadAsync">重试</MudButton>
            </MudStack>
        }
        else if (_topo is not null && _topo.Nodes.Count == 0)
        {
            <div class="empty-state">[ 暂无拓扑数据 ]</div>
        }
        else if (_topo is not null)
        {
            <div @ref="_chartEl" class="topology-chart"></div>
            <div class="topology-legend font-mono">
                <span class="item"><span class="sw sw-center"></span>中心对象</span>
                <span class="item"><span class="sw sw-node"></span>关系对象</span>
                <span class="item"><span class="sw sw-missing"></span>缺失引用</span>
                <span class="item"><span class="sw sw-edge"></span>关系连线</span>
            </div>
            <MudText Align="Align.Center" Typo="Typo.caption" Class="mud-text-secondary topology-hint font-mono">
                点击节点跳转详情 · 滚轮缩放 · 拖拽平移
            </MudText>
        }
        else
        {
            <div class="empty-state">[ 尚未加载 ]</div>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Namespace { get; set; } = "";

    [Parameter]
    public string Kind { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";

    /// <summary>宿主详情页的拓扑 tab 是否处于激活态;首次变为 true 时触发懒加载。</summary>
    [Parameter]
    public bool Active { get; set; }

    private TopologyViewModel? _topo;

    private bool _loaded;

    private bool _loading;

    private string? _error;

    private bool _chartFailed;

    private bool _chartMounted;

    private bool _chartBusy;

    private bool _needsUpdate;

    private ElementReference _chartEl;

    private IJSObjectReference? _module;

    private DotNetObjectReference<TopologyGraphCard>? _dotnetRef;

    /// <summary>加载拓扑数据(幂等：已加载或正在加载时跳过);宿主详情页也可显式调用(重试)。</summary>
    public async Task LoadAsync()
    {
        if (_loaded || _loading)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _topo = await TopologyService.GetTopologyAsync(new TopologyQueryRequest(ClusterId, Namespace, Kind, Name));
            _dotnetRef?.Dispose();
            _dotnetRef = DotNetObjectReference.Create(this);
            _loaded = true;
        }
        catch (Exception ex)
        {
            _topo = null;
            _chartMounted = false;
            _error = "加载拓扑失败，请重试";
            await ExHandler.HandleAsync(ex, "加载拓扑");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>清空已加载数据并重新拉取(失败重试入口)。</summary>
    public async Task ReloadAsync()
    {
        _loaded = false;
        _topo = null;
        _chartMounted = false;
        _chartFailed = false;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Active)
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_topo is null || _chartBusy)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference?>("import", "/js/topology-graph.js");
            if (_module is null)
            {
                return;
            }

            _chartBusy = true;
            try
            {
                if (!_chartMounted)
                {
                    await _module.InvokeVoidAsync("mount", _chartEl, BuildPayload(), BuildOptions());
                    _chartMounted = true;
                    _needsUpdate = false;
                }
                else if (_needsUpdate)
                {
                    await _module.InvokeVoidAsync("update", _chartEl, BuildPayload(), BuildOptions());
                    _needsUpdate = false;
                }
            }
            finally
            {
                _chartBusy = false;
            }

            /* 并发渲染批次在忙时被跳过时,补一次渲染把待更新落地 */
            if (_needsUpdate)
            {
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            _chartFailed = true;
            StateHasChanged();
            Logger.LogError(ex, "拓扑图渲染失败 clusterId={ClusterId} kind={Kind} name={Name}", ClusterId, Kind, Name);
        }
    }

    /// <summary>JS 侧节点点击回调：按 Kind 映射详情路由;Ingress/PV 等终端节点不导航。</summary>
    /// <param name="nodeId">节点 Id,格式 "Kind/name"。</param>
    [JSInvokable]
    public void OnNodeClicked(string nodeId)
    {
        var separator = nodeId.IndexOf('/');
        if (separator <= 0)
        {
            return;
        }

        var kind = nodeId[..separator];
        var name = nodeId[(separator + 1)..];
        var route = kind switch
        {
            "Pod" => $"/pods/{ClusterId}/{Namespace}/{name}",
            "Service" => $"/services/{ClusterId}/{Namespace}/{name}",
            "ConfigMap" => $"/configmaps/{ClusterId}/{Namespace}/{name}",
            "Secret" => $"/secrets/{ClusterId}/{Namespace}/{name}",
            "PersistentVolumeClaim" => $"/storage/claims/{ClusterId}/{Namespace}/{name}",
            "Node" => $"/nodes/{ClusterId}/{name}",
            "Deployment" => $"/workloads/deployments/{ClusterId}/{Namespace}/{name}",
            "StatefulSet" => $"/workloads/statefulsets/{ClusterId}/{Namespace}/{name}",
            "DaemonSet" => $"/workloads/daemonsets/{ClusterId}/{Namespace}/{name}",
            "ReplicaSet" => $"/workloads/replicasets/{ClusterId}/{Namespace}/{name}",
            _ => null,
        };
        if (route is not null)
        {
            NavigationManager.NavigateTo(route);
        }
    }

    /// <summary>打开「放大查看」对话框:近全屏画布,数据复用已加载的拓扑;节点点击经同一路由映射导航。</summary>
    private async Task OpenFullscreenAsync()
    {
        if (_topo is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(TopologyFullscreenDialog.Topo), _topo },
            { nameof(TopologyFullscreenDialog.Caption), $"{Kind} · {Name}" },
            { nameof(TopologyFullscreenDialog.OnNavigate), EventCallback.Factory.Create<string>(this, OnNodeClicked) }
        };
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge, CloseButton = true };
        await DialogService.ShowAsync<TopologyFullscreenDialog>("", parameters, options);
    }

    private object BuildPayload() => TopologyPayload.Build(_topo!, _dotnetRef!);

    /// <summary>卡片场景渲染选项:容器高度按图自适应(放大查看对话框另行传 false)。</summary>
    private static object BuildOptions() => new { autoHeight = true };

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _dotnetRef?.Dispose();
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", _chartEl);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception)
        {
        }
    }
}
