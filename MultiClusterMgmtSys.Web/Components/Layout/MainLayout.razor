@inherits LayoutComponentBase

<MudThemeProvider Theme="@ThemeManager.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-layout">
    <AppBar OnMenuClick="@ToggleDrawer" />
    <Drawer IsOpen="@drawerOpen" />

    <MudMainContent Class="d-flex" Style="height:100%;">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 d-flex" Style="flex:1; min-height:0;">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen = true;

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }
}