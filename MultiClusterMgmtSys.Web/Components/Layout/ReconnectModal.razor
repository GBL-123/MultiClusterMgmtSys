<script type="module" src="@Assets["js/reconnect.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-backdrop">
        <section class="components-reconnect-surface" aria-live="assertive" aria-atomic="true">
            <header class="components-reconnect-header">
                <span class="components-reconnect-mark" aria-hidden="true"></span>
                <h2>连接已中断</h2>
                <MudText Typo="Typo.caption" Class="components-reconnect-code font-mono">MCM // LINK DOWN</MudText>
            </header>

            <MudText Class="components-reconnect-supporting">
                当前会话仍然保留,正在尝试恢复。
            </MudText>

            <MudProgressLinear Indeterminate="true"
                               Class="components-reconnect-progress" />

            <MudText Class="components-reconnect-first-attempt-visible components-reconnect-message font-mono">
                // 正在重新连接服务器...
            </MudText>
            <MudText Class="components-reconnect-repeated-attempt-visible components-reconnect-message font-mono">
                // 重连失败,将在 <span id="components-seconds-to-next-attempt"></span> 秒后重试
            </MudText>
            <MudText Class="components-reconnect-failed-visible components-reconnect-message components-reconnect-danger">
                重连失败。请重试,或刷新页面。
            </MudText>

            <MudText Class="components-pause-visible components-reconnect-message font-mono">
                // 会话已被服务器暂停
            </MudText>
            <MudText Class="components-resume-failed-visible components-reconnect-message components-reconnect-danger">
                恢复会话失败。请重试,或刷新页面。
            </MudText>

            <div class="components-reconnect-actions">
                <button id="components-reconnect-button" class="components-reconnect-action-primary components-reconnect-failed-visible" type="button">
                    重试
                </button>
                <button id="components-resume-button" class="components-reconnect-action-primary components-pause-visible components-resume-failed-visible" type="button">
                    恢复会话
                </button>
                <button id="components-reload-button" class="components-reconnect-action-secondary components-reconnect-failed-visible components-resume-failed-visible" type="button">
                    刷新页面
                </button>
            </div>
        </section>
    </div>
</dialog>
