@attribute [Authorize]
@page "/services/{ClusterId:int}/{Namespace}/{Name}"

@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Web.Components.Svcs.Shared

@inject SvcService SvcService
@inject ClusterSelectionState ClusterSelection
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>服务详情: @Name</PageTitle>

<MudStack Class="flex-auto d-flex" Style="align-self: stretch; min-height: 0;">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_detail is null)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">Service 不存在或已被删除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/services/{ClusterId}"))">
                        返回列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <SvcDetailToolbar ClusterId="@ClusterId"
                          Name="@Name"
                          Type="@_detail.Type"
                          ClusterIP="@_detail.ClusterIP"
                          Processing="@_loading"
                          OnRefresh="LoadAsync"
                          OnEditYaml="@(() => NavigationManager.NavigateTo($"/services/{ClusterId}/{Namespace}/{Name}/yaml"))"
                          OnDelete="DeleteAsync" />
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex"
                 Class="detail-tabs"
                 Elevation="0"
                 Rounded="false"
                 TabPanelsClass="detail-tabs-panels">
            <MudTabPanel Text="YAML">
                <SvcYamlViewCard Yaml="@_detail.Yaml" />
            </MudTabPanel>
            <MudTabPanel Text="端口">
                <SvcPortTable Ports="@_detail.Ports" />
            </MudTabPanel>
            <MudTabPanel Text="后端端点 (Endpoints)">
                @if (_detail.EndpointsLoadFailed)
                {
                    <div class="empty-state">[ 加载 Endpoints 失败 ]</div>
                }
                else if (_detail.Endpoints.Count == 0)
                {
                    <div class="empty-state">[ 暂无后端 ]</div>
                }
                else
                {
                    <SvcEndpointTable Endpoints="@_detail.Endpoints" />
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Namespace { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";


    private SvcDetailViewModel? _detail;

    private bool _loading = true;

    private int _activeTabIndex;

    protected override async Task OnInitializedAsync()
    {
        ClusterSelection.Set(ClusterId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _detail = await SvcService.GetSvcAsync(new SvcKeyRequest(ClusterId, Name, Namespace));
            if (_detail is null)
            {
                Snackbar.Add("Service 不存在或已被删除", Severity.Warning);
                return;
            }
            await LoadEndpointsAsync();
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载详情");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadEndpointsAsync()
    {
        if (_detail is null) return;
        try
        {
            _detail.Endpoints = await SvcService.GetSvcEndpointsAsync(new SvcKeyRequest(ClusterId, Name, Namespace));
            _detail.EndpointsLoadFailed = false;
        }
        catch (Exception)
        {
            _detail.EndpointsLoadFailed = true;
            _detail.Endpoints = new();
        }
    }

    private async Task DeleteAsync()
    {
        var parameters = new DialogParameters
        {
            { "Message", $"确认删除 Service「{Name}」？此操作不可撤销。" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await SvcService.DeleteSvcAsync(new SvcKeyRequest(ClusterId, Name, Namespace));
                Snackbar.Add("删除成功", Severity.Success);
                NavigationManager.NavigateTo($"/services/{ClusterId}");
            }
            catch (Exception ex)
            {
                await ExHandler.HandleAsync(ex, "删除服务");
            }
        }
    }
}
