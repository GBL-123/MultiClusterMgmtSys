@attribute [Authorize]
@page "/services"
@page "/services/{ClusterId:int}"

@using MultiClusterMgmtSys.Domain.Enums
@using MultiClusterMgmtSys.Application.Enums
@using MultiClusterMgmtSys.Application.Models
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Web.Components.Svcs.Shared

@inject ClusterService ClusterService
@inject SvcService SvcService
@inject ClusterSelectionState ClusterSelection
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>服务管理</PageTitle>

<MudStack Row="true" Spacing="3" Class="d-flex flex-auto">
    <ClusterSelectSidebar Clusters="@_clusters"
                          SelectedClusterId="@EffectiveClusterId"
                          OnClusterSelected="SelectCluster" />

    <MudStack Class="flex-auto">
        @if (!EffectiveClusterId.HasValue)
        {
            <div class="d-flex flex-column align-center justify-center" style="min-height:60vh;">
                <MudIcon Icon="@Icons.Material.Filled.SettingsEthernet" Size="Size.Large" Class="mud-text-secondary mb-4" />
                <MudText Typo="Typo.h6" Class="mud-text-secondary">请从左侧选择一个集群</MudText>
            </div>
        }
        else if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else if (_cluster is null)
        {
            <MudCard Class="pa-8" Elevation="2">
                <MudCardContent>
                    <MudText Align="Align.Center" Class="mud-text-secondary">未找到该集群</MudText>
                    <div class="d-flex justify-center mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => NavigationManager.NavigateTo("/clusters"))">
                            返回集群列表
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">服务管理</MudText>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="GetClusterStatusColor(_cluster.Status)"
                                 Variant="Variant.Filled"
                                 Class="ml-2">
                            @_cluster.Name · @_cluster.StatusText
                        </MudChip>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="@(() => LoadAsync(EffectiveClusterId!.Value))"
                                   Disabled="@_loading">
                            刷新
                        </MudButton>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="OpenCreateDialog"
                                           Disabled="@(!_cluster.IsReachable)">
                                    新建 Service
                                </MudButton>
                            </Authorized>
                        </AuthorizeView>
                    </MudStack>

                    @if (_cluster.IsReachable)
                    {
                        <SvcListFilterBar @bind-SelectedNamespace="_selectedNamespace"
                                          @bind-SelectedType="_selectedType"
                                          @bind-SearchName="_searchName"
                                          @bind-PortQuery="_portQuery"
                                          Namespaces="@_namespaces"
                                          OnQuery="OnQueryClick"
                                          OnReset="OnResetClick" />
                    }
                </MudStack>
            </MudPaper>

            @if (!_cluster.IsReachable)
            {
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达，无法获取 Service</MudText>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <SvcListTable Items="@filteredSvcs"
                              Loading="@_loading"
                              OnNavigateDetail="NavigateToDetail"
                              OnNavigateEditYaml="NavigateToYamlEdit"
                              OnDelete="DeleteSvc" />
            }
        }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public int? ClusterId { get; set; }


    private List<ClusterViewModel> _clusters = new();

    private ClusterDetailViewModel? _cluster;

    private List<SvcListViewModel> _svcs = new();

    private List<string> _namespaces = new();

    private bool _loading;

    private string _searchName = "";

    private string _appliedSearchName = "";

    private string _portQuery = "";

    private string _appliedPortQuery = "";

    private string? _selectedType;

    private string? _appliedType;

    private string? _selectedNamespace;

    private int? _previousClusterId;

    private bool _hasInitialized;

    private int? EffectiveClusterId => ClusterId ?? ClusterSelection.SelectedClusterId;

    private List<SvcListViewModel> filteredSvcs
        => _svcs.Apply(_appliedSearchName, _appliedPortQuery, _appliedType).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadClustersAsync();
    }

    protected override void OnParametersSet()
    {
        if (ClusterId.HasValue)
        {
            ClusterSelection.Set(ClusterId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId == _previousClusterId && _hasInitialized)
        {
            return;
        }
        _hasInitialized = true;
        _previousClusterId = ClusterId;

        if (EffectiveClusterId.HasValue)
        {
            await LoadAsync(EffectiveClusterId.Value);
        }
        else
        {
            _cluster = null;
            _svcs = new();
            _namespaces = new();
            _loading = false;
        }
    }

    private async Task LoadClustersAsync()
    {
        try
        {
            var request = new ClusterQueryRequest { Page = 1, PageSize = 1000, SortBy = ClusterSortField.Name, SortDescending = false };
            var result = await ClusterService.GetPagedAsync(request);
            _clusters = result.Items;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群列表");
        }
    }

    private async Task LoadAsync(int id)
    {
        _loading = true;
        try
        {
            _cluster = await ClusterService.GetClusterDetailAsync(id);
            if (_cluster is not null)
            {
                ClusterSelection.Set(id);
            }
            if (_cluster is not null && _cluster.IsReachable)
            {
                try
                {
                    _namespaces = await SvcService.GetNamespacesAsync(id);
                }
                catch (Exception ex)
                {
                    await ExHandler.HandleAsync(ex, "加载命名空间列表");
                }

                try
                {
                    _svcs = await SvcService.ListSvcsAsync(new SvcQueryRequest(id, _selectedNamespace));
                }
                catch (Exception ex)
                {
                    await ExHandler.HandleAsync(ex, "加载服务列表");
                }
            }
            else
            {
                _svcs = new();
                _namespaces = new();
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群详情");
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectCluster(int id)
    {
        NavigationManager.NavigateTo($"/services/{id}");
    }

    private async Task OnQueryClick()
    {
        if (!EffectiveClusterId.HasValue) return;
        _appliedSearchName = _searchName;
        _appliedPortQuery = _portQuery;
        _appliedType = _selectedType;
        _loading = true;
        try
        {
            _svcs = await SvcService.ListSvcsAsync(new SvcQueryRequest(EffectiveClusterId.Value, _selectedNamespace));
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载服务列表");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnResetClick()
    {
        _selectedNamespace = null;
        _searchName = "";
        _appliedSearchName = "";
        _portQuery = "";
        _appliedPortQuery = "";
        _selectedType = null;
        _appliedType = null;
        if (EffectiveClusterId.HasValue)
        {
            await LoadAsync(EffectiveClusterId.Value);
        }
    }

    private void NavigateToDetail((string Namespace, string Name) args)
    {
        NavigationManager.NavigateTo($"/services/{EffectiveClusterId!.Value}/{args.Namespace}/{args.Name}");
    }

    private void NavigateToYamlEdit((string Namespace, string Name) args)
    {
        NavigationManager.NavigateTo($"/services/{EffectiveClusterId!.Value}/{args.Namespace}/{args.Name}/yaml");
    }

    private async Task DeleteSvc((string Namespace, string Name) args)
    {
        var parameters = new DialogParameters
        {
            { "Message", $"确认删除 Service「{args.Name}」？此操作不可撤销。" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await SvcService.DeleteSvcAsync(new SvcKeyRequest(EffectiveClusterId!.Value, args.Name, args.Namespace));
                Snackbar.Add("删除成功", Severity.Success);
                await LoadAsync(EffectiveClusterId!.Value);
            }
            catch (Exception ex)
            {
                await ExHandler.HandleAsync(ex, "删除服务");
            }
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { { "ClusterId", EffectiveClusterId!.Value } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateSvcDialog>("新建 Service", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync(EffectiveClusterId!.Value);
    }

    private static Color GetClusterStatusColor(ClusterStatus status) => status switch
    {
        ClusterStatus.Online => Color.Success,
        ClusterStatus.Offline => Color.Error,
        _ => Color.Default
    };
}
