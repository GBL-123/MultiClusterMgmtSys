@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels

<MudTable T="NamespaceListViewModel"
          Items="@Items"
          Hover="true"
          FixedHeader="true"
          Loading="Loading"
          Class="namespaces-table">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="NamespaceListViewModel" SortBy="@(x => x.Name)" SortLabel="Name">名称</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="NamespaceListViewModel" SortBy="@(x => x.StatusText)" SortLabel="StatusText">状态</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="NamespaceListViewModel" SortBy="@(x => x.LabelCount)" SortLabel="LabelCount">标签数</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="NamespaceListViewModel" SortBy="@(x => x.CreatedAt)" SortLabel="CreatedAt">创建时间</MudTableSortLabel></MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            <MudText Class="font-mono link-primary"
                     @onclick="() => OnNavigateDetail.InvokeAsync(context.Name)">
                @context.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="状态">
            <StatusBadge Text="@context.StatusText" CssClass="@context.StatusCssClass" Raw="@context.Phase" />
        </MudTd>
        <MudTd DataLabel="标签数"><span class="font-mono">@context.LabelCount</span></MudTd>
        <MudTd DataLabel="创建时间"><span class="font-mono">@(context.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></MudTd>
        <MudTd DataLabel="操作">
            <div class="d-flex" style="gap: 4px;">
                <TooltipIconButton Text="详情"
                                   Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnNavigateDetail.InvokeAsync(context.Name))" />
                <AuthorizeView Roles="Admin">
                    <Authorized Context="authContext">
                        <TooltipIconButton Text="删除"
                                           Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           Disabled="@NamespaceService.IsProtected(context.Name)"
                                           OnClick="@(() => OnDelete.InvokeAsync(context.Name))" />
                    </Authorized>
                </AuthorizeView>
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="每页条数：" InfoFormat="共 {all_items} 条" />
    </PagerContent>
    <LoadingContent>
        <MudText Class="pa-4 font-mono mud-text-secondary">// 正在加载...</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <div class="empty-state">[ 暂无命名空间 ]</div>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public IReadOnlyList<NamespaceListViewModel> Items { get; set; } = new List<NamespaceListViewModel>();

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<string> OnNavigateDetail { get; set; }

    [Parameter]
    public EventCallback<string> OnDelete { get; set; }
}
