@using MultiClusterMgmtSys.Application.Abstractions
@using MultiClusterMgmtSys.Domain.Exceptions
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services

@inject NamespaceService NamespaceService
@inject IYamlValidator YamlValidator
@inject IYamlTemplateService YamlTemplateService
@inject ISnackbar Snackbar
@inject ExceptionPresenter ExHandler

<MudDialog>
    <DialogContent>
        <MudTextField T="string"
                      @bind-Value="yamlContent"
                      Label="YAML"
                      Lines="25"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="font-family: monospace;" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Disabled="saving">取消</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="saving"
                   StartIcon="@(saving ? null : Icons.Material.Filled.Save)">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            创建
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public int ClusterId { get; set; }

    private string yamlContent = "";

    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        yamlContent = await YamlTemplateService.GetTemplateAsync("namespace", "default");
    }

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        string? namespaceName;
        try
        {
            namespaceName = YamlValidator.ValidateNamespace(yamlContent);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(new ValidationException($"YAML 格式错误:{ex.Message}"), "创建命名空间");
            return;
        }

        if (string.IsNullOrWhiteSpace(namespaceName))
        {
            await ExHandler.HandleAsync(new ValidationException("YAML 未指定 metadata.name"), "创建命名空间");
            return;
        }

        saving = true;
        try
        {
            await NamespaceService.CreateNamespaceFromYamlAsync(new NamespaceCreateRequest(ClusterId, yamlContent));
            Snackbar.Add("创建成功", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (ConflictException)
        {
            Snackbar.Add("同名命名空间已存在", Severity.Warning);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "创建命名空间");
        }
        finally
        {
            saving = false;
        }
    }
}
