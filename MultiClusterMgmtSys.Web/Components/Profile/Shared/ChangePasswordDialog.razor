@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services

@inject AccountService AccountSvc
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ExceptionPresenter ExHandler

<MudDialog Class="pwd-dialog">
    <DialogContent>
        <MudTextField @bind-Value="_currentPassword"
                      Label="当前密码"
                      Required="true"
                      RequiredError="请输入当前密码"
                      Immediate="true"
                      InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showCurrent = !_showCurrent)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTextField @bind-Value="_newPassword"
                      Label="新密码"
                      Required="true"
                      RequiredError="请输入新密码"
                      Immediate="true"
                      InputType="@(_showNew ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showNew = !_showNew)"
                      HelperText="至少 8 位且包含数字"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTextField @bind-Value="_confirmPassword"
                      Label="确认新密码"
                      Required="true"
                      RequiredError="请再次输入新密码"
                      Immediate="true"
                      InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">取消</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.LockReset"
                   OnClick="Submit"
                   Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            修改密码
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    private string _currentPassword = "";

    private string _newPassword = "";

    private string _confirmPassword = "";

    private bool _showCurrent;

    private bool _showNew;

    private bool _showConfirm;

    private bool _saving;

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("两次输入的密码不一致", Severity.Error);
            return;
        }

        _saving = true;
        var forceRelogin = false;
        try
        {
            var result = await AccountSvc.ChangePasswordAsync(new ChangePasswordRequest(_currentPassword, _newPassword));
            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok(true));
                Snackbar.Add("密码已更新，请重新登录", Severity.Success);
                forceRelogin = true;
            }
            else
            {
                var code = result.Errors.FirstOrDefault()?.Code ?? "";
                var msg = code == "PasswordMismatch" ? "当前密码错误" :
                          result.Errors.FirstOrDefault()?.Description ?? "修改失败";
                Snackbar.Add(msg, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "修改密码");
        }
        finally
        {
            _saving = false;
        }

        if (!forceRelogin)
        {
            return;
        }

        // 电路内无法 SignOut(cookie 响应已开始，写 Set-Cookie 会抛异常),
        // 整页导航到登出端点，在真实 HTTP 请求里完成登出后跳回登录页(AppBar 登出同一路径)。
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/api/logout?returnUrl={returnUrl}", forceLoad: true);
    }
}
