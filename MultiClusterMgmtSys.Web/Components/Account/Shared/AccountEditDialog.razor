@using Microsoft.AspNetCore.Identity
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels

@inject AccountService AccountSvc
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_userName"
                          Label="用户名"
                          Required="true"
                          RequiredError="请输入用户名"
                          Immediate="true"
                          Disabled="@isEdit"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudSelect T="string"
                       @bind-Value="_roleName"
                       Label="角色"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="mb-3">
                <MudSelectItem Value="@("Admin")">管理员 (Admin)</MudSelectItem>
                <MudSelectItem Value="@("Member")">成员 (Member)</MudSelectItem>
            </MudSelect>

            @if (!isEdit)
            {
                <MudTextField @bind-Value="_password"
                              Label="初始密码"
                              Required="true"
                              RequiredError="请输入初始密码"
                              Immediate="true"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                              HelperText="至少 8 位且包含数字"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-2" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()"
                   Variant="Variant.Text"
                   Disabled="_saving">
            取消
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(isEdit ? "保存" : "创建")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public AccountViewModel? EditingAccount { get; set; }

    private MudForm _form = default!;

    private bool isEdit => EditingAccount is not null;

    private string _userName = "";

    private string _roleName = "Member";

    private string _password = "";

    private bool _showPassword;

    private bool _saving;

    protected override void OnInitialized()
    {
        if (EditingAccount is not null)
        {
            _userName = EditingAccount.UserName;
            _roleName = EditingAccount.RoleName;
        }
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            var result = isEdit
                ? await AccountSvc.UpdateAccountAsync(new AccountUpdateRequest(EditingAccount!.Id, _roleName))
                : await AccountSvc.CreateAccountAsync(new AccountCreateRequest(_userName, _password, _roleName));
            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok(true));
            }
            else
            {
                ShowErrors(result);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private void ShowErrors(IdentityResult result)
    {
        var msg = string.Join("; ", result.Errors.Select(e => e.Description));
        Snackbar.Add(msg, Severity.Error);
    }
}
