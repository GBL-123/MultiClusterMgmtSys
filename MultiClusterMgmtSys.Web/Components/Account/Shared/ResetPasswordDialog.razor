@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services

@inject AccountService AccountSvc
@inject ISnackbar Snackbar

<MudDialog Class="pwd-dialog">
    <DialogContent>
        <MudText Class="mb-3">为账号 <b>@UserName</b> 设置新密码</MudText>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_newPassword"
                          Label="新密码"
                          Required="true"
                          RequiredError="请输入新密码"
                          Immediate="true"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          HelperText="至少 8 位且包含数字"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="确认新密码"
                          Required="true"
                          RequiredError="请再次输入新密码"
                          Immediate="true"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()"
                   Variant="Variant.Text"
                   Disabled="_saving">
            取消
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            重置
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public int AccountId { get; set; }

    [Parameter]
    public string UserName { get; set; } = "";

    private MudForm _form = default!;

    private string _newPassword = "";

    private string _confirmPassword = "";

    private bool _showPassword;

    private bool _saving;

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("两次输入的密码不一致", Severity.Error);
            return;
        }

        _saving = true;
        try
        {
            var result = await AccountSvc.ResetPasswordAsync(new ResetPasswordRequest(AccountId, _newPassword));
            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var msg = string.Join("; ", result.Errors.Select(e => e.Description));
                Snackbar.Add(string.IsNullOrEmpty(msg) ? "重置失败" : msg, Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
