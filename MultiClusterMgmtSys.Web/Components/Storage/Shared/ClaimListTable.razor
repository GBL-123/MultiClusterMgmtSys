@using MultiClusterMgmtSys.Application.ViewModels

<MudTable T="StorageClaimListViewModel"
          Items="@Items"
          Hover="true"
          FixedHeader="true"
          Loading="Loading"
          Class="claims-table">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="StorageClaimListViewModel" SortBy="@(x => x.Name)" SortLabel="Name">名称</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StorageClaimListViewModel" SortBy="@(x => x.Namespace)" SortLabel="Namespace">命名空间</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StorageClaimListViewModel" SortBy="@(x => x.Phase)" SortLabel="Phase">状态</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StorageClaimListViewModel" SortBy="@(x => x.Capacity)" SortLabel="Capacity">容量</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StorageClaimListViewModel" SortBy="@(x => x.StorageClass)" SortLabel="StorageClass">存储类</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StorageClaimListViewModel" SortBy="@(x => x.CreatedAt)" SortLabel="CreatedAt">创建时间</MudTableSortLabel></MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            <MudText Class="font-mono link-primary"
                     @onclick="() => OnNavigateDetail.InvokeAsync((context.Namespace, context.Name))">
                @context.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="命名空间">
            <MudChip T="string" Size="Size.Small" Class="font-mono">@context.Namespace</MudChip>
        </MudTd>
        <MudTd DataLabel="状态">
            <StatusBadge Text="@context.PhaseText" CssClass="@context.PhaseCssClass" Raw="@context.Phase" />
        </MudTd>
        <MudTd DataLabel="容量"><span class="font-mono">@(string.IsNullOrEmpty(context.Capacity) ? "—" : context.Capacity)</span></MudTd>
        <MudTd DataLabel="存储类"><span class="font-mono">@(string.IsNullOrEmpty(context.StorageClass) ? "—" : context.StorageClass)</span></MudTd>
        <MudTd DataLabel="创建时间"><span class="font-mono">@(context.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></MudTd>
        <MudTd DataLabel="操作">
            <div class="d-flex" style="gap: 4px;">
                <TooltipIconButton Text="详情"
                                   Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnNavigateDetail.InvokeAsync((context.Namespace, context.Name)))" />
                @if (context.CanOperate)
                {
                    <TooltipIconButton Text="删除"
                                       Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error"
                                       OnClick="@(() => OnDelete.InvokeAsync((context.Namespace, context.Name)))" />
                }
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="每页条数：" InfoFormat="共 {all_items} 条" />
    </PagerContent>
    <LoadingContent>
        <MudText Class="pa-4 font-mono mud-text-secondary">// 正在加载...</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <div class="empty-state">[ 暂无持久卷声明 ]</div>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public IReadOnlyList<StorageClaimListViewModel> Items { get; set; } = new List<StorageClaimListViewModel>();

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnNavigateDetail { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnDelete { get; set; }
}
