@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels

@inject HelmService HelmService
@inject ISnackbar Snackbar
@inject ExceptionPresenter ExHandler

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">回滚 @ReleaseName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="pt-2">
            @if (_submitting)
            {
                <div>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                        正在回滚：Helm 会等待 hook 与资源就绪（最长约 5 分钟），请勿关闭页面…
                    </MudText>
                </div>
            }
            else if (_loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_candidates.Count == 0)
            {
                <div class="empty-state">[ 暂无可回滚的历史版本(当前 revision @_currentRevision 不能作为回滚目标) ]</div>
            }
            else
            {
                <MudText Typo="Typo.body2">选择要回滚到的历史版本（当前为 revision @_currentRevision）：</MudText>
                <MudSelect T="int" Label="Revision" @bind-Value="_selectedRevision" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var item in _candidates)
                    {
                        <MudSelectItem T="int" Value="@item.Revision">
                            revision @item.Revision · @item.StatusText · @(item.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                        </MudSelectItem>
                    }
                </MudSelect>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialog.Cancel()" Disabled="@_submitting">取消</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_loading || _submitting || _candidates.Count == 0)"
                   OnClick="SubmitAsync">
            回滚
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Namespace { get; set; } = "";

    [Parameter]
    public string ReleaseName { get; set; } = "";

    [Parameter]
    public int? Revision { get; set; }

    private List<HelmReleaseHistoryItemViewModel> _candidates = new();

    private int _currentRevision;

    private int _selectedRevision;

    private bool _loading;

    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var history = await HelmService.GetReleaseHistoryAsync(new HelmReleaseKeyRequest(ClusterId, ReleaseName, Namespace));
            _currentRevision = history.FirstOrDefault()?.Revision ?? 0;
            _candidates = [.. history.Where(item => item.Revision != _currentRevision)];
            _selectedRevision = Revision is { } requested && requested != _currentRevision
                ? requested
                : _candidates.FirstOrDefault()?.Revision ?? 0;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载 Release 历史");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_selectedRevision <= 0)
        {
            Snackbar.Add("请选择要回滚到的版本", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            await HelmService.RollbackAsync(new HelmRollbackRequest(ClusterId, Namespace, ReleaseName, _selectedRevision));
            Snackbar.Add($"已回滚 {ReleaseName} 到 revision {_selectedRevision}", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "回滚 Release");
        }
        finally
        {
            _submitting = false;
        }
    }
}
