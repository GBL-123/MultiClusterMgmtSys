@attribute [Authorize]
@page "/nodes/{ClusterId:int}/{NodeName}"

@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Web.Components.Nodes.Shared
@using MultiClusterMgmtSys.Application.ViewModels

@inject ClusterNodeService ClusterNodeService
@inject ClusterSelectionState ClusterSelection
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler
@inject IDialogService DialogService

<PageTitle>节点详情： @NodeName</PageTitle>

<MudStack Class="flex-auto d-flex" Style="align-self: stretch; min-height: 0;">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_node is null)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">未找到该节点</MudText>
                <MudText Align="Align.Center" Class="mud-text-secondary" Typo="Typo.body2">集群不存在、集群离线或节点已移除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/nodes/{ClusterId}"))">
                        返回节点列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (!_node.IsReachable)
    {
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达，无法获取节点详情</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/nodes/{ClusterId}"))">
                        返回节点列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <NodeDetailToolbar Node="@_node"
                           Processing="@_loading"
                           MaintenanceDisabled="@MaintenanceDisabled"
                           OnBack="@(() => NavigationManager.NavigateTo($"/nodes/{ClusterId}"))"
                           OnRefresh="LoadAsync"
                           OnCordonNode="CordonNodeAsync"
                           OnUncordonNode="UncordonNodeAsync"
                           OnDrainNode="DrainNodeAsync" />

        <MudTabs @bind-ActivePanelIndex="_activeTabIndex"
                 Class="detail-tabs"
                 Elevation="0"
                 Rounded="false"
                 TabPanelsClass="detail-tabs-panels">
            <MudTabPanel Text="YAML">
                <NodeYamlViewCard Yaml="@_node.Yaml" />
            </MudTabPanel>
            <MudTabPanel Text="基本信息">
                <MudStack Spacing="3">
                    <NodeOverviewCard Node="@_node" />
                    <NodeAddressesCard Node="@_node" OnRemarksChanged="LoadAsync" />
                    <NodeTaintsCard Node="@_node" />
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="资源容量">
                <NodeResourcesCard Node="@_node" />
            </MudTabPanel>
            <MudTabPanel Text="条件">
                <NodeConditionsCard Node="@_node" />
            </MudTabPanel>
            <MudTabPanel Text="标签与注解">
                <MudStack Spacing="3">
                    <NodeLabelsCard Node="@_node" />
                    <NodeAnnotationsCard Node="@_node" />
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="系统信息">
                <NodeSystemInfoCard Node="@_node" />
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string NodeName { get; set; } = "";


    private ClusterNodeDetailViewModel? _node;

    private bool _loading;

    private bool _maintaining;

    private int _activeTabIndex;

    private int _previousClusterId;

    private string _previousNodeName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        ClusterSelection.Set(ClusterId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId != _previousClusterId || NodeName != _previousNodeName)
        {
            _previousClusterId = ClusterId;
            _previousNodeName = NodeName;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _node = await ClusterNodeService.GetNodeDetailAsync(new NodeDetailQueryRequest(ClusterId, NodeName));
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载节点详情");
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 维护入口禁用条件：集群不可达、页面刷新中或已有维护操作进行时一律禁用。
    /// </summary>
    private bool MaintenanceDisabled => !(_node?.IsReachable ?? false) || _loading || _maintaining;

    private async Task CordonNodeAsync()
    {
        var parameters = new DialogParameters
        {
            { "Message", $"封锁后节点「{NodeName}」将不再接收新的 Pod 调度，已在运行的 Pod 不受影响。确定封锁吗？" },
            { "ConfirmText", "封锁" },
            { "ConfirmIcon", Icons.Material.Filled.Block }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认封锁", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await RunMaintenanceAsync(
                () => ClusterNodeService.CordonAsync(new NodeMaintenanceRequest(ClusterId, NodeName)),
                "封锁节点");
        }
    }

    private async Task UncordonNodeAsync()
    {
        await RunMaintenanceAsync(
            () => ClusterNodeService.UncordonAsync(new NodeMaintenanceRequest(ClusterId, NodeName)),
            "解封节点");
    }

    private async Task DrainNodeAsync()
    {
        _maintaining = true;
        try
        {
            var parameters = new DialogParameters
            {
                [nameof(NodeDrainDialog.ClusterId)] = ClusterId,
                [nameof(NodeDrainDialog.NodeName)] = NodeName
            };
            var options = new DialogOptions { CloseButton = false };
            await DialogService.ShowAsync<NodeDrainDialog>(
                $"排空节点： {NodeName}", parameters, options);
            await LoadAsync();
        }
        finally
        {
            _maintaining = false;
        }
    }

    private async Task RunMaintenanceAsync(Func<Task> action, string operation)
    {
        _maintaining = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, operation);
        }
        finally
        {
            _maintaining = false;
        }
    }
}
