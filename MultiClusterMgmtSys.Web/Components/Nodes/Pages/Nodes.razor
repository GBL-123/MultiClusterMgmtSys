@attribute [Authorize]
@page "/nodes"
@page "/nodes/{ClusterId:int}"

@using MultiClusterMgmtSys.Application.Enums
@using MultiClusterMgmtSys.Application.Models
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Web.Components.Nodes.Shared

@inject ClusterService ClusterService
@inject ClusterNodeService ClusterNodeService
@inject ClusterSelectionState ClusterSelection
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>节点管理</PageTitle>

<MudStack Row="true" Spacing="3" Class="d-flex flex-auto">
    <ClusterSelectSidebar Clusters="@_clusters"
                          SelectedClusterId="@EffectiveClusterId"
                          OnClusterSelected="SelectCluster" />

    <MudStack Class="flex-auto">
        @if (!EffectiveClusterId.HasValue)
        {
            <div class="d-flex flex-column align-center justify-center" style="min-height:60vh;">
                <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Size="Size.Large" Class="mud-text-secondary mb-4" />
                <MudText Typo="Typo.h6" Class="mud-text-secondary">请从左侧选择一个集群</MudText>
            </div>
        }
        else if (_cluster is null && _loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else if (_cluster is null)
        {
            <MudCard Class="pa-8" Elevation="2">
                <MudCardContent>
                    <MudText Align="Align.Center" Class="mud-text-secondary">未找到该集群</MudText>
                    <div class="d-flex justify-center mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => NavigationManager.NavigateTo("/clusters"))">
                            返回集群列表
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack>
                    <NodeListToolbar Cluster="@_cluster"
                                     Processing="@_loading"
                                     OnRefresh="@(() => LoadAsync(EffectiveClusterId!.Value))" />

                    @if (_cluster.IsReachable)
                    {
                        <NodeListFilterBar Filter="@_filter"
                                           OnQuery="ApplyFilter"
                                           OnReset="ResetFilter" />
                    }
                </MudStack>
            </MudPaper>

            @if (!_cluster.IsReachable)
            {
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达，无法获取节点列表</MudText>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <NodeListTable Nodes="@filteredNodes"
                               FilterActive="@_appliedFilter.IsActive"
                               Loading="@_loading"
                               OnNavigateNode="@(name => NavigationManager.NavigateTo($"/nodes/{EffectiveClusterId}/{name}"))" />
            }
        }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public int? ClusterId { get; set; }


    private List<ClusterViewModel> _clusters = new();

    private ClusterDetailViewModel? _cluster;

    private List<ClusterNodeViewModel> _nodes = new();

    private bool _loading;

    private int? _previousClusterId;

    private bool _hasInitialized;

    private NodeListFilter _filter = new();

    private NodeListFilter _appliedFilter = new();

    /// <summary>
    /// 当前生效的集群上下文:URL 参数存在时用 URL 参数,
    /// 否则用会话级记忆的选择(回到 /nodes 时原位恢复)。
    /// </summary>
    private int? EffectiveClusterId => ClusterId ?? ClusterSelection.SelectedClusterId;

    private List<ClusterNodeViewModel> filteredNodes
    {
        get
        {
            var q = _nodes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_appliedFilter.Name))
                q = q.Where(n => n.Name.Contains(_appliedFilter.Name, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_appliedFilter.Role))
                q = q.Where(n => (n.Roles ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Contains(_appliedFilter.Role, StringComparer.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_appliedFilter.Status))
                q = q.Where(n => n.Status == _appliedFilter.Status);

            if (_appliedFilter.Schedulable.HasValue)
                q = q.Where(n => n.Unschedulable == _appliedFilter.Schedulable.Value);

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadClustersAsync();
    }

    protected override void OnParametersSet()
    {
        if (ClusterId.HasValue)
        {
            ClusterSelection.Set(ClusterId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId == _previousClusterId && _hasInitialized)
        {
            return;
        }
        _hasInitialized = true;
        _previousClusterId = ClusterId;

        if (EffectiveClusterId.HasValue)
        {
            _cluster = null;
            _nodes = new();
            await LoadAsync(EffectiveClusterId.Value);
        }
        else
        {
            _cluster = null;
            _nodes = new();
            _loading = false;
        }
    }

    private async Task LoadClustersAsync()
    {
        try
        {
            var request = new ClusterQueryRequest { Page = 1, PageSize = 1000, SortBy = ClusterSortField.Name, SortDescending = false };
            var result = await ClusterService.GetPagedAsync(request);
            _clusters = result.Items;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群列表");
        }
    }

    private async Task LoadAsync(int id)
    {
        _loading = true;
        try
        {
            _cluster = await ClusterService.GetClusterDetailAsync(id);
            if (_cluster is not null && _cluster.IsReachable)
            {
                try
                {
                    _nodes = await ClusterNodeService.GetClusterNodesAsync(id);
                }
                catch (Exception ex)
                {
                    _nodes = new();
                    await ExHandler.HandleAsync(ex, "加载节点列表");
                }
            }
            else
            {
                _nodes = new();
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群详情");
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectCluster(int id)
    {
        NavigationManager.NavigateTo($"/nodes/{id}");
    }

    private void ApplyFilter()
    {
        _appliedFilter.Name = _filter.Name;
        _appliedFilter.Role = _filter.Role;
        _appliedFilter.Status = _filter.Status;
        _appliedFilter.Schedulable = _filter.Schedulable;
        StateHasChanged();
    }

    private void ResetFilter()
    {
        _filter.Reset();
        _appliedFilter.Reset();
        StateHasChanged();
    }
}
