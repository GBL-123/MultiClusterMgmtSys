@using MultiClusterMgmtSys.Application.ViewModels

<MudCard Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">系统信息</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">架构 (Architecture)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.Architecture) ? "—" : Node.SystemInfo.Architecture)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">启动 ID (BootID)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.BootID) ? "—" : Node.SystemInfo.BootID)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">容器运行时版本 (ContainerRuntimeVersion)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.ContainerRuntimeVersion) ? "—" : Node.SystemInfo.ContainerRuntimeVersion)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">内核版本 (KernelVersion)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.KernelVersion) ? "—" : Node.SystemInfo.KernelVersion)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">KubeProxy 版本 (KubeProxyVersion)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.KubeProxyVersion) ? "—" : Node.SystemInfo.KubeProxyVersion)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Kubelet 版本 (KubeletVersion)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.KubeletVersion) ? "—" : Node.SystemInfo.KubeletVersion)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">机器 ID (MachineID)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.MachineID) ? "—" : Node.SystemInfo.MachineID)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">操作系统 (OperatingSystem)</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrEmpty(Node.SystemInfo.OperatingSystem) ? "—" : Node.SystemInfo.OperatingSystem)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">操作系统镜像 (OsImage)</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrEmpty(Node.SystemInfo.OsImage) ? "—" : Node.SystemInfo.OsImage)</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">系统 UUID (SystemUUID)</MudText>
                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(Node.SystemInfo.SystemUUID) ? "—" : Node.SystemInfo.SystemUUID)</MudText>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public ClusterNodeDetailViewModel Node { get; set; } = default!;
}
