@using MultiClusterMgmtSys.Application.ViewModels

<MudCard Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">注解</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (Node.Annotations.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
        }
        else
        {
            <MudTable Items="@(Node.Annotations.Select(kvp => new { Key = kvp.Key, Value = kvp.Value }).ToList())"
                      Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>键</MudTh>
                    <MudTh>值</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="键">@context.Key</MudTd>
                    <MudTd DataLabel="值">
                        @if (string.IsNullOrEmpty(context.Value))
                        {
                            <span style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;"></span>
                        }
                        else
                        {
                            <TextTooltip Text="@context.Value">
                                <span style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">
                                    @context.Value
                                </span>
                            </TextTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public ClusterNodeDetailViewModel Node { get; set; } = default!;
}
