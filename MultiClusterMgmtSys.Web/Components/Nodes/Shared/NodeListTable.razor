@using MultiClusterMgmtSys.Application.ViewModels

<MudTable T="ClusterNodeViewModel"
          Items="@Nodes"
          Hover="true"
          FixedHeader="true"
          Loading="@Loading"
          Class="nodes-table">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ClusterNodeViewModel" SortBy="@(x => x.Name)" SortLabel="Name">名称</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterNodeViewModel" SortBy="@(x => x.Status)" SortLabel="Status">状态</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterNodeViewModel" SortBy="@(x => x.Roles)" SortLabel="Roles">角色</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterNodeViewModel" SortBy="@(x => x.KubeletVersion)" SortLabel="KubeletVersion">Kubelet 版本</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterNodeViewModel" SortBy="@(x => x.OsImage)" SortLabel="OsImage">操作系统</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterNodeViewModel" SortBy="@(x => x.IpAddresses.Count > 0 ? x.IpAddresses[0].Address : "")" SortLabel="IpAddresses">IP 地址</MudTableSortLabel></MudTh>
        <AuthorizeView Roles="Admin">
            <Authorized Context="authContext">
                <MudTh>维护</MudTh>
            </Authorized>
        </AuthorizeView>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            <div class="d-flex align-center" style="gap: 8px;">
                <MudText Class="font-mono link-primary"
                         @onclick="() => OnNavigateNode.InvokeAsync(context.Name)">
                    @context.Name
                </MudText>
                @if (context.Unschedulable)
                {
                    <StatusBadge Text="已封锁" CssClass="unknown" Raw="Unschedulable" />
                }
            </div>
        </MudTd>
        <MudTd DataLabel="状态">
            <StatusBadge Text="@context.StatusText" CssClass="@context.StatusCssClass" Raw="@context.Status" />
        </MudTd>
        <MudTd DataLabel="角色">
            @if (string.IsNullOrEmpty(context.Roles))
            {
                <span>—</span>
            }
            else
            {
                <StackedText Primary="@context.RolesText" Secondary="@context.Roles" />
            }
        </MudTd>
        <MudTd DataLabel="Kubelet 版本"><span class="font-mono">@(string.IsNullOrEmpty(context.KubeletVersion) ? "—" : context.KubeletVersion)</span></MudTd>
        <MudTd DataLabel="操作系统">@(string.IsNullOrEmpty(context.OsImage) ? "—" : context.OsImage)</MudTd>
        <MudTd DataLabel="IP 地址">
            @if (context.IpAddresses.Count == 0)
            {
                <span>—</span>
            }
            else
            {
                <div style="display:flex; flex-direction:column;">
                    @foreach (var ip in context.IpAddresses)
                    {
                        <span class="font-mono" style="white-space:nowrap;">
                            @ip.Address
                            @if (!string.IsNullOrEmpty(ip.Note))
                            {
                                <span class="mud-text-secondary">@ip.Note</span>
                            }
                        </span>
                    }
                </div>
            }
        </MudTd>
        <AuthorizeView Roles="Admin">
            <Authorized Context="authContext">
                <MudTd DataLabel="维护">
                    <div class="d-flex" style="gap: 4px;">
                        @if (context.Unschedulable)
                        {
                            <TooltipIconButton Text="解封"
                                               Icon="@Icons.Material.Filled.LockOpen"
                                               Color="Color.Primary"
                                               Disabled="@MaintenanceDisabled"
                                               OnClick="@(() => OnUncordon.InvokeAsync(context.Name))" />
                        }
                        else
                        {
                            <TooltipIconButton Text="封锁"
                                               Icon="@Icons.Material.Filled.Block"
                                               Color="Color.Primary"
                                               Disabled="@MaintenanceDisabled"
                                               OnClick="@(() => OnCordon.InvokeAsync(context.Name))" />
                        }
                        <TooltipIconButton Text="排空"
                                           Icon="@Icons.Material.Filled.SwapHoriz"
                                           Color="Color.Error"
                                           Disabled="@MaintenanceDisabled"
                                           OnClick="@(() => OnDrain.InvokeAsync(context.Name))" />
                    </div>
                </MudTd>
            </Authorized>
        </AuthorizeView>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="每页条数：" InfoFormat="共 {all_items} 条" />
    </PagerContent>
    <LoadingContent>
        <MudText Class="pa-4 font-mono mud-text-secondary">// 正在加载...</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <div class="empty-state">@(FilterActive ? "[ 无匹配节点 ]" : "[ 暂无节点 ]")</div>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public IReadOnlyList<ClusterNodeViewModel> Nodes { get; set; } = new List<ClusterNodeViewModel>();

    [Parameter]
    public bool FilterActive { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<string> OnNavigateNode { get; set; }

    [Parameter]
    public bool MaintenanceDisabled { get; set; }

    [Parameter]
    public EventCallback<string> OnCordon { get; set; }

    [Parameter]
    public EventCallback<string> OnUncordon { get; set; }

    [Parameter]
    public EventCallback<string> OnDrain { get; set; }
}
