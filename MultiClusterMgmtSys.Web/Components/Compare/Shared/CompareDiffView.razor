@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Web.Components.Compare
@using MultiClusterMgmtSys.Web.Components.Common

@inject IDialogService DialogService
@inject ExceptionPresenter ExHandler

<MudPaper Class="pa-4 compare-card">
    <YamlDiffView LeftTitle="@($"源：{Pair?.SourceClusterName}")"
                  RightTitle="@($"对照：{Pair?.TargetClusterName}")"
                  LeftYaml="@(Pair?.SourceExists == true ? Pair.SourceYaml : null)"
                  RightYaml="@(Pair?.TargetExists == true ? Pair.TargetYaml : null)"
                  Rows="@Rows"
                  HeaderActions="@HeaderFragment"
                  HintRow="@HintFragment" />
</MudPaper>

@code {
    [Parameter]
    public ComparePairViewModel Pair { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<CompareDiffRow> Rows { get; set; } = [];

    [Parameter]
    public EventCallback OnCloned { get; set; }

    private bool _cloning;

    private string CloneHint()
        => Pair!.TargetExists && Pair.HasDifference && Pair.DifferenceCount > 0
            ? $"两侧内容存在 {Pair.DifferenceCount} 处差异，可克隆到 {Pair.TargetClusterName}"
            : $"目标集群 {Pair.TargetClusterName} 不存在该资源，可克隆过去";

    private RenderFragment? HeaderFragment => Pair!.CanClone
        ? @<MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      StartIcon="@Icons.Material.Filled.ContentCopy"
                      Disabled="@_cloning"
                      OnClick="OpenCloneDialogAsync">
            克隆
        </MudButton>
        : null;

    private RenderFragment? HintFragment => Pair!.CanClone
        ? @<MudText Typo="Typo.body2" Class="compare-clone-hint">@CloneHint()</MudText>
        : null;

    private async Task OpenCloneDialogAsync()
    {
        if (_cloning)
        {
            return;
        }

        _cloning = true;
        try
        {
            var parameters = new DialogParameters { { nameof(CloneConfirmDialog.Pair), Pair } };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var dialog = await DialogService.ShowAsync<CloneConfirmDialog>(
                $"克隆到 {Pair!.TargetClusterName}", parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                await OnCloned.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "克隆资源");
        }
        finally
        {
            _cloning = false;
        }
    }
}
