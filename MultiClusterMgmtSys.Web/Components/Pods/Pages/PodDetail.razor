@attribute [Authorize]
@page "/pods/{ClusterId:int}/{Namespace}/{Name}"

@using MultiClusterMgmtSys.Domain.Exceptions
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Web.Components.Pods.Shared

@inject PodService PodService
@inject ClusterSelectionState ClusterSelection
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>Pod 详情: @Name</PageTitle>

<MudStack Class="flex-auto d-flex" Style="align-self: stretch; min-height: 0;">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_notFound)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">Pod 不存在或已被删除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/pods/{ClusterId}"))">
                        返回列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (_unreachable)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达,无法获取 Pod 详情</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadAsync">
                        重试
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (_detail is not null)
    {
        <PodDetailToolbar ClusterId="@ClusterId"
                          Name="@_detail.Name"
                          Detail="@_detail"
                          Processing="@_loading"
                          OnRefresh="LoadAsync" />
        <MudTabs ActivePanelIndex="_activeTabIndex"
                 ActivePanelIndexChanged="OnTabChanged"
                 Class="detail-tabs"
                 Elevation="0"
                 Rounded="false"
                 TabPanelsClass="detail-tabs-panels">
            <MudTabPanel Text="概览">
                <MudCard Class="pa-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">基本信息</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">命名空间</MudText>
                                <MudText Typo="Typo.body1" Class="font-mono">@_detail.Namespace</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">所在节点</MudText>
                                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(_detail.NodeName) ? "—" : _detail.NodeName)</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Pod IP</MudText>
                                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(_detail.PodIp) ? "—" : _detail.PodIp)</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">服务质量</MudText>
                                <MudText Typo="Typo.body1" Class="font-mono">@(string.IsNullOrEmpty(_detail.QosClass) ? "—" : _detail.QosClassText)</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">启动时间</MudText>
                                <MudText Typo="Typo.body1" Class="font-mono">@_detail.StartedAtAbsoluteText</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
                <MudCard Class="pa-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">条件</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_detail.Conditions.Count == 0)
                        {
                            <div class="empty-state">[ 暂无条件 ]</div>
                        }
                        else
                        {
                            <MudTable T="PodConditionViewModel"
                                      Items="@_detail.Conditions"
                                      Hover="true"
                                      Dense="true"
                                      Elevation="0">
                                <HeaderContent>
                                    <MudTh>类型</MudTh>
                                    <MudTh>状态</MudTh>
                                    <MudTh>最近迁移</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="类型">
                                        <StackedText Primary="@context.TypeText" Secondary="@context.Type" />
                                    </MudTd>
                                    <MudTd DataLabel="状态">
                                        <StackedText Primary="@context.StatusText" Secondary="@context.Status" />
                                    </MudTd>
                                    <MudTd DataLabel="最近迁移">
                                        <span class="font-mono">@context.LastTransitionAtText</span>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
            <MudTabPanel Text="容器状态">
                <MudCard Class="pa-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">容器状态</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_detail.Containers.Count == 0)
                        {
                            <div class="empty-state">[ 暂无容器 ]</div>
                        }
                        else
                        {
                            <MudTable T="PodContainerViewModel"
                                      Items="@_detail.Containers"
                                      Hover="true"
                                      Dense="true"
                                      Elevation="0">
                                <HeaderContent>
                                    <MudTh>容器</MudTh>
                                    <MudTh>就绪</MudTh>
                                    <MudTh>状态</MudTh>
                                    <MudTh>重启</MudTh>
                                    <MudTh>镜像</MudTh>
                                    <MudTh>最近终止</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="容器">
                                        <span class="font-mono">@context.Name</span>
                                    </MudTd>
                                    <MudTd DataLabel="就绪">
                                        <StatusBadge Text="@((context.Ready ? "就绪" : "未就绪"))" CssClass="@context.ReadyCssClass" Raw="@((context.Ready ? "Ready" : "NotReady"))" />
                                    </MudTd>
                                    <MudTd DataLabel="状态">
                                        <StatusBadge Text="@context.StateText" CssClass="@context.StateCssClass" Raw="@context.StateRaw" />
                                    </MudTd>
                                    <MudTd DataLabel="重启"><span class="font-mono">@context.RestartCount</span></MudTd>
                                    <MudTd DataLabel="镜像"><span class="font-mono">@context.Image</span></MudTd>
                                    <MudTd DataLabel="最近终止">
                                        @if (string.IsNullOrEmpty(context.LastTerminatedReason))
                                        {
                                            <span class="font-mono mud-text-secondary">—</span>
                                        }
                                        else
                                        {
                                            <TextTooltip Text="@context.LastTerminatedAtText" Mono="true">
                                                <span class="font-mono">@context.LastTerminatedReasonText</span>
                                            </TextTooltip>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
            <MudTabPanel Text="日志">
                <MudCard Class="pa-4 log-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">日志</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="3" Class="log-body">
                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                                <MudSelect T="string?"
                                           Value="_logContainer"
                                           ValueChanged="OnLogContainerChanged"
                                           Label="容器"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Style="min-width:180px;">
                                    @foreach (var container in _detail.Containers)
                                    {
                                        <MudSelectItem Value="@((string?)container.Name)">@container.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="int"
                                           Value="_logTailLines"
                                           ValueChanged="OnLogTailChanged"
                                           Label="最近行数"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Style="min-width:120px;">
                                    @foreach (var option in _TailLineOptions)
                                    {
                                        <MudSelectItem Value="@option">@option</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSwitch T="bool"
                                           Value="_logPrevious"
                                           ValueChanged="OnLogPreviousChanged"
                                           Color="Color.Primary"
                                           Label="上次运行(重启前)" />
                                <MudSpacer />
                                @if (_logLoadedAt is not null)
                                {
                                    <span class="font-mono mud-text-secondary log-asof">数据截至 @_logLoadedAt.Value.ToString("HH:mm:ss")</span>
                                }
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           OnClick="ReloadLogAsync"
                                           Disabled="@_logLoading">
                                    刷新
                                </MudButton>
                            </MudStack>

                            @if (_logLoading)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                            }
                            else if (_logError is not null)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText Class="mud-text-secondary">@_logError</MudText>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ReloadLogAsync">重试</MudButton>
                                </MudStack>
                            }
                            else if (_log is not null && _log.LineCount == 0)
                            {
                                <div class="empty-state">[ 暂无日志 ]</div>
                            }
                            else if (_log is not null)
                            {
                                <span class="font-mono mud-text-secondary log-line-count">共 @_log.LineCount 行</span>
                                <pre class="log-viewer font-mono">@_log.Content</pre>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Namespace { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";

    private PodDetailViewModel? _detail;

    private bool _loading = true;

    private bool _notFound;

    private bool _unreachable;

    private int _activeTabIndex;

    private string? _logContainer;

    private int _logTailLines = 500;

    private bool _logPrevious;

    private bool _logLoaded;

    private bool _logLoading;

    private string? _logError;

    private PodLogViewModel? _log;

    private DateTime? _logLoadedAt;

    private static readonly int[] _TailLineOptions = [200, 500, 1000, 5000];

    private const int LogTabIndex = 2;

    protected override async Task OnInitializedAsync()
    {
        ClusterSelection.Set(ClusterId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _detail = await PodService.GetPodAsync(new PodKeyRequest(ClusterId, Namespace, Name));
            _notFound = _detail is null;
            _unreachable = false;
            if (_detail is not null && _logContainer is null)
            {
                _logContainer = _detail.Containers.FirstOrDefault()?.Name;
            }
        }
        catch (NotFoundException)
        {
            _detail = null;
            _notFound = true;
            _unreachable = false;
        }
        catch (Exception ex)
        {
            _detail = null;
            _notFound = false;
            _unreachable = true;
            await ExHandler.HandleAsync(ex, "加载 Pod 详情");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnTabChanged(int index)
    {
        _activeTabIndex = index;
        if (index == LogTabIndex && !_logLoaded && !_logLoading)
        {
            await LoadLogAsync();
        }
    }

    private Task OnLogContainerChanged(string? container)
    {
        _logContainer = container;
        return ReloadLogAsync();
    }

    private Task OnLogTailChanged(int lines)
    {
        _logTailLines = lines;
        return ReloadLogAsync();
    }

    private Task OnLogPreviousChanged(bool previous)
    {
        _logPrevious = previous;
        return ReloadLogAsync();
    }

    private Task ReloadLogAsync() => LoadLogAsync();

    private async Task LoadLogAsync()
    {
        _logLoading = true;
        _logError = null;
        try
        {
            _log = await PodService.GetPodLogAsync(
                new PodLogRequest(ClusterId, Namespace, Name, _logContainer, _logTailLines, _logPrevious));
            _logLoaded = true;
            _logLoadedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _logError = "加载日志失败,请重试";
            await ExHandler.HandleAsync(ex, "加载 Pod 日志");
        }
        finally
        {
            _logLoading = false;
        }
    }
}
