@attribute [Authorize]
@page "/pods"
@page "/pods/{ClusterId:int}"

@using Microsoft.AspNetCore.WebUtilities
@using MultiClusterMgmtSys.Domain.Enums
@using MultiClusterMgmtSys.Application.Enums
@using MultiClusterMgmtSys.Application.Models
@using MultiClusterMgmtSys.Application.Requests
@using MultiClusterMgmtSys.Application.Services
@using MultiClusterMgmtSys.Application.ViewModels
@using MultiClusterMgmtSys.Web.Components.Pods.Shared

@inject ClusterService ClusterService
@inject PodService PodService
@inject ClusterSelectionState ClusterSelection
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>Pod 管理</PageTitle>

<MudStack Row="true" Spacing="3" Class="d-flex flex-auto">
    <ClusterSelectSidebar Clusters="@_clusters"
                          SelectedClusterId="@EffectiveClusterId"
                          OnClusterSelected="SelectCluster" />

    <MudStack Class="flex-auto">
        @if (!EffectiveClusterId.HasValue)
        {
            <div class="d-flex flex-column align-center justify-center" style="min-height:60vh;">
                <MudIcon Icon="@Icons.Material.Filled.Copyright" Size="Size.Large" Class="mud-text-secondary mb-4" />
                <MudText Typo="Typo.h6" Class="mud-text-secondary">请从左侧选择一个集群</MudText>
            </div>
        }
        else if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else if (_cluster is null)
        {
            <MudCard Class="pa-8" Elevation="2">
                <MudCardContent>
                    <MudText Align="Align.Center" Class="mud-text-secondary">未找到该集群</MudText>
                    <div class="d-flex justify-center mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => NavigationManager.NavigateTo("/clusters"))">
                            返回集群列表
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">Pod 管理</MudText>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="GetClusterStatusColor(_cluster.Status)"
                                 Variant="Variant.Filled"
                                 Class="ml-2">
                            @_cluster.Name · @_cluster.StatusText
                        </MudChip>
                        @if (!string.IsNullOrEmpty(_labelSelector))
                        {
                            <span class="font-mono mud-text-secondary ml-2 pods-selector-hint">按标签选择器过滤: @_labelSelector</span>
                        }
                    </MudStack>

                    @if (_cluster.IsReachable)
                    {
                        <PodsFilterBar Namespaces="@_namespaces"
                                       @bind-SelectedNamespace="_selectedNamespace"
                                       StatusOptions="@statusOptions"
                                       @bind-SelectedStatus="_selectedStatus"
                                       @bind-Keyword="_keyword"
                                       LastLoadedAt="@_lastLoadedAt"
                                       Refreshing="@_loading"
                                       OnReset="OnResetClick"
                                       OnRefresh="RefreshAsync" />
                    }
                </MudStack>
            </MudPaper>

            @if (!_cluster.IsReachable)
            {
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达,无法获取 Pod</MudText>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <PodsListTable Items="@filteredPods"
                               Loading="@_loading"
                               OnOpenDetail="OpenDetail" />
            }
        }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public int? ClusterId { get; set; }

    private List<ClusterViewModel> _clusters = new();

    private ClusterDetailViewModel? _cluster;

    private List<PodListViewModel> _pods = new();

    private List<string> _namespaces = new();

    private bool _loading;

    private string? _selectedNamespace;

    private string? _selectedStatus;

    private string _keyword = "";

    private DateTime? _lastLoadedAt;

    private int? _previousClusterId;

    private string? _previousSelector;

    private string? _labelSelector;

    private bool _hasInitialized;

    private int? EffectiveClusterId => ClusterId ?? ClusterSelection.SelectedClusterId;

    private List<PodListViewModel> filteredPods
        => _pods.Apply(_selectedNamespace, _selectedStatus, _keyword)
            .OrderByDescending(p => p.StatusGroup == "异常")
            .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<PodStatusOption> statusOptions
        => _pods.StatusOptions(_selectedNamespace, _keyword);

    private int statusTotalCount
        => _pods.Apply(_selectedNamespace, null, _keyword).Count();

    protected override async Task OnInitializedAsync()
    {
        await LoadClustersAsync();
    }

    protected override void OnParametersSet()
    {
        if (ClusterId.HasValue)
        {
            ClusterSelection.Set(ClusterId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var selector = GetLabelSelectorFromQuery();
        if (ClusterId == _previousClusterId && selector == _previousSelector && _hasInitialized)
        {
            return;
        }
        _hasInitialized = true;
        _previousClusterId = ClusterId;
        _previousSelector = selector;
        _labelSelector = selector;

        if (EffectiveClusterId.HasValue)
        {
            await LoadAsync(EffectiveClusterId.Value);
        }
        else
        {
            _cluster = null;
            _pods = new();
            _namespaces = new();
            _loading = false;
        }
    }

    private string? GetLabelSelectorFromQuery()
    {
        var query = new Uri(NavigationManager.Uri).Query;
        var values = QueryHelpers.ParseQuery(query).TryGetValue("labelSelector", out var v) ? v.ToString() : null;
        return string.IsNullOrWhiteSpace(values) ? null : values;
    }

    private async Task LoadClustersAsync()
    {
        try
        {
            var request = new ClusterQueryRequest { Page = 1, PageSize = 1000, SortBy = ClusterSortField.Name, SortDescending = false };
            var result = await ClusterService.GetPagedAsync(request);
            _clusters = result.Items;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群列表");
        }
    }

    private async Task LoadAsync(int id)
    {
        _loading = true;
        try
        {
            _cluster = await ClusterService.GetClusterDetailAsync(id);
            if (_cluster is not null)
            {
                ClusterSelection.Set(id);
            }
            if (_cluster is not null && _cluster.IsReachable)
            {
                try
                {
                    _namespaces = await PodService.GetNamespacesAsync(id);
                }
                catch (Exception ex)
                {
                    await ExHandler.HandleAsync(ex, "加载命名空间列表");
                }

                try
                {
                    _pods = await PodService.ListPodsAsync(new PodQueryRequest(id, null, _labelSelector));
                    _lastLoadedAt = DateTime.Now;
                }
                catch (Exception ex)
                {
                    await ExHandler.HandleAsync(ex, "加载 Pod 列表");
                }
            }
            else
            {
                _pods = new();
                _namespaces = new();
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群详情");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (!EffectiveClusterId.HasValue) return;
        await LoadAsync(EffectiveClusterId.Value);
    }

    private void SelectCluster(int id)
    {
        NavigationManager.NavigateTo($"/pods/{id}");
    }

    private void OnResetClick()
    {
        if (!string.IsNullOrEmpty(_labelSelector))
        {
            NavigationManager.NavigateTo($"/pods/{EffectiveClusterId}");
            return;
        }
        _selectedNamespace = null;
        _selectedStatus = null;
        _keyword = "";
    }

    private void OpenDetail(PodListViewModel item)
    {
        NavigationManager.NavigateTo(item.DetailRoute);
    }

    private static Color GetClusterStatusColor(ClusterStatus status) => status switch
    {
        ClusterStatus.Online => Color.Success,
        ClusterStatus.Offline => Color.Error,
        _ => Color.Default
    };
}
