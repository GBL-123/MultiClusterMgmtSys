{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/app-.log"
    }
  },
  "AllowedHosts": "*",
  "ClusterSync": {
    "Enabled": true,
    "IntervalMinutes": 5
  },
  "Helm": {
    "CliPath": "helm",
    "MaxPackageBytes": 52428800
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=db/MultiClusterMgmtSys.db"
  }
}
