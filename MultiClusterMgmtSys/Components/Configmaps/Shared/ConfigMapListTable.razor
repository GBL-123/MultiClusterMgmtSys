@using MultiClusterMgmtSys.ViewModels

<MudTable T="ConfigMapListViewModel"
          Items="@Items"
          Hover="true"
          FixedHeader="true"
          Loading="Loading"
          Class="configmaps-table">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ConfigMapListViewModel" SortBy="@(x => x.Name)" SortLabel="Name">名称</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ConfigMapListViewModel" SortBy="@(x => x.Namespace)" SortLabel="Namespace">命名空间</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ConfigMapListViewModel" SortBy="@(x => x.DataKeyCount)" SortLabel="DataKeyCount">Data 键数</MudTableSortLabel></MudTh>
        <MudTh>键名预览</MudTh>
        <MudTh><MudTableSortLabel T="ConfigMapListViewModel" SortBy="@(x => x.CreatedAt)" SortLabel="CreatedAt">创建时间</MudTableSortLabel></MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="名称">
            <MudText Class="font-mono link-primary"
                     @onclick="() => OnNavigateDetail.InvokeAsync((context.Namespace, context.Name))">
                @context.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="命名空间">
            <MudChip T="string" Size="Size.Small" Class="font-mono">@context.Namespace</MudChip>
        </MudTd>
        <MudTd DataLabel="Data 键数"><span class="font-mono">@context.DataKeyCount</span></MudTd>
        <MudTd DataLabel="键名预览">
            <MudText Style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                @context.DataKeyPreview
            </MudText>
        </MudTd>
        <MudTd DataLabel="创建时间"><span class="font-mono">@(context.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></MudTd>
        <MudTd DataLabel="操作">
            <div class="d-flex" style="gap: 4px;">
                <MudTooltip Text="详情">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnNavigateDetail.InvokeAsync((context.Namespace, context.Name)))" />
                </MudTooltip>
                <AuthorizeView Roles="Admin">
                    <Authorized Context="authContext">
                        <MudTooltip Text="编辑 YAML">
                            <MudIconButton Icon="@Icons.Material.Filled.Code"
                                           Size="Size.Small"
                                           OnClick="@(() => OnNavigateEditYaml.InvokeAsync((context.Namespace, context.Name)))" />
                        </MudTooltip>
                        <MudTooltip Text="删除">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => OnDelete.InvokeAsync((context.Namespace, context.Name)))" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="每页条数：" InfoFormat="共 {all_items} 条" />
    </PagerContent>
    <LoadingContent>
        <MudText Class="pa-4 font-mono mud-text-secondary">// 正在加载...</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <div class="empty-state">[ 暂无 ConfigMap ]</div>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public IReadOnlyList<ConfigMapListViewModel> Items { get; set; } = new List<ConfigMapListViewModel>();

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnNavigateDetail { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnNavigateEditYaml { get; set; }

    [Parameter]
    public EventCallback<(string Namespace, string Name)> OnDelete { get; set; }
}
