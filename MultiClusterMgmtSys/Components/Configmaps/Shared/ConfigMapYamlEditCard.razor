@using MultiClusterMgmtSys.Features.Configmaps.ViewModels
@namespace MultiClusterMgmtSys.Features.Configmaps.Shared

<MudCard Elevation="1" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">YAML</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTextField T="string"
                      @bind-Value="Yaml"
                      Lines="30"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="font-family: monospace;" />
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Yaml { get; set; } = "";
    [Parameter] public EventCallback<string> YamlChanged { get; set; }
}