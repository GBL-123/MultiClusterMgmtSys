@attribute [Authorize]
@page "/configmaps/{ClusterId:int}/{Namespace}/{Name}"

@using MultiClusterMgmtSys.Components.Common
@using MultiClusterMgmtSys.Features.Configmaps.Services
@using MultiClusterMgmtSys.Features.Configmaps.ViewModels
@using MultiClusterMgmtSys.Features.Configmaps.Shared

<PageTitle>ConfigMap 详情: @Name</PageTitle>

<MudStack Class="flex-auto pb-4" Style="align-self: flex-start;">
    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (detail is null)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">ConfigMap 不存在或已被删除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}"))">
                        返回列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <ConfigMapDetailToolbar ClusterId="@ClusterId"
                                Name="@Name"
                                Detail="@detail"
                                Processing="@loading"
                                OnRefresh="LoadAsync"
                                OnEditYaml="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}/{Namespace}/{Name}/yaml"))" />
        <ConfigMapYamlViewCard Yaml="@detail.Yaml" />
    }
</MudStack>

@code {
    [Parameter] public int ClusterId { get; set; }
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    [Inject] private ConfigMapService ConfigMapService { get; set; } = default!;
    [Inject] private ClusterSelectionState ClusterSelection { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private ConfigMapDetailViewModel? detail;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        ClusterSelection.Set(ClusterId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            detail = await ConfigMapService.GetConfigMapAsync(ClusterId, Name, Namespace);
            if (detail is null)
            {
                Snackbar.Add("ConfigMap 不存在或已被删除", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载详情失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }
}