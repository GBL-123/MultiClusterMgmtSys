@attribute [Authorize]
@page "/configmaps/{ClusterId:int}/{Namespace}/{Name}"

<PageTitle>ConfigMap 详情: @Name</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4" Class="flex-grow-1">ConfigMap 详情: @Name</MudText>
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}"))">
        返回列表
    </MudButton>
</div>

@if (loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (detail is null)
{
    <MudCard Class="pa-8" Elevation="2">
        <MudCardContent>
            <MudText Align="Align.Center" Class="mud-text-secondary">ConfigMap 不存在或已被删除</MudText>
            <div class="d-flex justify-center mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}"))">
                    返回列表
                </MudButton>
            </div>
        </MudCardContent>
    </MudCard>
}
else
{
    <!-- Metadata card -->
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">名称</MudText>
                    <MudText Typo="Typo.body1">@detail.Name</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">命名空间</MudText>
                    <MudText Typo="Typo.body1">@detail.Namespace</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">创建时间</MudText>
                    <MudText Typo="Typo.body1">@(detail.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">UID</MudText>
                    <MudText Typo="Typo.body1" Style="word-break: break-all;">@detail.Uid</MudText>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <!-- Data tabs -->
    <MudTabs Position="Position.Left">
        @if (detail.Data.Any())
        {
            @foreach (var entry in detail.Data)
            {
                <MudTabPanel Text="@entry.Key">
                    <MudTextField T="string"
                                  Value="@entry.Value"
                                  ReadOnly="true"
                                  Lines="8"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="font-family: monospace;" />
                </MudTabPanel>
            }
        }
        else
        {
            <MudTabPanel Text="Data">
                <MudText Class="mud-text-secondary">暂无 Data</MudText>
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    [Parameter] public int ClusterId { get; set; }
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    [Inject] private ConfigMapService ConfigMapService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private ConfigMapDetailViewModel? detail;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            detail = await ConfigMapService.GetConfigMapAsync(ClusterId, Name, Namespace);
            if (detail is null)
            {
                Snackbar.Add("ConfigMap 不存在或已被删除", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载详情失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }
}
