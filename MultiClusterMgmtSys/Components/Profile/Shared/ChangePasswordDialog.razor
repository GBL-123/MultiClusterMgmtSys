@using MultiClusterMgmtSys.Services

@inject AccountService AccountSvc
@inject ISnackbar Snackbar
@inject ExceptionPresenter ExHandler

<MudDialog Class="pwd-dialog">
    <DialogContent>
        <MudTextField @bind-Value="currentPassword"
                      Label="当前密码"
                      Required="true"
                      RequiredError="请输入当前密码"
                      Immediate="true"
                      InputType="@(showCurrent ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => showCurrent = !showCurrent)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTextField @bind-Value="newPassword"
                      Label="新密码"
                      Required="true"
                      RequiredError="请输入新密码"
                      Immediate="true"
                      InputType="@(showNew ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => showNew = !showNew)"
                      HelperText="至少 8 位且包含数字"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTextField @bind-Value="confirmPassword"
                      Label="确认新密码"
                      Required="true"
                      RequiredError="请再次输入新密码"
                      Immediate="true"
                      InputType="@(showConfirm ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => showConfirm = !showConfirm)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">取消</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.LockReset"
                   OnClick="Submit"
                   Disabled="saving">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            修改密码
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string UserName { get; set; } = "";

    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool showCurrent;
    private bool showNew;
    private bool showConfirm;
    private bool saving;

    private void Cancel() => Dialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(UserName)) return;

        if (newPassword != confirmPassword)
        {
            Snackbar.Add("两次输入的密码不一致", Severity.Error);
            return;
        }

        saving = true;
        try
        {
            var result = await AccountSvc.ChangePasswordAsync(UserName, currentPassword, newPassword);
            if (result.Succeeded)
            {
                Snackbar.Add("密码已更新", Severity.Success);
                Dialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var code = result.Errors.FirstOrDefault()?.Code ?? "";
                var msg = code == "PasswordMismatch" ? "当前密码错误" :
                          result.Errors.FirstOrDefault()?.Description ?? "修改失败";
                Snackbar.Add(msg, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "修改密码");
        }
        finally
        {
            saving = false;
        }
    }
}