@attribute [Authorize]
@page "/profile"

@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.Components.Common
@using MultiClusterMgmtSys.Components.Profile.Shared
@using MultiClusterMgmtSys.ViewModels

<PageTitle>个人资料</PageTitle>

<MudStack Class="flex-auto pb-4">
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h5">个人资料</MudText>
    </MudPaper>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudCard Class="pa-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">账号信息</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.LockReset"
                               OnClick="OpenChangePasswordDialog">
                        修改密码
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                    <span class="brand-mark large">@UserInitial</span>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6">@(string.IsNullOrEmpty(currentUserName) ? "—" : currentUserName)</MudText>
                        <span class="role-badge @(currentUserRole == "Admin" ? "admin" : "member")">
                            @(string.IsNullOrEmpty(currentUserRole) ? "未知角色" : currentUserRole)
                        </span>
                    </MudStack>
                </MudStack>

                <MudDivider Class="mb-4" />

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">注册时间</MudText>
                        <MudText Typo="Typo.body1" Class="font-mono">@(createdAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">修改时间</MudText>
                        <MudText Typo="Typo.body1" Class="font-mono">@(updatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">最后登录</MudText>
                        <MudText Typo="Typo.body1" Class="font-mono">@(lastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudText>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudCard Class="pa-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">最近操作</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudLink Href="/audit-logs" Class="link-primary" Underline="Underline.None">查看全部</MudLink>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @if (recentOps.Count == 0)
                {
                    <div class="empty-state">[ 暂无操作记录 ]</div>
                }
                else
                {
                    <MudStack Spacing="0">
                        @for (var i = 0; i < recentOps.Count; i++)
                        {
                            var op = recentOps[i];
                            <div class="d-flex align-center py-2" style="gap: 16px;">
                                <span class="font-mono mud-text-secondary" style="flex: none;">@op.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                <span style="flex: none;">@op.CategoryName · @op.ActionName</span>
                                <span class="mud-text-secondary"
                                      style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;"
                                      title="@op.Target">
                                    @(string.IsNullOrEmpty(op.Target) ? "—" : op.Target)
                                </span>
                            </div>
                            @if (i < recentOps.Count - 1)
                            {
                                <MudDivider Light="true" />
                            }
                        }
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    }
</MudStack>

@code {
    [Inject] private AccountService AccountSvc { get; set; } = default!;
    [Inject] private AuditService AuditSvc { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private ExceptionPresenter ExHandler { get; set; } = default!;

    private const int RecentOpsCount = 5;

    private string currentUserName = "";
    private string currentUserRole = "";
    private DateTime? createdAt;
    private DateTime? updatedAt;
    private DateTime? lastLoginAt;
    private List<AuditLogViewModel> recentOps = new();
    private bool loading;

    private string UserInitial => string.IsNullOrEmpty(currentUserName) ? "?" : currentUserName.Substring(0, 1).ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserName = authState.User.Identity?.Name ?? "";
            currentUserRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

            var userTask = AccountSvc.GetUserByNameAsync(currentUserName);
            var recentTask = AuditSvc.GetRecentAsync(currentUserName, RecentOpsCount);
            await Task.WhenAll(userTask, recentTask);

            var user = userTask.Result;
            if (user is not null)
            {
                createdAt = user.CreatedAt;
                updatedAt = user.UpdatedAt;
                lastLoginAt = user.LastLoginAt;
            }
            recentOps = recentTask.Result;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载用户资料");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenChangePasswordDialog()
    {
        if (string.IsNullOrEmpty(currentUserName)) return;

        var parameters = new DialogParameters<ChangePasswordDialog>
        {
            { d => d.UserName, currentUserName }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<ChangePasswordDialog>("修改密码", parameters, options);
    }
}