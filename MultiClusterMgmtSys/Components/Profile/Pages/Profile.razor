@attribute [Authorize]
@page "/profile"

@using MultiClusterMgmtSys.Components.Account.Services

<PageTitle>个人资料</PageTitle>

<MudStack Class="flex-auto pb-4" Style="align-self: flex-start;">
    <MudPaper Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5">个人资料</MudText>
            <MudSpacer />
        </MudStack>
    </MudPaper>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }

    <MudCard Elevation="1" Class="mb-4" Style="max-width: 720px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">账号信息</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="width: 120px;">用户名</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrEmpty(currentUserName) ? "—" : currentUserName)</MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="width: 120px;">角色</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrEmpty(currentUserRole) ? "—" : currentUserRole)</MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="width: 120px;">注册时间</MudText>
                    <MudText Typo="Typo.body1">@(createdAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="width: 120px;">修改时间</MudText>
                    <MudText Typo="Typo.body1">@(updatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="width: 120px;">最后登录</MudText>
                    <MudText Typo="Typo.body1">@(lastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</MudText>
                </MudStack>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="1">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">修改密码</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudTextField @bind-Value="currentPassword"
                          Label="当前密码"
                          Required="true"
                          RequiredError="请输入当前密码"
                          Immediate="true"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudTextField @bind-Value="newPassword"
                          Label="新密码"
                          Required="true"
                          RequiredError="请输入新密码"
                          Immediate="true"
                          InputType="InputType.Password"
                          HelperText="至少 8 位且包含字母和数字"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudTextField @bind-Value="confirmPassword"
                          Label="确认新密码"
                          Required="true"
                          RequiredError="请再次输入新密码"
                          Immediate="true"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.LockReset"
                       OnClick="ChangePassword"
                       Disabled="savingPassword">
                @if (savingPassword)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                修改密码
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudStack>

@code {
    [Inject] private AccountService AccountSvc { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string currentUserName = "";
    private string currentUserRole = "";
    private DateTime? createdAt;
    private DateTime? updatedAt;
    private DateTime? lastLoginAt;
    private bool loading;
    private bool savingPassword;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserName = authState.User.Identity?.Name ?? "";
            currentUserRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
            var user = await AccountSvc.GetUserByNameAsync(currentUserName);
            if (user is not null)
            {
                createdAt = user.CreatedAt;
                updatedAt = user.UpdatedAt;
                lastLoginAt = user.LastLoginAt;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载用户资料失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ChangePassword()
    {
        if (string.IsNullOrEmpty(currentUserName)) return;
        if (newPassword != confirmPassword)
        {
            Snackbar.Add("两次输入的密码不一致", Severity.Error);
            return;
        }

        savingPassword = true;
        try
        {
            var result = await AccountSvc.ChangePasswordAsync(currentUserName, currentPassword, newPassword);
            if (result.Succeeded)
            {
                Snackbar.Add("密码已更新", Severity.Success);
                currentPassword = "";
                newPassword = "";
                confirmPassword = "";
            }
            else
            {
                var code = result.Errors.FirstOrDefault()?.Code ?? "";
                var msg = code == "PasswordMismatch" ? "当前密码错误" :
                          result.Errors.FirstOrDefault()?.Description ?? "修改失败";
                Snackbar.Add(msg, Severity.Error);
            }
        }
        finally
        {
            savingPassword = false;
        }
    }
}
