@using MultiClusterMgmtSys.Models

<MudStack Spacing="2">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        <MudSelect T="string?"
                   Value="SelectedNamespace"
                   ValueChanged="OnNamespaceChanged"
                   Label="命名空间"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width:170px;">
            <MudSelectItem Value="@((string?)null)">全部命名空间</MudSelectItem>
            @foreach (var ns in Namespaces)
            {
                <MudSelectItem Value="@ns">@ns</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string"
                      Value="Keyword"
                      ValueChanged="OnKeywordChanged"
                      Label="关键词"
                      Placeholder="Pod 名称 / 节点 / IP"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="min-width:220px; flex:1;" />

        <MudSpacer />

        @if (LastLoadedAt is not null)
        {
            <span class="font-mono mud-text-secondary pods-asof">数据截至 @LastLoadedAt.Value.ToString("HH:mm:ss")</span>
        }
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                   OnClick="OnReset">
            重置
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRefresh"
                   Disabled="@Refreshing">
            刷新
        </MudButton>
    </MudStack>

    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.caption" Class="mud-text-secondary pods-status-label">状态</MudText>
        <MudChipSet T="string"
                    SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="SelectedStatus"
                    SelectedValueChanged="OnStatusChanged"
                    Size="Size.Small"
                    CheckMark="true"
                    Class="pods-status-chips">
            <MudChip T="string" Value="@string.Empty">@($"全部 {TotalCount}")</MudChip>
            @foreach (var option in StatusOptions)
            {
                <MudChip T="string" Value="@option.Status" Disabled="@(option.Count == 0)">@($"{option.Status} {option.Count}")</MudChip>
            }
        </MudChipSet>
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public List<string> Namespaces { get; set; } = new();

    [Parameter]
    public string? SelectedNamespace { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedNamespaceChanged { get; set; }

    [Parameter]
    public List<PodStatusOption> StatusOptions { get; set; } = new();

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public string? SelectedStatus { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedStatusChanged { get; set; }

    [Parameter]
    public string Keyword { get; set; } = "";

    [Parameter]
    public EventCallback<string> KeywordChanged { get; set; }

    [Parameter]
    public DateTime? LastLoadedAt { get; set; }

    [Parameter]
    public bool Refreshing { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private Task OnNamespaceChanged(string? ns) => SelectedNamespaceChanged.InvokeAsync(ns);

    private Task OnStatusChanged(string? status) => SelectedStatusChanged.InvokeAsync(status ?? null);

    private Task OnKeywordChanged(string value) => KeywordChanged.InvokeAsync(value);
}
