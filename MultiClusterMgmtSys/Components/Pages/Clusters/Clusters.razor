@attribute [Authorize]
@page "/clusters"

@* <PageTitle>集群管理</PageTitle>

<MudStack>
    <MudText Typo="Typo.h4" Class="mb-4">集群管理</MudText>

    <!-- Row 1: count + action buttons -->
    <div class="d-flex align-center mb-4" style="justify-content: space-between;">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">共 @filteredClusters.Count 个集群</MudText>
        <div class="d-flex align-center gap-3" style="gap: 8px;">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Folder"
                       OnClick="OpenManageGroupsDialog">
                分组管理
            </MudButton>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.CreateNewFolder"
                               OnClick="OpenCreateGroupDialog">
                        新建分组
                    </MudButton>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddClusterDialog">
                        添加集群
                    </MudButton>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Row 2: toolbar -->
    <div class="d-flex flex-wrap align-center gap-3 mb-4">
        <MudTextField T="string"
                      @bind-Value="searchName"
                      Label="搜索集群名称"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="min-width:200px; flex:1;" />

        <MudSelect T="int?"
                   @bind-Value="filterGroupId"
                   Label="分组"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="width:160px;">
            <MudSelectItem Value="@((int?)null)">全部分组</MudSelectItem>
            @foreach (var g in groups)
            {
                <MudSelectItem Value="@((int?)g.Id)">@g.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="ClusterStatus?"
                   @bind-Value="filterStatus"
                   Label="状态"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="width:140px;">
            <MudSelectItem Value="@((ClusterStatus?)null)">全部</MudSelectItem>
            <MudSelectItem Value="@((ClusterStatus?)ClusterStatus.Online)">在线</MudSelectItem>
            <MudSelectItem Value="@((ClusterStatus?)ClusterStatus.Offline)">离线</MudSelectItem>
            <MudSelectItem Value="@((ClusterStatus?)ClusterStatus.Unknown)">未知</MudSelectItem>
        </MudSelect>

        <MudSelect T="string"
                   @bind-Value="filterVersion"
                   Label="版本"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="width:160px;">
            <MudSelectItem Value="@("__ALL__")">全部</MudSelectItem>
            @foreach (var v in availableVersions)
            {
                <MudSelectItem Value="@v">@v</MudSelectItem>
            }
            <MudSelectItem Value="@("__NULL__")">未知</MudSelectItem>
        </MudSelect>

        <MudDatePicker T="DateTime?"
                       @bind-Value="filterStartDate"
                       Label="开始时间"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="width:160px;" />

        <MudDatePicker T="DateTime?"
                       @bind-Value="filterEndDate"
                       Label="结束时间"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="width:160px;" />

        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   OnClick="ResetFilters">
            重置
        </MudButton>
    </div>

    <!-- List area -->
    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (clusters.Count == 0)
    {
        <div class="d-flex flex-column align-center justify-center" style="min-height:300px;">
            <MudText Class="mud-text-secondary" Align="Align.Center">暂无集群，点击「添加集群」开始管理</MudText>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddClusterDialog"
                               Class="mt-4">
                        添加集群
                    </MudButton>
                </Authorized>
            </AuthorizeView>
        </div>
    }
    else if (!filteredClusters.Any())
    {
        <div class="d-flex flex-column align-center justify-center" style="min-height:300px;">
            <MudText Class="mud-text-secondary" Align="Align.Center">没有符合当前筛选条件的集群</MudText>
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       OnClick="ResetFilters"
                       Class="mt-2">
                重置筛选
            </MudButton>
        </div>
    }
    else
    {
        <MudTable T="ClusterViewModel"
                  Items="@filteredClusters"
                  Dense="true"
                  Hover="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.Name)">名称</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.Status)">状态</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.Version)">版本</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.NodeCount)">节点数</MudTableSortLabel></MudTh>
                <MudTh>分组</MudTh>
                <MudTh>API Server</MudTh>
                <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.CreatedAt)">创建时间</MudTableSortLabel></MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="名称">
                    <MudText Color="Color.Primary"
                             Style="cursor:pointer; text-decoration: underline;"
                             @onclick="() => NavigateToDetail(context.Id)">
                        @context.Name
                    </MudText>
                </MudTd>
                <MudTd DataLabel="状态">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="GetStatusColor(context.Status)"
                             Variant="Variant.Filled">
                        @context.StatusText
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="版本">@(context.Version ?? "—")</MudTd>
                <MudTd DataLabel="节点数">@context.NodeCount</MudTd>
                <MudTd DataLabel="分组">@(context.GroupName ?? "未分组")</MudTd>
                <MudTd DataLabel="API Server">
                    <MudText Style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                             Title="@context.ApiServer">
                        @(context.ApiServer ?? "—")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="创建时间">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="操作">
                    <AuthorizeView Roles="Admin">
                        <Authorized Context="authContext">
                            <div @onclick:stopPropagation="true" class="d-flex gap-2" style="gap: 4px;">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                               Size="Size.Small"
                                               OnClick="@(() => RefreshCluster(context.Id))"
                                               Disabled="processing" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditClusterDialog(context.Id))" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteCluster(context.Id))"
                                               Disabled="processing" />
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    [Inject] private ClusterService ClusterService { get; set; } = default!;
    [Inject] private GroupService GroupService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private List<ClusterGroupViewModel> groups = new();
    private List<ClusterViewModel> clusters = new();
    private bool loading;
    private bool processing;

    private string searchName = "";
    private int? filterGroupId;
    private ClusterStatus? filterStatus;
    private string filterVersion = "__ALL__";
    private DateTime? filterStartDate;
    private DateTime? filterEndDate;

    private List<string> availableVersions =>
        clusters.Select(c => c.Version)
                .Where(v => !string.IsNullOrEmpty(v))
                .Distinct()
                .OrderBy(v => v)
                .Select(v => v!)
                .ToList();

    private List<ClusterViewModel> filteredClusters
    {
        get
        {
            var q = clusters.AsEnumerable();

            if (filterGroupId.HasValue)
                q = q.Where(c => c.GroupId == filterGroupId);

            if (!string.IsNullOrWhiteSpace(searchName))
                q = q.Where(c => c.Name.Contains(searchName, StringComparison.OrdinalIgnoreCase));

            if (filterStatus.HasValue)
                q = q.Where(c => c.Status == filterStatus);

            if (filterVersion == "__NULL__")
                q = q.Where(c => string.IsNullOrEmpty(c.Version));
            else if (filterVersion != "__ALL__")
                q = q.Where(c => c.Version == filterVersion);

            if (filterStartDate.HasValue)
                q = q.Where(c => c.CreatedAt >= filterStartDate.Value);

            if (filterEndDate.HasValue)
                q = q.Where(c => c.CreatedAt < filterEndDate.Value.AddDays(1));

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            groups = await GroupService.GetGroupsAsync();
            clusters = await ClusterService.GetClustersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载数据失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private void ResetFilters()
    {
        searchName = "";
        filterGroupId = null;
        filterStatus = null;
        filterVersion = "__ALL__";
        filterStartDate = null;
        filterEndDate = null;
    }

    private async Task OpenAddClusterDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddClusterDialog>("添加集群", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenCreateGroupDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateGroupDialog>("新建分组", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditClusterDialog(int id)
    {
        var parameters = new DialogParameters { { "ClusterId", id } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditClusterDialog>("编辑集群", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadAsync();
    }

    private async Task OpenManageGroupsDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ManageGroupsDialog>("分组管理", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
            // 若当前筛选的分组已被删除，重置为「全部分组」
            if (filterGroupId.HasValue && !groups.Any(g => g.Id == filterGroupId.Value))
            {
                filterGroupId = null;
            }
        }
    }

    private async Task RefreshCluster(int id)
    {
        processing = true;
        try
        {
            await ClusterService.RefreshClusterStatusAsync(id);
            await LoadAsync();
            Snackbar.Add("集群状态已刷新", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"刷新状态失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            processing = false;
        }
    }

    private async Task DeleteCluster(int id)
    {
        var cluster = clusters.FirstOrDefault(c => c.Id == id);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确认删除集群「{cluster?.Name ?? id.ToString()}」？此操作不可撤销。",
            yesText: "删除",
            noText: "取消");

        if (confirmed == true)
        {
            processing = true;
            try
            {
                await ClusterService.DeleteClusterAsync(id);
                Snackbar.Add("集群已删除", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除集群失败: {ex.Message}", Severity.Error);
            }
            finally
            {
                processing = false;
            }
        }
    }

    private void NavigateToDetail(int id)
    {
        NavigationManager.NavigateTo($"/clusters/{id}");
    }

    private static Color GetStatusColor(ClusterStatus status) => status switch
    {
        ClusterStatus.Online => Color.Success,
        ClusterStatus.Offline => Color.Error,
        _ => Color.Default
    };
} *@