<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudToggleGroup @bind-Value="connectionType"
                            Color="Color.Primary"
                            Class="mb-4"
                            Size="Size.Small">
                <MudToggleItem Value="@ConnectionType.KubeConfig">Kubeconfig</MudToggleItem>
                <MudToggleItem Value="@ConnectionType.Token">Token</MudToggleItem>
            </MudToggleGroup>

            <MudTextField @bind-Value="Name"
                          Label="集群名称"
                          Required="true"
                          RequiredError="请输入集群名称"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudSelect @bind-Value="GroupId"
                       Label="所属分组"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="mb-3">
                <MudSelectItem Value="@((int?)null)">无分组</MudSelectItem>
                @foreach (var group in groups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="ApiServer"
                          Label="API Server 地址"
                          Required="@(connectionType == ConnectionType.Token)"
                          RequiredError="Token 模式必填"
                          HelperText="@(connectionType == ConnectionType.Token ? "Token 模式必填" : "可选，留空则从 kubeconfig 中解析")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            @if (connectionType == ConnectionType.KubeConfig)
            {
                <MudTextField @bind-Value="KubeConfig"
                              Label="KubeConfig"
                              Required="true"
                              RequiredError="请填写 KubeConfig"
                              Lines="10"
                              Placeholder="粘贴 kubeconfig 内容"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            }

            @if (connectionType == ConnectionType.Token)
            {
                <MudTextField @bind-Value="Token"
                              Label="Token"
                              Required="true"
                              RequiredError="请填写 Token"
                              Lines="4"
                              InputType="@(showToken ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => showToken = !showToken)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3" />

                <MudCheckBox T="bool" @bind-Checked="SkipTlsVerify"
                             Label="跳过 TLS 验证"
                             HelperText="自签证书建议勾选（有安全风险）"
                             Color="Color.Warning" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()"
                   Variant="Variant.Text"
                   Disabled="saving">
            取消
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="saving"
                   StartIcon="@(!saving ? Icons.Material.Filled.Save : null)">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            保存
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int ClusterId { get; set; }
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    [Inject] private ClusterService ClusterService { get; set; } = default!;
    [Inject] private GroupService GroupService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm form = default!;
    private List<ClusterGroupViewModel> groups = new();

    private ConnectionType connectionType = ConnectionType.KubeConfig;
    private string Name = "";
    private int? GroupId;
    private string ApiServer = "";
    private string KubeConfig = "";
    private string Token = "";
    private bool SkipTlsVerify = true;
    private bool showToken;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var edit = await ClusterService.GetClusterForEditAsync(ClusterId);
            if (edit is null)
            {
                Snackbar.Add("未找到该集群", Severity.Error);
                Dialog.Cancel();
                return;
            }

            Name = edit.Name;
            GroupId = edit.GroupId;
            ApiServer = edit.ApiServer ?? "";
            connectionType = edit.ConnectionType;
            KubeConfig = edit.KubeConfig ?? "";
            Token = edit.Token ?? "";
            SkipTlsVerify = edit.SkipTlsVerify;

            groups = await GroupService.GetGroupsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载集群信息失败: {ex.Message}", Severity.Error);
            Dialog.Cancel();
        }
    }

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid)
            return;

        if (connectionType == ConnectionType.KubeConfig && string.IsNullOrWhiteSpace(KubeConfig))
        {
            Snackbar.Add("请填写 KubeConfig", Severity.Warning);
            return;
        }

        if (connectionType == ConnectionType.Token && (string.IsNullOrWhiteSpace(Token) || string.IsNullOrWhiteSpace(ApiServer)))
        {
            Snackbar.Add("Token 模式需填写 API Server 与 Token", Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            var vm = new ClusterUpdateViewModel
            {
                Id = ClusterId,
                Name = Name,
                GroupId = GroupId,
                ConnectionType = connectionType,
                ApiServer = string.IsNullOrWhiteSpace(ApiServer) ? null : ApiServer,
                KubeConfig = connectionType == ConnectionType.KubeConfig ? KubeConfig : null,
                Token = connectionType == ConnectionType.Token ? Token : null,
                SkipTlsVerify = SkipTlsVerify
            };

            await ClusterService.UpdateClusterAsync(vm);
            Snackbar.Add("集群已更新", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"更新失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }
}
