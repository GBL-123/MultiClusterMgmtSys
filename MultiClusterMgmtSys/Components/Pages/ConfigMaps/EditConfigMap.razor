@attribute [Authorize(Roles="Admin")]
@page "/configmaps/{ClusterId:int}/{Namespace}/{Name}/edit"

<PageTitle>修改 ConfigMap: @Name</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4" Class="flex-grow-1">修改 ConfigMap: @Name</MudText>
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}"))">
        返回列表
    </MudButton>
</div>

@if (loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (loadError)
{
    <MudCard Class="pa-8" Elevation="2">
        <MudCardContent>
            <MudText Align="Align.Center" Class="mud-text-secondary" Typo="Typo.h6">ConfigMap 不存在或已被删除</MudText>
            <div class="d-flex justify-center mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo($"/configmaps/{ClusterId}"))">
                    返回列表
                </MudButton>
            </div>
        </MudCardContent>
    </MudCard>
}
else
{
    <MudCard Elevation="1" Class="mb-4">
        <MudCardContent>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="displayName"
                                  Label="名称"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="displayNamespace"
                                  Label="命名空间"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="1" Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Data 键值对</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddKeyDialog"
                           Size="Size.Small">
                    添加键
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @if (dataEntries.Count == 0)
            {
                <MudText Class="mud-text-secondary" Align="Align.Center">暂无数据条目，点击"添加键"添加</MudText>
            }
            else
            {
                <MudTabs @bind-ActivePanelIndex="activeTab" Position="Position.Left" ApplyEffectsToContainer="true">
                    @for (int i = 0; i < dataEntries.Count; i++)
                    {
                        var index = i;
                        <MudTabPanel Text="@dataEntries[index].Key"
                                     Closeable="true"
                                     OnClose="@(() => RemoveEntry(index))">
                            <div class="pa-4">
                                <MudTextField T="string"
                                              @bind-Value="dataEntries[index].Value"
                                              Label="@($"值 ({dataEntries[index].Key})")"
                                              Lines="8"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Style="font-family: monospace; width: 100%;" />
                            </div>
                        </MudTabPanel>
                    }
                </MudTabs>
            }
        </MudCardContent>
    </MudCard>

    @* Inline add-key dialog *@
    @if (showAddKeyDialog)
    {
        <MudOverlay Visible="true" OnClick="@(() => showAddKeyDialog = false)" />
        <MudCard Elevation="8" Class="pa-4" Style="position: fixed; top: 30%; left: 50%; transform: translate(-50%, -30%); z-index: 1000; min-width: 360px;">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">添加键</MudText>
                <MudTextField @bind-Value="newKey"
                              Label="键名"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              Immediate="true" />
                <div class="d-flex justify-end gap-2">
                    <MudButton Variant="Variant.Text" OnClick="@(() => showAddKeyDialog = false)">取消</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmAddKey">确认</MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }

    @* Save button *@
    <div class="d-flex justify-end mt-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Save"
                   Disabled="saving">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            保存
        </MudButton>
    </div>
}

@code {
    [Parameter] public int ClusterId { get; set; }
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    [Inject] private ConfigMapService ConfigMapService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private List<ConfigMapDataEntryViewModel> dataEntries = new();
    private string displayName = "";
    private string displayNamespace = "";
    private bool loading = true;
    private bool loadError;
    private bool saving;
    private int activeTab;

    // For add key inline dialog
    private bool showAddKeyDialog;
    private string newKey = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            loadError = false;
            var detail = await ConfigMapService.GetConfigMapAsync(ClusterId, Name, Namespace);
            if (detail is null)
            {
                Snackbar.Add("ConfigMap 不存在或已被删除", Severity.Warning);
                loadError = true;
                return;
            }
            displayName = detail.Name;
            displayNamespace = detail.Namespace;
            dataEntries = detail.Data.Select(d => new ConfigMapDataEntryViewModel { Key = d.Key, Value = d.Value }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载 ConfigMap 详情失败: {ex.Message}", Severity.Error);
            loadError = true;
        }
        finally
        {
            loading = false;
        }
    }

    private void RemoveEntry(int index)
    {
        if (index >= 0 && index < dataEntries.Count)
        {
            dataEntries.RemoveAt(index);
            // Adjust active tab if needed
            if (activeTab >= dataEntries.Count && dataEntries.Count > 0)
                activeTab = dataEntries.Count - 1;
        }
    }

    private void OpenAddKeyDialog()
    {
        newKey = "";
        showAddKeyDialog = true;
    }

    private void ConfirmAddKey()
    {
        if (string.IsNullOrWhiteSpace(newKey))
        {
            Snackbar.Add("键名不能为空", Severity.Warning);
            return;
        }
        if (dataEntries.Any(e => e.Key == newKey))
        {
            Snackbar.Add("键名已存在", Severity.Warning);
            return;
        }
        dataEntries.Add(new ConfigMapDataEntryViewModel { Key = newKey, Value = "" });
        activeTab = dataEntries.Count - 1;
        showAddKeyDialog = false;
    }

    private async Task Save()
    {
        // Check for duplicate keys
        var keys = dataEntries.Where(e => !string.IsNullOrWhiteSpace(e.Key)).Select(e => e.Key).ToList();
        if (keys.Distinct().Count() != keys.Count)
        {
            Snackbar.Add("存在重复的键名", Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            var vm = new ConfigMapUpdateViewModel
            {
                ClusterId = ClusterId,
                Name = Name,
                Namespace = Namespace,
                DataEntries = dataEntries.Where(e => !string.IsNullOrWhiteSpace(e.Key)).ToList()
            };
            await ConfigMapService.UpdateConfigMapAsync(ClusterId, vm);
            Snackbar.Add("修改成功", Severity.Success);
            NavigationManager.NavigateTo($"/configmaps/{ClusterId}");
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("409") || msg.Contains("Conflict"))
                Snackbar.Add("资源已被他人修改，请刷新后重试", Severity.Warning);
            else
                Snackbar.Add($"修改失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }
}
