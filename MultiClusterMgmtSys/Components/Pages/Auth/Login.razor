@page "/login"
@layout EmptyLayout

@using MultiClusterMgmtSys.Components.Redirection

<PageTitle>登录</PageTitle>

<div class="mcm-page d-flex align-center justify-center" style="min-height:100vh; background:var(--mud-palette-background);">
    <MudCard Elevation="8" Class="pa-8" Style="width:400px; max-width:90vw;">
        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-2">多集群管理系统</MudText>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudText Color="Color.Error" Align="Align.Center" Class="mb-3">@errorMessage</MudText>
        }

        <form method="post" action="/api/login" id="login">
            <input type="hidden" name="ReturnUrl" value="@input.ReturnUrl" />
            <AntiforgeryToken />
            <MudTextField @bind-Value="@input.UserName"
                          name="UserName"
                          Label="用户名"
                          Required="true"
                          RequiredError="请输入用户名"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudTextField @bind-Value="@input.Password"
                          name="Password"
                          Label="密码"
                          Required="true"
                          RequiredError="请输入密码"
                          Immediate="true"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudCheckBox @bind-Value="@input.RememberMe"
                         Label="记住我"
                         Class="mb-4" />
            <input type="hidden" name="RememberMe" value="@(input.RememberMe ? "true" : "false")" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       ButtonType="ButtonType.Submit">
                登 录
            </MudButton>
        </form>

        <MudDivider Class="my-4" />

        <MudText Align="Align.Center" Class="mud-text-secondary">
            没有账号？<MudLink Href="/register" Underline="Underline.Always">立即注册</MudLink>
        </MudText>
    </MudCard>
</div>

@code {
    [Inject] private IdentityRedirectManager RedirectManager { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private string? errorMessage;
    private InputModel input = new();
    private EditContext editContext = default!;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(input);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            RedirectManager.RedirectTo(input.ReturnUrl);
        }
    }

    private sealed class InputModel
    {
        public string UserName { get; set; } = "";

        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = false;

        public string ReturnUrl { get; set; } = "/";
    }
}
