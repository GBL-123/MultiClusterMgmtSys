@using MultiClusterMgmtSys.ViewModels

@inject NavigationManager NavigationManager

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => NavigationManager.NavigateTo($"/services/{ClusterId}"))">
            返回列表
        </MudButton>
        <MudText Typo="Typo.h4" Class="flex-auto ml-2">@Name</MudText>
        @if (!string.IsNullOrEmpty(Type))
        {
            <MudChip T="string" Size="Size.Small" Class="font-mono">@Type</MudChip>
        }
        @if (!string.IsNullOrEmpty(ClusterIP))
        {
            <MudChip T="string" Size="Size.Small" Class="font-mono ml-2">@ClusterIP</MudChip>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRefresh"
                   Disabled="Processing">
            @if (Processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            刷新
        </MudButton>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Code"
                           OnClick="OnEditYaml">
                    编辑 YAML
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="OnDelete">
                    删除
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Name { get; set; } = "";

    [Parameter]
    public string Type { get; set; } = "";

    [Parameter]
    public string ClusterIP { get; set; } = "";

    [Parameter]
    public bool Processing { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public EventCallback OnEditYaml { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }
}
