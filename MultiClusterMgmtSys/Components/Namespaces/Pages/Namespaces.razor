@attribute [Authorize]
@page "/namespaces"
@page "/namespaces/{ClusterId:int}"

@using MultiClusterMgmtSys.Common.Enums
@using MultiClusterMgmtSys.Requests
@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.ViewModels
@using MultiClusterMgmtSys.Components.Namespaces.Shared

@inject ClusterService ClusterService
@inject NamespaceService NamespaceService
@inject ClusterSelectionState ClusterSelection
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>命名空间管理</PageTitle>

<MudStack Row="true" Spacing="3" Class="d-flex flex-auto">
    <ClusterSelectSidebar Clusters="@clusters"
                          SelectedClusterId="@EffectiveClusterId"
                          OnClusterSelected="SelectCluster" />

    <MudStack Class="flex-auto">
        @if (!EffectiveClusterId.HasValue)
        {
            <div class="d-flex flex-column align-center justify-center" style="min-height:60vh;">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Large" Class="mud-text-secondary mb-4" />
                <MudText Typo="Typo.h6" Class="mud-text-secondary">请从左侧选择一个集群</MudText>
            </div>
        }
        else if (loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else if (cluster is null)
        {
            <MudCard Class="pa-8" Elevation="2">
                <MudCardContent>
                    <MudText Align="Align.Center" Class="mud-text-secondary">未找到该集群</MudText>
                    <div class="d-flex justify-center mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => NavigationManager.NavigateTo("/clusters"))">
                            返回集群列表
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">命名空间管理</MudText>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="GetClusterStatusColor(cluster.Status)"
                                 Variant="Variant.Filled"
                                 Class="ml-2">
                            @cluster.Name · @cluster.StatusText
                        </MudChip>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="@(() => LoadAsync(EffectiveClusterId!.Value))"
                                   Disabled="@loading">
                            刷新
                        </MudButton>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="OpenCreateDialog"
                                           Disabled="@(!cluster.IsReachable)">
                                    新建命名空间
                                </MudButton>
                            </Authorized>
                        </AuthorizeView>
                    </MudStack>

                    @if (cluster.IsReachable)
                    {
                        <NamespaceListFilterBar @bind-SearchName="searchName"
                                                OnQuery="OnQueryClick"
                                                OnReset="OnResetClick" />
                    }
                </MudStack>
            </MudPaper>

            @if (!cluster.IsReachable)
            {
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达，无法获取命名空间</MudText>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <NamespaceListTable Items="@filteredNamespaces"
                                    Loading="@loading"
                                    OnNavigateDetail="NavigateToDetail"
                                    OnDelete="DeleteNamespace" />
            }
        }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public int? ClusterId { get; set; }

    private List<ClusterViewModel> clusters = new();

    private ClusterDetailViewModel? cluster;

    private List<NamespaceListViewModel> namespaces = new();

    private bool loading;

    private string searchName = "";

    private string appliedSearchName = "";

    private int? previousClusterId;

    private bool hasInitialized;

    /// <summary>
    /// 当前生效的集群上下文:URL 参数存在时用 URL 参数,
    /// 否则用会话级记忆的选择(回到 /namespaces 时原位恢复)。
    /// </summary>
    private int? EffectiveClusterId => ClusterId ?? ClusterSelection.SelectedClusterId;

    private List<NamespaceListViewModel> filteredNamespaces
    {
        get
        {
            var q = namespaces.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(appliedSearchName))
                q = q.Where(ns => ns.Name.Contains(appliedSearchName, StringComparison.OrdinalIgnoreCase));
            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadClustersAsync();
    }

    protected override void OnParametersSet()
    {
        if (ClusterId.HasValue)
        {
            ClusterSelection.Set(ClusterId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId == previousClusterId && hasInitialized)
        {
            return;
        }
        hasInitialized = true;
        previousClusterId = ClusterId;

        if (EffectiveClusterId.HasValue)
        {
            await LoadAsync(EffectiveClusterId.Value);
        }
        else
        {
            cluster = null;
            namespaces = new();
            loading = false;
        }
    }

    private async Task LoadClustersAsync()
    {
        try
        {
            var request = new ClusterQueryRequest { Page = 1, PageSize = 1000, SortBy = ClusterSortField.Name, SortDescending = false };
            var result = await ClusterService.GetPagedAsync(request);
            clusters = result.Items;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群列表");
        }
    }

    private async Task LoadAsync(int id)
    {
        loading = true;
        try
        {
            cluster = await ClusterService.GetClusterDetailAsync(id);
            if (cluster is not null)
            {
                ClusterSelection.Set(id);
            }
            if (cluster is not null && cluster.IsReachable)
            {
                try
                {
                    namespaces = await NamespaceService.ListNamespacesAsync(id);
                }
                catch (Exception ex)
                {
                    await ExHandler.HandleAsync(ex, "加载命名空间列表");
                }
            }
            else
            {
                namespaces = new();
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群详情");
        }
        finally
        {
            loading = false;
        }
    }

    private void SelectCluster(int id)
    {
        NavigationManager.NavigateTo($"/namespaces/{id}");
    }

    private void OnQueryClick()
    {
        appliedSearchName = searchName;
    }

    private async Task OnResetClick()
    {
        searchName = "";
        appliedSearchName = "";
        if (EffectiveClusterId.HasValue)
        {
            await LoadAsync(EffectiveClusterId.Value);
        }
    }

    private void NavigateToDetail(string name)
    {
        NavigationManager.NavigateTo($"/namespaces/{EffectiveClusterId!.Value}/{name}");
    }

    private async Task DeleteNamespace(string name)
    {
        var parameters = new DialogParameters
        {
            { "Message", $"确认删除命名空间「{name}」？该操作将删除其中的所有资源，且不可撤销。" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await NamespaceService.DeleteNamespaceAsync(new NamespaceKeyRequest(EffectiveClusterId!.Value, name));
                Snackbar.Add("删除成功", Severity.Success);
                await LoadAsync(EffectiveClusterId!.Value);
            }
            catch (Exception ex)
            {
                await ExHandler.HandleAsync(ex, "删除命名空间");
            }
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { { "ClusterId", EffectiveClusterId!.Value } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateNamespaceDialog>("新建命名空间", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync(EffectiveClusterId!.Value);
    }

    private static Color GetClusterStatusColor(ClusterStatus status) => status switch
    {
        ClusterStatus.Online => Color.Success,
        ClusterStatus.Offline => Color.Error,
        _ => Color.Default
    };
}
