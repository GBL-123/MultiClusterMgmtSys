@attribute [Authorize]
@page "/namespaces/{ClusterId:int}/{Name}"

@using MultiClusterMgmtSys.Requests
@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.ViewModels
@using MultiClusterMgmtSys.Components.Namespaces.Shared

@inject NamespaceService NamespaceService
@inject ClusterSelectionState ClusterSelection
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>命名空间详情: @Name</PageTitle>

<MudStack Class="flex-auto d-flex" Style="align-self: stretch; min-height: 0;">
    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (detail is null)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">命名空间不存在或已被删除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/namespaces/{ClusterId}"))">
                        返回列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <NamespaceDetailToolbar ClusterId="@ClusterId"
                                Name="@Name"
                                Detail="@detail"
                                Processing="@loading"
                                OnRefresh="LoadAsync" />
        <MudTabs @bind-ActivePanelIndex="activeTabIndex"
                 Class="detail-tabs"
                 Elevation="0"
                 Rounded="false"
                 TabPanelsClass="detail-tabs-panels">
            <MudTabPanel Text="YAML">
                <NamespaceYamlViewCard Yaml="@detail.Yaml" />
            </MudTabPanel>
            <MudTabPanel Text="标签与注解">
                <MudStack Spacing="3">
                    <NamespaceLabelsCard Labels="@detail.Labels" />
                    <NamespaceAnnotationsCard Annotations="@detail.Annotations" />
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Name { get; set; } = "";


    private NamespaceDetailViewModel? detail;

    private bool loading = true;

    private int activeTabIndex;

    protected override async Task OnInitializedAsync()
    {
        ClusterSelection.Set(ClusterId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            detail = await NamespaceService.GetNamespaceAsync(new NamespaceKeyRequest(ClusterId, Name));
            if (detail is null)
            {
                Snackbar.Add("命名空间不存在或已被删除", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载详情");
        }
        finally
        {
            loading = false;
        }
    }
}
