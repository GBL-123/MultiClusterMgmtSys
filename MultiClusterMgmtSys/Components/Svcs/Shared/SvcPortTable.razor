@using MultiClusterMgmtSys.ViewModels

<MudCard Class="pa-4" Elevation="0">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">端口</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (Ports.Count == 0)
        {
            <div class="empty-state">[ 暂无端口 ]</div>
        }
        else
        {
            <MudTable T="SvcPortViewModel" Items="@Ports" Hover="true" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>端口</MudTh>
                    <MudTh>TargetPort</MudTh>
                    <MudTh>协议</MudTh>
                    <MudTh>NodePort</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="端口"><span class="font-mono">@context.Port</span></MudTd>
                    <MudTd DataLabel="TargetPort"><span class="font-mono">@(context.TargetPort ?? "—")</span></MudTd>
                    <MudTd DataLabel="协议"><span class="font-mono">@context.Protocol</span></MudTd>
                    <MudTd DataLabel="NodePort"><span class="font-mono">@(context.NodePort?.ToString() ?? "—")</span></MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public IReadOnlyList<SvcPortViewModel> Ports { get; set; } = new List<SvcPortViewModel>();
}
