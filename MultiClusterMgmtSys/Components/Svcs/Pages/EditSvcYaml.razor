@attribute [Authorize(Roles="Admin")]
@page "/services/{ClusterId:int}/{Namespace}/{Name}/yaml"

@using k8s
@using k8s.Models
@using MultiClusterMgmtSys.Common.Exceptions
@using MultiClusterMgmtSys.Requests
@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.ViewModels
@using MultiClusterMgmtSys.Components.Svcs.Shared

@inject SvcService SvcService
@inject ClusterSelectionState ClusterSelection
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>编辑 YAML: @Name</PageTitle>

<MudStack Class="flex-auto d-flex" Style="align-self: stretch; min-height: 0;">
    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (loadError)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary" Typo="Typo.h6">Service 不存在或已被删除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/services/{ClusterId}"))">
                        返回列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo($"/services/{ClusterId}"))">
                    返回列表
                </MudButton>
                <MudText Typo="Typo.h4" Class="flex-auto ml-2">编辑 YAML: @Name</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="Save"
                           Disabled="saving">
                    @if (saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    保存
                </MudButton>
            </MudStack>
        </MudPaper>

        <SvcYamlEditCard @bind-Yaml="yamlContent" />
    }
</MudStack>

@code {
    [Parameter]
    public int ClusterId { get; set; }

    [Parameter]
    public string Namespace { get; set; } = "";

    [Parameter]
    public string Name { get; set; } = "";


    private string yamlContent = "";

    private bool loading = true;

    private bool loadError;

    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        ClusterSelection.Set(ClusterId);
        try
        {
            loadError = false;
            var detail = await SvcService.GetSvcAsync(new SvcKeyRequest(ClusterId, Name, Namespace));
            if (detail is null)
            {
                Snackbar.Add("Service 不存在或已被删除", Severity.Warning);
                loadError = true;
                return;
            }
            yamlContent = detail.Yaml;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载服务详情");
            loadError = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        try
        {
            KubernetesYaml.Deserialize<V1Service>(yamlContent);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(new ValidationException($"YAML 格式错误:{ex.Message}"), "保存");
            return;
        }

        saving = true;
        try
        {
            await SvcService.UpdateSvcFromYamlAsync(new SvcUpdateRequest(ClusterId, Name, Namespace, yamlContent));
            Snackbar.Add("修改成功", Severity.Success);
            NavigationManager.NavigateTo($"/services/{ClusterId}");
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "保存服务");
        }
        finally
        {
            saving = false;
        }
    }
}
