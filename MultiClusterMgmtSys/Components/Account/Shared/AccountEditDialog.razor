@using Microsoft.AspNetCore.Identity
@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.ViewModels

@inject AccountService AccountSvc
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField @bind-Value="userName"
                          Label="用户名"
                          Required="true"
                          RequiredError="请输入用户名"
                          Immediate="true"
                          Disabled="@isEdit"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudSelect T="string"
                       @bind-Value="roleName"
                       Label="角色"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="mb-3">
                <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                <MudSelectItem Value="@("Member")">Member</MudSelectItem>
            </MudSelect>

            @if (!isEdit)
            {
                <MudTextField @bind-Value="password"
                              Label="初始密码"
                              Required="true"
                              RequiredError="请输入初始密码"
                              Immediate="true"
                              InputType="@(showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => showPassword = !showPassword)"
                              HelperText="至少 8 位且包含数字"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-2" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()"
                   Variant="Variant.Text"
                   Disabled="saving">
            取消
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="saving">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(isEdit ? "保存" : "创建")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public AccountViewModel? EditingAccount { get; set; }

    private MudForm form = default!;

    private bool isEdit => EditingAccount is not null;

    private string userName = "";

    private string roleName = "Member";

    private string password = "";

    private bool showPassword;

    private bool saving;

    protected override void OnInitialized()
    {
        if (EditingAccount is not null)
        {
            userName = EditingAccount.UserName;
            roleName = EditingAccount.RoleName;
        }
    }

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;

        saving = true;
        try
        {
            var result = isEdit
                ? await AccountSvc.UpdateAccountAsync(EditingAccount!.Id, roleName)
                : await AccountSvc.CreateAccountAsync(userName, password, roleName);
            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok(true));
            }
            else
            {
                ShowErrors(result);
            }
        }
        finally
        {
            saving = false;
        }
    }

    private void ShowErrors(IdentityResult result)
    {
        var msg = string.Join("; ", result.Errors.Select(e => e.Description));
        Snackbar.Add(msg, Severity.Error);
    }
}
