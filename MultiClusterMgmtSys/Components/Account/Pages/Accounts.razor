@attribute [Authorize(Roles = "Admin")]
@page "/accounts"


<PageTitle>账号管理</PageTitle>

<MudStack>
    <div class="d-flex align-center mb-4" style="justify-content: space-between;">
        <MudText Typo="Typo.h4">账号管理</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenCreateDialog">
            新建账号
        </MudButton>
    </div>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (accounts.Length == 0)
    {
        <div class="d-flex flex-column align-center justify-center" style="min-height:300px;">
            <MudText Class="mud-text-secondary">暂无账号</MudText>
        </div>
    }
    else
    {
        <MudTable T="AccountViewModel"
                  Items="@accounts"
                  Dense="true"
                  Hover="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh>用户名</MudTh>
                <MudTh>显示名</MudTh>
                <MudTh>角色</MudTh>
                <MudTh>创建时间</MudTh>
                <MudTh Style="width:240px;">操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="用户名">@context.UserName</MudTd>
                <MudTd DataLabel="显示名">@(context.DisplayName ?? "—")</MudTd>
                <MudTd DataLabel="角色">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.RoleName == "Admin" ? Color.Primary : Color.Default)"
                             Variant="Variant.Outlined">
                        @context.RoleName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="创建时间">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="操作">
                    <div @onclick:stopPropagation="true" class="d-flex gap-1" style="gap: 4px;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Title="编辑"
                                       OnClick="@(() => OpenEditDialog(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.LockReset"
                                       Size="Size.Small"
                                       Title="重置密码"
                                       OnClick="@(() => OpenResetPasswordDialog(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Title="删除"
                                       OnClick="@(() => DeleteAccount(context))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    [Inject] private AccountService AccountSvc { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private AccountViewModel[] accounts = Array.Empty<AccountViewModel>();
    private bool loading;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(idStr, out currentUserId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            accounts = await AccountSvc.GetAllAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载账号失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "EditingAccount", null }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AccountEditDialog>("新建账号", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(AccountViewModel account)
    {
        var parameters = new DialogParameters
        {
            { "EditingAccount", account }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AccountEditDialog>("编辑账号", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenResetPasswordDialog(AccountViewModel account)
    {
        var parameters = new DialogParameters
        {
            { "AccountId", account.Id },
            { "UserName", account.UserName }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>("重置密码", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("密码已重置", Severity.Success);
        }
    }

    private async Task DeleteAccount(AccountViewModel account)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确认删除账号「{account.UserName}」？此操作不可撤销。",
            yesText: "删除",
            noText: "取消");
        if (confirmed != true) return;

        var result = await AccountSvc.DeleteAccountAsync(account.Id, currentUserId);
        if (result.Succeeded)
        {
            Snackbar.Add("账号已删除", Severity.Success);
            await LoadAsync();
        }
        else
        {
            var msg = result.Errors.FirstOrDefault()?.Description ?? "删除失败";
            Snackbar.Add(msg, Severity.Error);
        }
    }
}
