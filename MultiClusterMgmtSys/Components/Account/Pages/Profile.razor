@* @attribute [Authorize]
@page "/profile"

<PageTitle>个人资料</PageTitle>

<MudStack Style="max-width: 600px;">
    <MudText Typo="Typo.h4" Class="mb-2">个人资料</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">修改显示名与密码</MudText>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    <MudCard Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">修改密码</MudText>

        <MudTextField @bind-Value="currentPassword"
                      Label="当前密码"
                      Required="true"
                      RequiredError="请输入当前密码"
                      Immediate="true"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTextField @bind-Value="newPassword"
                      Label="新密码"
                      Required="true"
                      RequiredError="请输入新密码"
                      Immediate="true"
                      InputType="InputType.Password"
                      HelperText="至少 8 位且包含字母和数字"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-3" />

        <MudTextField @bind-Value="confirmPassword"
                      Label="确认新密码"
                      Required="true"
                      RequiredError="请再次输入新密码"
                      Immediate="true"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-4" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.LockReset"
                   OnClick="ChangePassword"
                   Disabled="savingPassword">
            @if (savingPassword)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            修改密码
        </MudButton>
    </MudCard>
</MudStack>

@code {
    [Inject] private AccountService AccountSvc { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string currentUserName = "";
    private bool loading;
    private bool savingDisplayName;
    private bool savingPassword;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserName = authState.User.Identity?.Name ?? "";
            var user = await AccountSvc.GetUserByNameAsync(currentUserName);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载用户资料失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveDisplayName()
    {
        if (string.IsNullOrEmpty(currentUserName)) return;
        savingDisplayName = true;
        try
        {
            var result = await AccountSvc.UpdateProfileAsync(currentUserName);
            if (result.Succeeded)
            {
                Snackbar.Add("资料已更新", Severity.Success);
            }
            else
            {
                var msg = result.Errors.FirstOrDefault()?.Description ?? "更新失败";
                Snackbar.Add(msg, Severity.Error);
            }
        }
        finally
        {
            savingDisplayName = false;
        }
    }

    private async Task ChangePassword()
    {
        if (string.IsNullOrEmpty(currentUserName)) return;
        if (newPassword != confirmPassword)
        {
            Snackbar.Add("两次输入的密码不一致", Severity.Error);
            return;
        }

        savingPassword = true;
        try
        {
            var result = await AccountSvc.ChangePasswordAsync(currentUserName, currentPassword, newPassword);
            if (result.Succeeded)
            {
                Snackbar.Add("密码已更新", Severity.Success);
                currentPassword = "";
                newPassword = "";
                confirmPassword = "";
            }
            else
            {
                var code = result.Errors.FirstOrDefault()?.Code ?? "";
                var msg = code == "PasswordMismatch" ? "当前密码错误" :
                          result.Errors.FirstOrDefault()?.Description ?? "修改失败";
                Snackbar.Add(msg, Severity.Error);
            }
        }
        finally
        {
            savingPassword = false;
        }
    }
} *@
