@attribute [Authorize]
@page "/nodes"
@page "/nodes/{ClusterId:int}"

@using MultiClusterMgmtSys.Common.Enums
@using MultiClusterMgmtSys.Requests
@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.Components.Clusters.ViewModels
@using MultiClusterMgmtSys.Components.Nodes.Shared

<PageTitle>节点管理</PageTitle>

<MudStack Row="true" Spacing="3" Class="d-flex flex-auto">
    <ClusterSelectSidebar Clusters="@clusters"
                          SelectedClusterId="@EffectiveClusterId"
                          OnClusterSelected="SelectCluster" />

    <MudStack Class="flex-auto">
        @if (!EffectiveClusterId.HasValue)
        {
            <div class="d-flex flex-column align-center justify-center" style="min-height:60vh;">
                <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Size="Size.Large" Class="mud-text-secondary mb-4" />
                <MudText Typo="Typo.h6" Class="mud-text-secondary">请从左侧选择一个集群</MudText>
            </div>
        }
        else if (cluster is null && loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else if (cluster is null)
        {
            <MudCard Class="pa-8" Elevation="2">
                <MudCardContent>
                    <MudText Align="Align.Center" Class="mud-text-secondary">未找到该集群</MudText>
                    <div class="d-flex justify-center mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => NavigationManager.NavigateTo("/clusters"))">
                            返回集群列表
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        }
        else if (!cluster.IsReachable)
        {
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达，无法获取节点列表</MudText>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack>
                    <NodeListToolbar Cluster="@cluster"
                                     Processing="@loading"
                                     OnRefresh="@(() => LoadAsync(EffectiveClusterId!.Value))" />

                    <NodeListFilterBar Filter="@filter"
                                       OnFilterChanged="@(() => StateHasChanged())"
                                       OnReset="ResetFilter" />
                </MudStack>
            </MudPaper>

            <NodeListTable Nodes="@filteredNodes"
                           FilterActive="@filter.IsActive"
                           Loading="@loading"
                           OnNavigateNode="@(name => NavigationManager.NavigateTo($"/nodes/{EffectiveClusterId}/{name}"))" />
        }
    </MudStack>
</MudStack>

@code {
    [Parameter] public int? ClusterId { get; set; }

    [Inject] private ClusterService ClusterService { get; set; } = default!;
    [Inject] private ClusterNodeService ClusterNodeService { get; set; } = default!;
    [Inject] private ClusterSelectionState ClusterSelection { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private List<ClusterViewModel> clusters = new();
    private ClusterDetailViewModel? cluster;
    private List<ClusterNodeViewModel> nodes = new();
    private bool loading;
    private int? previousClusterId;
    private bool hasInitialized;
    private NodeListFilter filter = new();

    /// <summary>
    /// The cluster currently being shown: the URL parameter when present,
    /// otherwise the session-remembered selection (restored in place on /nodes).
    /// </summary>
    private int? EffectiveClusterId => ClusterId ?? ClusterSelection.SelectedClusterId;

    private List<ClusterNodeViewModel> filteredNodes
    {
        get
        {
            var q = nodes.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filter.Name))
                q = q.Where(n => n.Name.Contains(filter.Name, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(filter.Role))
                q = q.Where(n => (n.Roles ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Contains(filter.Role, StringComparer.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(filter.Status))
                q = q.Where(n => n.Status == filter.Status);

            if (filter.Schedulable.HasValue)
                q = q.Where(n => n.Unschedulable == filter.Schedulable.Value);

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadClustersAsync();
    }

    protected override void OnParametersSet()
    {
        if (ClusterId.HasValue)
        {
            ClusterSelection.Set(ClusterId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId == previousClusterId && hasInitialized)
        {
            return;
        }
        hasInitialized = true;
        previousClusterId = ClusterId;

        if (EffectiveClusterId.HasValue)
        {
            cluster = null;
            nodes = new();
            await LoadAsync(EffectiveClusterId.Value);
        }
        else
        {
            cluster = null;
            nodes = new();
            loading = false;
        }
    }

    private async Task LoadClustersAsync()
    {
        try
        {
            var request = new ClusterQueryRequest { Page = 1, PageSize = 1000, SortBy = ClusterSortField.Name, SortDescending = false };
            var result = await ClusterService.GetPagedAsync(request);
            clusters = result.Items;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载集群列表失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAsync(int id)
    {
        loading = true;
        try
        {
            cluster = await ClusterService.GetClusterDetailAsync(id);
            if (cluster is not null && cluster.IsReachable)
            {
                try
                {
                    nodes = await ClusterNodeService.GetClusterNodesAsync(id);
                }
                catch (Exception ex)
                {
                    nodes = new();
                    Snackbar.Add($"加载节点列表失败: {ex.Message}", Severity.Error);
                }
            }
            else
            {
                nodes = new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载集群详情失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private void SelectCluster(int id)
    {
        NavigationManager.NavigateTo($"/nodes/{id}");
    }

    private void ResetFilter()
    {
        filter.Reset();
        StateHasChanged();
    }
}