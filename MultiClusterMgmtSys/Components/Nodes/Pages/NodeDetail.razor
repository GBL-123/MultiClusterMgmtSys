@attribute [Authorize]
@page "/nodes/{ClusterId:int}/{NodeName}"

@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.Components.Clusters.ViewModels
@using MultiClusterMgmtSys.Components.Common
@using MultiClusterMgmtSys.Components.Nodes.Shared
@using MultiClusterMgmtSys.ViewModels

<PageTitle>节点详情: @NodeName</PageTitle>

<MudStack Class="flex-auto pb-4" Style="align-self: flex-start;">
    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (node is null)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">未找到该节点</MudText>
                <MudText Align="Align.Center" Class="mud-text-secondary" Typo="Typo.body2">集群不存在、集群离线或节点已移除</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/nodes/{ClusterId}"))">
                        返回节点列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (!node.IsReachable)
    {
        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达，无法获取节点详情</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo($"/nodes/{ClusterId}"))">
                        返回节点列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <NodeDetailToolbar Node="@node"
                           Processing="@loading"
                           OnBack="@(() => NavigationManager.NavigateTo($"/nodes/{ClusterId}"))"
                           OnRefresh="LoadAsync" />

        <NodeOverviewCard Node="@node" OnRemarksChanged="LoadAsync" />
        <NodeResourcesCard Node="@node" />
        <NodeConditionsCard Node="@node" />

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6"><NodeLabelsCard Node="@node" /></MudItem>
            <MudItem xs="12" md="6"><NodeAnnotationsCard Node="@node" /></MudItem>
        </MudGrid>

        <NodeSystemInfoCard Node="@node" />
    }
</MudStack>

@code {
    [Parameter] public int ClusterId { get; set; }
    [Parameter] public string NodeName { get; set; } = "";

    [Inject] private ClusterNodeService ClusterNodeService { get; set; } = default!;
    [Inject] private ClusterSelectionState ClusterSelection { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ExceptionPresenter ExHandler { get; set; } = default!;

    private ClusterNodeDetailViewModel? node;
    private bool loading;
    private int previousClusterId;
    private string previousNodeName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        ClusterSelection.Set(ClusterId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId != previousClusterId || NodeName != previousNodeName)
        {
            previousClusterId = ClusterId;
            previousNodeName = NodeName;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            node = await ClusterNodeService.GetNodeDetailAsync(ClusterId, NodeName);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载节点详情");
        }
        finally
        {
            loading = false;
        }
    }
}