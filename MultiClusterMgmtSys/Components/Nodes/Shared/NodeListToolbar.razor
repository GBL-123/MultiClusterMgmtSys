@using MultiClusterMgmtSys.Common.Enums
@using MultiClusterMgmtSys.ViewModels

<MudStack Row="true" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.h5">节点管理</MudText>
    <MudChip T="string"
             Size="Size.Small"
             Variant="Variant.Outlined">
        @Cluster.Name
    </MudChip>
    <MudChip T="string"
             Size="Size.Small"
             Color="GetClusterStatusColor(Cluster.Status)"
             Variant="Variant.Filled">
        @Cluster.StatusText
    </MudChip>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="OnRefresh"
               Disabled="Processing">
        @if (Processing)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
        }
        刷新
    </MudButton>
</MudStack>

@code {
    [Parameter]
    public ClusterDetailViewModel Cluster { get; set; } = default!;

    [Parameter]
    public bool Processing { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private static Color GetClusterStatusColor(ClusterStatus status) => status switch
    {
        ClusterStatus.Online => Color.Success,
        ClusterStatus.Offline => Color.Error,
        _ => Color.Default
    };
}
