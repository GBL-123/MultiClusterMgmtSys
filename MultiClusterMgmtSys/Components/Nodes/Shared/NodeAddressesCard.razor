@using MultiClusterMgmtSys.ViewModels

@inject IDialogService DialogService

<MudCard Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">地址</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (Node.Addresses.Count > 0)
            {
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Settings"
                                   OnClick="OpenManageDialog">
                            管理
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (Node.Addresses.Count == 0)
        {
            <div class="empty-state">[ 暂无地址 ]</div>
        }
        else
        {
            <MudTable Items="Node.Addresses"
                      Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>类型</MudTh>
                    <MudTh>地址</MudTh>
                    <MudTh>备注</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="类型">
                        <StackedText Primary="@context.TypeText" Secondary="@context.Type" />
                    </MudTd>
                    <MudTd DataLabel="地址">
                        <MudText Class="font-mono">@context.Address</MudText>
                    </MudTd>
                    <MudTd DataLabel="备注">@(string.IsNullOrEmpty(context.Note) ? "—" : context.Note)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public ClusterNodeDetailViewModel Node { get; set; } = default!;

    [Parameter]
    public EventCallback OnRemarksChanged { get; set; }

    private async Task OpenManageDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameters = new DialogParameters<NodeIpNotesDialog>
        {
            { d => d.ClusterId, Node.ClusterId },
            { d => d.NodeName, Node.Name },
            { d => d.Addresses, Node.Addresses }
        };
        var dialog = await DialogService.ShowAsync<NodeIpNotesDialog>("管理节点 IP 备注", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await OnRemarksChanged.InvokeAsync();
        }
    }
}
