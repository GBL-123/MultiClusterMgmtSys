@using MultiClusterMgmtSys.Components.Clusters.ViewModels

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="OnBack">
            返回列表
        </MudButton>
        <MudText Typo="Typo.h4" Class="flex-auto ml-2">@Node.Name</MudText>
        <MudChip T="string"
                 Size="Size.Small"
                 Color="GetNodeStatusColor(Node.Status)"
                 Variant="Variant.Filled">
            @Node.Status
        </MudChip>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRefresh"
                   Disabled="Processing">
            @if (Processing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            刷新
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public ClusterNodeDetailViewModel Node { get; set; } = default!;
    [Parameter] public bool Processing { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private static Color GetNodeStatusColor(string status) => status switch
    {
        "Ready" => Color.Success,
        "NotReady" => Color.Error,
        _ => Color.Default
    };
}