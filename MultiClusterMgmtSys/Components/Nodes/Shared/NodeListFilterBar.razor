@using MultiClusterMgmtSys.Models

<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
    <MudTextField @bind-Value="Filter.Name"
                  Label="节点名称"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Placeholder="请输入节点名称"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Style="min-width:200px; flex:1;" />

    <MudSelect @bind-Value="Filter.Role"
               Label="角色"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="min-width:120px;">
        <MudSelectItem Value="@((string?)null)">全部</MudSelectItem>
        <MudSelectItem Value="@("control-plane")">控制平面 (control-plane)</MudSelectItem>
        <MudSelectItem Value="@("worker")">工作节点 (worker)</MudSelectItem>
    </MudSelect>

    <MudSelect @bind-Value="Filter.Status"
               Label="状态"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="min-width:120px;">
        <MudSelectItem Value="@((string?)null)">全部</MudSelectItem>
        <MudSelectItem Value="@("Ready")">就绪 (Ready)</MudSelectItem>
        <MudSelectItem Value="@("NotReady")">未就绪 (NotReady)</MudSelectItem>
        <MudSelectItem Value="@("Unknown")">未知 (Unknown)</MudSelectItem>
    </MudSelect>

    <MudSelect @bind-Value="Filter.Schedulable"
               Label="调度性"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="min-width:120px;">
        <MudSelectItem Value="@((bool?)null)">全部</MudSelectItem>
        <MudSelectItem Value="@((bool?)false)">可调度</MudSelectItem>
        <MudSelectItem Value="@((bool?)true)">不可调度</MudSelectItem>
    </MudSelect>

    <MudSpacer />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Search"
               OnClick="Search">
        查询
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="ResetFilter">
        重置
    </MudButton>
</MudStack>

@code {
    [Parameter]
    public NodeListFilter Filter { get; set; } = default!;

    [Parameter]
    public EventCallback OnQuery { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    private Task Search() => OnQuery.InvokeAsync();

    private Task ResetFilter()
    {
        Filter.Reset();
        return OnReset.InvokeAsync();
    }
}
