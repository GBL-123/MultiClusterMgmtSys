@using MultiClusterMgmtSys.Components.Nodes.Requests

<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="pa-4 mb-4">
    <MudTextField @bind-Value="Filter.Name"
                  Label="节点名称"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Placeholder="请输入节点名称"
                  Style="min-width:200px;" />

    <MudSelect @bind-Value="Filter.Role"
               Label="角色"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="min-width:120px;">
        <MudSelectItem Value="@((string?)null)">全部</MudSelectItem>
        <MudSelectItem Value="@("control-plane")">control-plane</MudSelectItem>
        <MudSelectItem Value="@("worker")">worker</MudSelectItem>
    </MudSelect>

    <MudSelect @bind-Value="Filter.Status"
               Label="状态"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="min-width:120px;">
        <MudSelectItem Value="@((string?)null)">全部</MudSelectItem>
        <MudSelectItem Value="@("Ready")">Ready</MudSelectItem>
        <MudSelectItem Value="@("NotReady")">NotReady</MudSelectItem>
        <MudSelectItem Value="@("Unknown")">Unknown</MudSelectItem>
    </MudSelect>

    <MudSelect @bind-Value="Filter.Schedulable"
               Label="调度性"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="min-width:120px;">
        <MudSelectItem Value="@((bool?)null)">全部</MudSelectItem>
        <MudSelectItem Value="@((bool?)false)">可调度</MudSelectItem>
        <MudSelectItem Value="@((bool?)true)">不可调度</MudSelectItem>
    </MudSelect>

    <MudSpacer />
    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="ResetFilter">
        重置
    </MudButton>
</MudStack>

@code {
    [Parameter] public NodeListFilter Filter { get; set; } = default!;
    [Parameter] public EventCallback OnFilterChanged { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private Task ResetFilter()
    {
        Filter.Reset();
        return OnReset.InvokeAsync();
    }
}