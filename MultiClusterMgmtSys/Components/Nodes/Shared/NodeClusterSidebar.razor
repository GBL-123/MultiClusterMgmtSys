@using MultiClusterMgmtSys.Common.Enums
@using MultiClusterMgmtSys.Components.Clusters.ViewModels

<MudPaper Class="node-cluster-sidebar"
          Elevation="1"
          Style="width:240px; min-width:240px; height:100%; display:flex; flex-direction:column; overflow:hidden;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3">
        <MudText Typo="Typo.h5">集群选择</MudText>
    </MudStack>
    <MudDivider />
    <MudNavMenu Rounded="true" Bordered="false" Style="flex:1; overflow-y:auto;" Class="node-cluster-nav">
        @foreach (var group in GroupedClusters)
        {
            <div class="node-cluster-group">
                <div class="node-cluster-group-header" @onclick="() => ToggleGroup(group.Name)">
                    <MudIcon Icon="@(IsGroupExpanded(group.Name) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                             Size="Size.Small"
                             Class="mud-text-secondary" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="flex:1;">@group.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@group.Clusters.Count</MudChip>
                </div>
                @if (IsGroupExpanded(group.Name))
                {
                    @foreach (var c in group.Clusters)
                    {
                        var cluster = c;
                        <MudNavLink OnClick="@(() => OnClusterSelected.InvokeAsync(cluster.Id))"
                                    Class="@(SelectedClusterId == cluster.Id ? "active" : "")">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Style="width:100%;" Spacing="0">
                                <MudIcon Icon="@Icons.Material.Filled.Circle"
                                         Size="Size.Small"
                                         Class="ml-1 mr-2"
                                         Style="@($"color:{GetStatusColor(cluster.Status)};")" />
                                <MudText Style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@cluster.Name</MudText>
                            </MudStack>
                        </MudNavLink>
                    }
                }
            </div>
        }
        @if (!Clusters.Any())
        {
            <MudNavLink Disabled="true">
                <MudText Class="mud-text-secondary">暂无集群</MudText>
            </MudNavLink>
        }
    </MudNavMenu>
</MudPaper>

<style>
    .node-cluster-group-header {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        cursor: pointer;
        user-select: none;
    }
    .node-cluster-group-header:hover {
        background-color: var(--mud-palette-action-hover);
    }
    .node-cluster-nav .mud-nav-link.active {
        background-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
    }
</style>

@code {
    [Parameter] public IReadOnlyList<ClusterViewModel> Clusters { get; set; } = new List<ClusterViewModel>();
    [Parameter] public int? SelectedClusterId { get; set; }
    [Parameter] public EventCallback<int> OnClusterSelected { get; set; }

    private readonly HashSet<string> collapsedGroups = new();

    private List<ClusterGroupNode> GroupedClusters
    {
        get
        {
            return Clusters
                .GroupBy(c => c.GroupName ?? "未分组")
                .Select(g => new ClusterGroupNode
                {
                    Name = g.Key,
                    Clusters = g.OrderBy(c => c.Name).ToList()
                })
                .OrderBy(g => g.Name == "未分组" ? 1 : 0)
                .ThenBy(g => g.Name)
                .ToList();
        }
    }

    private bool IsGroupExpanded(string name)
    {
        return !collapsedGroups.Contains(name);
    }

    private void ToggleGroup(string name)
    {
        if (collapsedGroups.Contains(name))
            collapsedGroups.Remove(name);
        else
            collapsedGroups.Add(name);
    }

    private static string GetStatusColor(ClusterStatus status) => status switch
    {
        ClusterStatus.Online => "#16A34A",
        ClusterStatus.Offline => "#DC2626",
        _ => "#94A3B8"
    };

    private sealed class ClusterGroupNode
    {
        public string Name { get; set; } = "";
        public List<ClusterViewModel> Clusters { get; set; } = new();
    }
}