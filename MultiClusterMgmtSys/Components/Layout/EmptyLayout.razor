@inherits LayoutComponentBase

@using MultiClusterMgmtSys.Components.Theme

@inject ThemeManager ThemeManager

<MudThemeProvider Theme="@ThemeManager.Theme"
                  IsDarkMode="@ThemeManager.IsDarkMode"
                  IsDarkModeChanged="@(v => ThemeManager.IsDarkMode = v)"
                  ObserveSystemDarkModeChange="@ThemeManager.ObserveSystemDarkModeChange" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="d-flex" Style="height:100vh;">
    <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 d-flex justify-center align-center">
        @Body
    </MudContainer>
</MudLayout>
