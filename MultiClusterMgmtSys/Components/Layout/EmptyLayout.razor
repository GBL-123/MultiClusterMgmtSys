@inherits LayoutComponentBase

@inject ThemeManager ThemeManager

<MudThemeProvider Theme="@ThemeManager.Theme"
                  IsDarkMode="@ThemeManager.IsDarkMode"
                  IsDarkModeChanged="@(v => ThemeManager.IsDarkMode = v)"
                  ObserveSystemDarkModeChange="@ThemeManager.ObserveSystemDarkModeChange" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="d-flex app-layout">
    <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 d-flex flex-grow-1 justify-center align-center">
        @Body
    </MudContainer>
</MudLayout>
