@inject NavigationManager NavigationManager

<MudDrawer @bind-Open="@IsOpen"
           ClipMode="@DrawerClipMode.Always"
           Variant="@DrawerVariant.Mini"
           Elevation="0">
    <MudNavMenu Rounded="true">
        <MudNavLink Href="/clusters" Icon="@Icons.Material.Filled.Hub" Match="NavLinkMatch.Prefix">
            集群管理
        </MudNavLink>
        <MudNavLink Href="/nodes" Icon="@Icons.Material.Filled.DeviceHub" Match="NavLinkMatch.Prefix">
            节点管理
        </MudNavLink>
        <MudNavLink Href="/configmaps" Icon="@Icons.Material.Filled.Settings" Match="NavLinkMatch.Prefix">
            配置管理
        </MudNavLink>
        <MudNavGroup Title="工作负载"
                     Icon="@Icons.Material.Filled.Widgets"
                     Expanded="@workloadsExpanded">
            <MudNavLink Href="/workloads/deployments" Icon="@Icons.Material.Filled.Dns" Match="NavLinkMatch.Prefix">
                部署管理
            </MudNavLink>
            <MudNavLink Href="/workloads/statefulsets" Icon="@Icons.Material.Filled.Storage" Match="NavLinkMatch.Prefix">
                有状态应用
            </MudNavLink>
            <MudNavLink Href="/workloads/daemonsets" Icon="@Icons.Material.Filled.Memory" Match="NavLinkMatch.Prefix">
                守护进程
            </MudNavLink>
            <MudNavLink Href="/workloads/replicasets" Icon="@Icons.Material.Filled.Layers" Match="NavLinkMatch.Prefix">
                副本集
            </MudNavLink>
        </MudNavGroup>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.ManageAccounts" Match="NavLinkMatch.Prefix">
                    账号管理
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="/audit-logs" Icon="@Icons.Material.Filled.History" Match="NavLinkMatch.Prefix">
            审计日志
        </MudNavLink>
        <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person" Match="NavLinkMatch.Prefix">
            个人资料
        </MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    private bool workloadsExpanded;

    protected override void OnInitialized()
    {
        workloadsExpanded = NavigationManager.Uri.Contains("/workloads", StringComparison.OrdinalIgnoreCase);
    }
}
