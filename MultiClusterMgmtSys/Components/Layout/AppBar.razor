@inject NavigationManager NavigationManager

<MudAppBar Elevation="0">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@MenuClick" />
    <span class="brand-mark">▮</span>
    <MudText Typo="Typo.h6" Class="mx-2">多集群管理系统</MudText>
    <span class="appbar-subtitle">MCM // CONTROL</span>
    <MudSpacer />
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit"
                           aria-label="登出"
                           OnClick="@Logout" />
        </Authorized>
    </AuthorizeView>
</MudAppBar>

@code {
    [Parameter]
    public EventCallback OnMenuClick { get; set; }

    private async Task MenuClick()
    {
        await OnMenuClick.InvokeAsync();
    }

    private async Task Logout()
    {
        var returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.NavigateTo($"/api/logout?returnUrl={returnUrl}", forceLoad: true);
    }
}