@using MultiClusterMgmtSys.Components.Theme

<MudAppBar Elevation="1">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@MenuClick" />
    <MudIcon Icon="@Icons.Material.Filled.TravelExplore" />
    <MudText Typo="Typo.h6">多集群管理系统</MudText>
    <MudSpacer />
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.body2" Class="mr-2 mud-text-secondary">@context.User.Identity?.Name</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit"
                           Title="登出"
                           OnClick="@Logout" />
        </Authorized>
    </AuthorizeView>
    <MudIconButton Icon="@(ThemeManager.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                   Color="Color.Inherit"
                   Title="切换深色模式"
                   OnClick="@OnThemeClick" />
</MudAppBar>

@code {
    [Parameter] public EventCallback OnMenuClick { get; set; }
    [Parameter] public EventCallback OnThemeClick { get; set; }

    [Inject] private ThemeManager ThemeManager { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private async Task MenuClick()
    {
        await OnMenuClick.InvokeAsync();
    }

    private async Task ThemeClick()
    {
        await OnThemeClick.InvokeAsync();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/logout", forceLoad: true);
    }
}
