<MudDialog>
    <DialogContent>
        <MudText Class="mud-dialog-content-text">@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="() => Dialog.Cancel()">
            取消
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@ConfirmIcon"
                   OnClick="Confirm">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "删除";
    [Parameter] public string ConfirmIcon { get; set; } = Icons.Material.Filled.DeleteOutline;

    private void Confirm() => Dialog.Close(DialogResult.Ok(true));
}
