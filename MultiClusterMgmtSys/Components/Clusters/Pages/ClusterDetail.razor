@attribute [Authorize]
@page "/clusters/{Id:int}"

@using MultiClusterMgmtSys.Components.Clusters.Services
@using MultiClusterMgmtSys.Components.Clusters.Shared
@using MultiClusterMgmtSys.Components.Clusters.ViewModels
@using MultiClusterMgmtSys.Components.Common

<PageTitle>集群详情</PageTitle>

<MudStack Class="d-flex flex-auto pb-4" Style="align-self: flex-start;">
    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (cluster is null)
    {
        <MudCard Class="pa-4">
            <MudCardContent>
                <MudText Align="Align.Center" Class="mud-text-secondary">未找到该集群</MudText>
                <div class="d-flex justify-center mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick='@(() => NavigationManager.NavigateTo("/clusters"))'>
                        返回集群列表
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <ClusterDetailToolbar Cluster="@cluster"
                             Processing="processing"
                             OnBack="@(() => NavigationManager.NavigateTo("/clusters"))"
                             OnRefresh="RefreshStatus"
                             OnEdit="OpenEditDialog"
                             OnDelete="DeleteCluster" />

        <ClusterOverviewCard Cluster="@cluster" />

        <ClusterEndpointsCard Cluster="@cluster"
                              OnEndpointsChanged="LoadAsync" />

        <ClusterNodesCard Cluster="@cluster" />
    }
</MudStack>

@code {
    [Parameter]
    public int Id { get; set; }

    [Inject]
    private ClusterService ClusterService { get; set; } = default!;

    [Inject]
    private ClusterSelectionState ClusterSelection { get; set; } = default!;

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private ClusterDetailViewModel? cluster;
    private bool loading;
    private bool processing;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            cluster = await ClusterService.GetClusterDetailAsync(Id);
            if (cluster is not null)
            {
                ClusterSelection.Set(Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载集群详情失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshStatus()
    {
        processing = true;
        try
        {
            await ClusterService.RefreshClusterStatusAsync(Id);
            await LoadAsync();
            Snackbar.Add("集群状态已刷新", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"刷新状态失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            processing = false;
        }
    }

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters { { "ClusterId", Id } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditClusterDialog>("编辑集群", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task DeleteCluster()
    {
        var parameters = new DialogParameters
        {
            { "Message", $"确认删除集群「{cluster?.Name ?? Id.ToString()}」？此操作不可撤销。" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("确认删除", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            processing = true;
            try
            {
                await ClusterService.DeleteClusterAsync(Id);
                Snackbar.Add("集群已删除", Severity.Success);
                NavigationManager.NavigateTo("/clusters");
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除集群失败: {ex.Message}", Severity.Error);
            }
            finally
            {
                processing = false;
            }
        }
    }
}