@using MultiClusterMgmtSys.Common.Enums
@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.Components.Clusters.ViewModels

@inject ClusterService ClusterService
@inject GroupService GroupService
@inject ISnackbar Snackbar
@inject ExceptionPresenter ExHandler

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudToggleGroup @bind-Value="connectionType"
                            Color="Color.Primary"
                            Class="mb-4"
                            Size="Size.Small">
                <MudToggleItem Value="@ConnectionType.KubeConfig">Kubeconfig</MudToggleItem>
                <MudToggleItem Value="@ConnectionType.Token">Token</MudToggleItem>
            </MudToggleGroup>

            <MudTextField @bind-Value="Name"
                          Label="集群名称"
                          Required="true"
                          RequiredError="请输入集群名称"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            <MudSelect @bind-Value="GroupId"
                       Label="所属分组"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="mb-3">
                <MudSelectItem Value="@((int?)null)">无分组</MudSelectItem>
                @foreach (var group in groups)
                {
                    <MudSelectItem Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="ApiServer"
                          Label="API Server 地址"
                          Required="@(connectionType == ConnectionType.Token)"
                          RequiredError="Token 模式必填"
                          HelperText="@(connectionType == ConnectionType.Token ? "Token 模式必填" : "可选，留空则从 kubeconfig 中解析")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-3" />

            @if (connectionType == ConnectionType.KubeConfig)
            {
                <MudText Typo="Typo.body2" Class="mb-1">KubeConfig 输入方式</MudText>
                <MudToggleGroup T="KubeConfigInputMode" @bind-Value="kubeConfigInputMode" Size="Size.Small" Class="mb-2">
                    <MudToggleItem Value="@KubeConfigInputMode.Paste">粘贴文本</MudToggleItem>
                    <MudToggleItem Value="@KubeConfigInputMode.Upload">上传文件</MudToggleItem>
                </MudToggleGroup>

                @if (kubeConfigInputMode == KubeConfigInputMode.Paste)
                {
                    <MudTextField @bind-Value="KubeConfig"
                                  Label="KubeConfig"
                                  Required="@SecretRequired"
                                  RequiredError="请填写 KubeConfig"
                                  Placeholder="@(isEdit ? "留空保持不变" : null)"
                                  HelperText="@(isEdit ? "留空保持不变" : null)"
                                  Lines="10"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                }
                else
                {
                    <InputFile OnChange="OnKubeConfigFileSelected" accept=".yaml,.yml,.config" style="width:100%;" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">接受 .yaml/.yml/.config，最大 256KB</MudText>
                    @if (!string.IsNullOrEmpty(kubeConfigFileName))
                    {
                        <MudText Typo="Typo.body2" Class="mt-2"><MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />@kubeConfigFileName</MudText>
                    }
                }
            }

            @if (connectionType == ConnectionType.Token)
            {
                <MudTextField @bind-Value="Token"
                              Label="Token"
                              Required="@SecretRequired"
                              RequiredError="请填写 Token"
                              Placeholder="@(isEdit ? "留空保持不变" : null)"
                              HelperText="@(isEdit ? "留空保持不变" : null)"
                              Lines="4"
                              InputType="@(showToken ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => showToken = !showToken)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-3" />

                <MudCheckBox T="bool" @bind-Value="SkipTlsVerify"
                             Label="跳过 TLS 验证"
                             Color="Color.Warning" />
            }

            @if (isEdit)
            {
                <MudText Typo="Typo.caption"
                         Class="mud-text-secondary mt-2">
                    连接配置变更后保存将重新检测集群状态
                </MudText>
            }

            @if (!isEdit)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">集群端点</MudText>
                <ClusterEndpointEditor Items="@endpoints" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()"
                   Variant="Variant.Text"
                   Disabled="saving">
            取消
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="saving"
                   StartIcon="@(saving ? null : (isEdit ? Icons.Material.Filled.Save : Icons.Material.Filled.Add))">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(isEdit ? "保存" : "添加")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public int? ClusterId { get; set; }

    [CascadingParameter]
    public IMudDialogInstance Dialog { get; set; } = default!;

    private MudForm form = default!;

    private List<ClusterGroupViewModel> groups = new();

    private ConnectionType connectionType = ConnectionType.KubeConfig;

    private ConnectionType? originalConnectionType;

    private string Name = "";

    private int? GroupId;

    private string ApiServer = "";

    private string KubeConfig = "";

    private string Token = "";

    private bool SkipTlsVerify = true;

    private bool showToken;

    private bool saving;

    private KubeConfigInputMode kubeConfigInputMode = KubeConfigInputMode.Paste;

    private string? kubeConfigFileName;

    private List<ClusterEndpointEditItem> endpoints = new();

    private ClusterEditViewModel? editVm;

    private bool isEdit => ClusterId.HasValue;

    private bool SecretRequired => !isEdit || connectionType != originalConnectionType;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (isEdit)
            {
                editVm = await ClusterService.GetClusterForEditAsync(ClusterId!.Value);
                if (editVm is null)
                {
                    Snackbar.Add("未找到该集群", Severity.Error);
                    Dialog.Cancel();
                    return;
                }

                Name = editVm.Name;
                GroupId = editVm.GroupId;
                ApiServer = editVm.ApiServer ?? "";
                connectionType = editVm.ConnectionType;
                originalConnectionType = editVm.ConnectionType;
                SkipTlsVerify = editVm.SkipTlsVerify;
            }

            groups = await GroupService.GetGroupsAsync();
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群信息");
            Dialog.Cancel();
        }
    }

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid)
            return;

        // 上传模式没有文本域触发 Required 校验，需要手动兜底
        if (connectionType == ConnectionType.KubeConfig && string.IsNullOrWhiteSpace(KubeConfig) && SecretRequired)
        {
            Snackbar.Add("请填写 KubeConfig", Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            if (isEdit)
            {
                var vm = new ClusterUpdateViewModel
                {
                    Id = ClusterId!.Value,
                    Name = Name,
                    GroupId = GroupId,
                    ConnectionType = connectionType,
                    ApiServer = string.IsNullOrWhiteSpace(ApiServer) ? null : ApiServer,
                    KubeConfig = connectionType == ConnectionType.KubeConfig
                        ? (string.IsNullOrWhiteSpace(KubeConfig) ? editVm!.KubeConfig : KubeConfig)
                        : null,
                    Token = connectionType == ConnectionType.Token
                        ? (string.IsNullOrWhiteSpace(Token) ? editVm!.Token : Token)
                        : null,
                    SkipTlsVerify = SkipTlsVerify
                };

                await ClusterService.UpdateClusterAsync(vm);
                Snackbar.Add("集群已更新", Severity.Success);
            }
            else
            {
                var vm = new ClusterCreateViewModel
                {
                    Name = Name,
                    GroupId = GroupId,
                    ConnectionType = connectionType,
                    ApiServer = string.IsNullOrWhiteSpace(ApiServer) ? null : ApiServer,
                    KubeConfig = connectionType == ConnectionType.KubeConfig ? KubeConfig : null,
                    Token = connectionType == ConnectionType.Token ? Token : null,
                    SkipTlsVerify = SkipTlsVerify,
                    Endpoints = endpoints
                };

                await ClusterService.AddClusterAsync(vm);
                Snackbar.Add("集群添加成功", Severity.Success);
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "保存集群");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task OnKubeConfigFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > 256 * 1024)
        {
            Snackbar.Add("文件超过 256KB 限制", Severity.Warning);
            return;
        }
        try
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 256 * 1024));
            KubeConfig = await reader.ReadToEndAsync();
            kubeConfigFileName = file.Name;
            Snackbar.Add($"已读取文件：{file.Name}", Severity.Info);
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "读取文件");
        }
    }

    private enum KubeConfigInputMode { Paste, Upload }
}
