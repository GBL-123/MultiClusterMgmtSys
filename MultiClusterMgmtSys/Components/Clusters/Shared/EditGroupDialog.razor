@using MultiClusterMgmtSys.Components.Clusters.Requests
@using MultiClusterMgmtSys.Components.Clusters.Services

@inject GroupService GroupService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField @bind-Value="Name"
                          Label="分组名称"
                          Required="true"
                          RequiredError="请输入分组名称"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()"
                   Variant="Variant.Text"
                   Disabled="saving">
            取消
        </MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="saving"
                   StartIcon="@(saving ? null : (IsRename ? Icons.Material.Filled.Save : Icons.Material.Filled.Add))">
            @if (saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsRename ? "保存" : "添加")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public int? GroupId { get; set; }
    [Parameter] public string? InitialName { get; set; }

    private MudForm form = default!;
    private string Name = "";
    private bool saving;
    private bool IsRename => GroupId.HasValue;

    protected override void OnInitialized()
    {
        Name = InitialName ?? "";
    }

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;

        saving = true;
        try
        {
            if (GroupId is null)
            {
                await GroupService.AddGroupAsync(new GroupCreateRequest { Name = Name });
                Snackbar.Add("分组已创建", Severity.Success);
            }
            else
            {
                await GroupService.RenameGroupAsync(GroupId.Value, Name);
                Snackbar.Add("分组已重命名", Severity.Success);
            }
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }
}