<MudStack>
    <div class="d-flex flex-wrap align-center gap-3 mb-4">
        <MudTextField T="string"
                      Value="@Filters.Name"
                      ValueChanged="OnNameChanged"
                      Label="搜索集群名称"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="min-width:200px; flex:1;" />

        <MudSelect T="int?"
                   Value="@Filters.GroupId"
                   ValueChanged="OnGroupChanged"
                   Label="分组"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="width:160px;">
            <MudSelectItem Value="@((int?)null)">全部分组</MudSelectItem>
            @foreach (var g in Groups)
            {
                <MudSelectItem Value="@((int?)g.Id)">@g.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="ClusterStatus?"
                   Value="@Filters.Status"
                   ValueChanged="OnStatusChanged"
                   Label="状态"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="width:140px;">
            <MudSelectItem Value="@((ClusterStatus?)null)">全部</MudSelectItem>
            <MudSelectItem Value="@((ClusterStatus?)ClusterStatus.Online)">在线</MudSelectItem>
            <MudSelectItem Value="@((ClusterStatus?)ClusterStatus.Offline)">离线</MudSelectItem>
            <MudSelectItem Value="@((ClusterStatus?)ClusterStatus.Unknown)">未知</MudSelectItem>
        </MudSelect>

        <MudSelect T="string"
                   Value="@Filters.Version"
                   ValueChanged="OnVersionChanged"
                   Label="版本"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="width:160px;">
            <MudSelectItem Value="@("__ALL__")">全部</MudSelectItem>
            @foreach (var v in AvailableVersions)
            {
                <MudSelectItem Value="@v">@v</MudSelectItem>
            }
            <MudSelectItem Value="@("__NULL__")">未知</MudSelectItem>
        </MudSelect>

        <MudDatePicker T="DateTime?"
                       Value="@Filters.DateStart"
                       ValueChanged="OnDateStartChanged"
                       Label="开始时间"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="width:160px;" />

        <MudDatePicker T="DateTime?"
                       Value="@Filters.DateEnd"
                       ValueChanged="OnDateEndChanged"
                       Label="结束时间"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="width:160px;" />

        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   OnClick="ResetFilter">
            重置
        </MudButton>
    </div>
</MudStack>

@code {
    [Parameter] public ClusterQuery Filters { get; set; } = new();
    [Parameter] public IReadOnlyList<ClusterGroupViewModel> Groups { get; set; } = [];
    [Parameter] public IReadOnlyList<string> AvailableVersions { get; set; } = [];
    [Parameter] public EventCallback OnFilterChanged { get; set; }

    private Task OnNameChanged(string? v)
    {
        Filters.Name = v;
        return OnFilterChanged.InvokeAsync();
    }

    private Task OnGroupChanged(int? v)
    {
        Filters.GroupId = v;
        return OnFilterChanged.InvokeAsync();
    }

    private Task OnStatusChanged(ClusterStatus? v)
    {
        Filters.Status = v;
        return OnFilterChanged.InvokeAsync();
    }

    private Task OnVersionChanged(string? v)
    {
        Filters.Version = v;
        return OnFilterChanged.InvokeAsync();
    }

    private Task OnDateStartChanged(DateTime? v)
    {
        Filters.DateStart = v;
        return OnFilterChanged.InvokeAsync();
    }

    private Task OnDateEndChanged(DateTime? v)
    {
        Filters.DateEnd = v;
        return OnFilterChanged.InvokeAsync();
    }

    private Task ResetFilter()
    {
        Filters.Name = null;
        Filters.GroupId = null;
        Filters.Status = null;
        Filters.Version = null;
        Filters.DateStart = null;
        Filters.DateEnd = null;
        return OnFilterChanged.InvokeAsync();
    }
}