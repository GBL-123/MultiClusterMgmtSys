@using MultiClusterMgmtSys.Common.Enums
@using MultiClusterMgmtSys.Components.Clusters.Requests
@using MultiClusterMgmtSys.Components.Clusters.Services
@using MultiClusterMgmtSys.Components.Clusters.ViewModels

@inject ClusterService ClusterService

<MudTable ServerData="@LoadData"
          Hover="true"
          FixedHeader="true"
          Class="clusters-table"
          @key="tableKey"
          @ref="table">
    <HeaderContent>
        @if (MultiSelectVisible)
        {
            <MudTh Style="width:48px;"></MudTh>
        }
        <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.Name)" SortLabel="Name">名称</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.Status)" SortLabel="Status">状态</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.Version)" SortLabel="Version">版本</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.NodeCount)" SortLabel="NodeCount">节点数</MudTableSortLabel></MudTh>
        <MudTh>分组</MudTh>
        <MudTh>API Server</MudTh>
        <MudTh><MudTableSortLabel T="ClusterViewModel" SortBy="@(x => x.CreatedAt)" SortLabel="CreatedAt">创建时间</MudTableSortLabel></MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        @if (MultiSelectVisible)
        {
            <MudTd Style="width:48px;">
                <MudCheckBox T="bool"
                             Value="@SelectedIds.Contains(context.Id)"
                             ValueChanged="@(v => OnRowCheckChanged(context.Id, v))" />
            </MudTd>
        }
        <MudTd DataLabel="名称">
            <MudText Color="Color.Primary"
                     Style="cursor:pointer; text-decoration: underline;"
                     @onclick="() => OnNavigateClusterDetail.InvokeAsync(context.Id)">
                @context.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="状态">
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(context.Status switch
                     {
                         ClusterStatus.Online => Color.Success,
                         ClusterStatus.Offline => Color.Error,
                         _ => Color.Default
                     })"
                     Variant="Variant.Filled">
                @context.StatusText
            </MudChip>
        </MudTd>
        <MudTd DataLabel="版本">@(context.Version ?? "未知")</MudTd>
        <MudTd DataLabel="节点数">@context.NodeCount</MudTd>
        <MudTd DataLabel="分组">@(context.GroupName ?? "未分组")</MudTd>
        <MudTd DataLabel="API Server">
            <MudText Style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                     Title="@context.ApiServer">
                @(context.ApiServer ?? "未知")
            </MudText>
        </MudTd>
        <MudTd DataLabel="创建时间">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
        <MudTd DataLabel="操作">
            <AuthorizeView Roles="Admin">
                <Authorized Context="authContext">
                        @if (ProcessingIds.Contains(context.Id))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mr-2" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                           Size="Size.Small"
                                           OnClick="@(() => OnRefreshCluster.InvokeAsync(context.Id))"
                                           Disabled="RefreshingAll" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => OnEditCluster.InvokeAsync(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => OnDeleteCluster.InvokeAsync(context))"
                                       Disabled="@(RefreshingAll || ProcessingIds.Contains(context.Id))" />

                </Authorized>
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="每页条数：" InfoFormat="共 {all_items} 条" />
    </PagerContent>
    <LoadingContent>
        <MudText>正在加载...</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <MudText>暂无集群或没有符合筛选条件的集群</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public ClusterQueryRequest Query { get; set; } = new();

    [Parameter]
    public EventCallback<int> OnRefreshCluster { get; set; }

    [Parameter]
    public EventCallback<int> OnEditCluster { get; set; }

    [Parameter]
    public EventCallback<ClusterViewModel> OnDeleteCluster { get; set; }

    [Parameter]
    public EventCallback<int> OnNavigateClusterDetail { get; set; }

    [Parameter]
    public HashSet<int> ProcessingIds { get; set; } = new();

    [Parameter]
    public bool RefreshingAll { get; set; }

    [Parameter]
    public bool MultiSelectVisible { get; set; }

    [Parameter]
    public HashSet<int> SelectedIds { get; set; } = new();

    [Parameter]
    public EventCallback<HashSet<int>> OnSelectedIdsChanged { get; set; }

    private MudTable<ClusterViewModel> table = new();

    private int tableKey;

    private async Task<TableData<ClusterViewModel>> LoadData(TableState state, CancellationToken _)
    {
        Query.SortBy = state.SortLabel switch
        {
            "Name" => ClusterSortField.Name,
            "Status" => ClusterSortField.Status,
            "Version" => ClusterSortField.Version,
            "NodeCount" => ClusterSortField.NodeCount,
            "CreatedAt" => ClusterSortField.CreatedAt,
            _ => ClusterSortField.CreatedAt
        };
        Query.SortDescending = state.SortDirection != SortDirection.Ascending;
        Query.Page = state.Page + 1;
        Query.PageSize = state.PageSize;
        var result = await ClusterService.GetPagedAsync(Query);

        return new TableData<ClusterViewModel>
        {
            Items = result.Items,
            TotalItems = result.Total
        };
    }

    /// <summary>
    /// Cross-page selection: toggling a row's checkbox merges (or removes) the row's id into
    /// the parent's persistent <see cref="SelectedIds"/> set, then notifies via
    /// <see cref="OnSelectedIdsChanged"/>. Selection survives page changes because the parent
    /// owns the canonical state, not MudTable.
    /// </summary>
    private async Task OnRowCheckChanged(int clusterId, bool @checked)
    {
        if (@checked)
        {
            selectedClusterIds.Add(clusterId);
        }
        else
        {
            selectedClusterIds.Remove(clusterId);
        }
        await OnSelectedIdsChanged.InvokeAsync(selectedClusterIds);
    }

    private HashSet<int> selectedClusterIds => SelectedIds;

    public Task ReloadDataAsync() => table.ReloadServerData();

    public Task ResetSortAsync()
    {
        tableKey++;          // 改变 key → Blazor 销毁重建 MudTable
        StateHasChanged();   // 排序箭头、分页全部回到初始状态，自动重新加载
        return Task.CompletedTask;
    }

    public void ClearSelection()
    {
        var ids = SelectedIds;
        foreach (var id in ids)
        {
            SelectedIds.Remove(id);
        }
        // Tell parent we cleared so its state stays in sync.
        _ = OnSelectedIdsChanged.InvokeAsync(SelectedIds);
        StateHasChanged();
    }
}