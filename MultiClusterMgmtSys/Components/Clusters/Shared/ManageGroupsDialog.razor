@using MultiClusterMgmtSys.Components.Clusters.ViewModels
@using MultiClusterMgmtSys.Components.Clusters.Services

@inject GroupService GroupService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">分组管理</MudText>
        @if (loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (!groups.Any())
        {
            <MudText Class="mud-text-secondary" Align="Align.Center">暂无分组，点击「新建分组」创建</MudText>
        }
        else
        {
            <MudTable T="ClusterGroupViewModel" Items="@groups" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>分组名称</MudTh>
                    <MudTh Style="width:100px;">集群数</MudTh>
                    <MudTh Style="width:80px;">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="分组名称">@context.Name</MudTd>
                    <MudTd DataLabel="集群数">@context.ClusterCount</MudTd>
                    <MudTd DataLabel="操作">
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="authContext">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteGroup(context))" />
                            </Authorized>
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="OpenCreateGroupDialog" Disabled="loading">新建分组</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="() => Dialog.Close(DialogResult.Ok(groupChanged))">关闭</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    

    private List<ClusterGroupViewModel> groups = new();
    private bool loading;
    private bool groupChanged;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        loading = true;
        try
        {
            groups = await GroupService.GetGroupsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载分组失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task DeleteGroup(ClusterGroupViewModel group)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "确认删除",
            $"确认删除分组「{group.Name}」？分组内集群将变为未分组。",
            yesText: "删除",
            noText: "取消");
        if (confirmed == true)
        {
            try
            {
                await GroupService.DeleteGroupAsync(group.Id);
                Snackbar.Add("分组已删除", Severity.Success);
                groupChanged = true;
                await LoadGroupsAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"删除分组失败: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenCreateGroupDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateGroupDialog>("新建分组", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            groupChanged = true;
            await LoadGroupsAsync();
        }
    }
}
