@attribute [Authorize]
@page "/events"
@page "/events/{ClusterId:int}"

@using MultiClusterMgmtSys.Common.Enums
@using MultiClusterMgmtSys.Models
@using MultiClusterMgmtSys.Requests
@using MultiClusterMgmtSys.Services
@using MultiClusterMgmtSys.ViewModels
@using MultiClusterMgmtSys.Components.Events.Shared

@inject ClusterService ClusterService
@inject EventService EventService
@inject ClusterSelectionState ClusterSelection
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ExceptionPresenter ExHandler

<PageTitle>事件管理</PageTitle>

<MudStack Row="true" Spacing="3" Class="d-flex flex-auto">
    <ClusterSelectSidebar Clusters="@clusters"
                          SelectedClusterId="@EffectiveClusterId"
                          OnClusterSelected="SelectCluster" />

    <MudStack Class="flex-auto">
        @if (!EffectiveClusterId.HasValue)
        {
            <div class="d-flex flex-column align-center justify-center" style="min-height:60vh;">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Large" Class="mud-text-secondary mb-4" />
                <MudText Typo="Typo.h6" Class="mud-text-secondary">请从左侧选择一个集群</MudText>
            </div>
        }
        else if (loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else if (cluster is null)
        {
            <MudCard Class="pa-8" Elevation="2">
                <MudCardContent>
                    <MudText Align="Align.Center" Class="mud-text-secondary">未找到该集群</MudText>
                    <div class="d-flex justify-center mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => NavigationManager.NavigateTo("/clusters"))">
                            返回集群列表
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Class="pa-4">
                <MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">事件管理</MudText>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="GetClusterStatusColor(cluster.Status)"
                                 Variant="Variant.Filled"
                                 Class="ml-2">
                            @cluster.Name · @cluster.StatusText
                        </MudChip>
                    </MudStack>

                    @if (cluster.IsReachable)
                    {
                        <EventListFilterBar Namespaces="@namespaces"
                                            @bind-SelectedNamespace="selectedNamespace"
                                            @bind-SelectedType="selectedType"
                                            KindOptions="@kindOptions"
                                            TotalCount="@kindTotalCount"
                                            @bind-SelectedKind="selectedKind"
                                            @bind-Keyword="keyword"
                                            LastLoadedAt="@lastLoadedAt"
                                            Refreshing="@loading"
                                            OnReset="OnResetClick"
                                            OnRefresh="RefreshAsync" />
                    }
                </MudStack>
            </MudPaper>

            @if (!cluster.IsReachable)
            {
                <MudCard Elevation="1">
                    <MudCardContent>
                        <MudText Align="Align.Center" Class="mud-text-secondary">集群不可达，无法获取事件</MudText>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <EventListTable Items="@filteredEvents"
                                Loading="@loading"
                                OnOpenDetail="OpenDetail"
                                OnNavigateDetail="NavigateToDetail" />
            }
        }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public int? ClusterId { get; set; }

    private List<ClusterViewModel> clusters = new();

    private ClusterDetailViewModel? cluster;

    private List<EventListViewModel> events = new();

    private List<string> namespaces = new();

    private bool loading;

    private string? selectedNamespace;

    private string? selectedType;

    private string selectedKind = "";

    private string keyword = "";

    private DateTime? lastLoadedAt;

    private int? previousClusterId;

    private bool hasInitialized;

    private int? EffectiveClusterId => ClusterId ?? ClusterSelection.SelectedClusterId;

    private List<EventListViewModel> filteredEvents
        => events.Apply(selectedNamespace, selectedType, selectedKind, keyword)
            .OrderByDescending(e => e.OccurredAt)
            .ToList();

    private List<EventKindOption> kindOptions
        => events.KindOptions(selectedNamespace, selectedType, keyword);

    private int kindTotalCount
        => events.Apply(selectedNamespace, selectedType, null, keyword).Count();

    protected override async Task OnInitializedAsync()
    {
        await LoadClustersAsync();
    }

    protected override void OnParametersSet()
    {
        if (ClusterId.HasValue)
        {
            ClusterSelection.Set(ClusterId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId == previousClusterId && hasInitialized)
        {
            return;
        }
        hasInitialized = true;
        previousClusterId = ClusterId;

        if (EffectiveClusterId.HasValue)
        {
            await LoadAsync(EffectiveClusterId.Value);
        }
        else
        {
            cluster = null;
            events = new();
            namespaces = new();
            loading = false;
        }
    }

    private async Task LoadClustersAsync()
    {
        try
        {
            var request = new ClusterQueryRequest { Page = 1, PageSize = 1000, SortBy = ClusterSortField.Name, SortDescending = false };
            var result = await ClusterService.GetPagedAsync(request);
            clusters = result.Items;
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群列表");
        }
    }

    private async Task LoadAsync(int id)
    {
        loading = true;
        try
        {
            cluster = await ClusterService.GetClusterDetailAsync(id);
            if (cluster is not null)
            {
                ClusterSelection.Set(id);
            }
            if (cluster is not null && cluster.IsReachable)
            {
                try
                {
                    namespaces = await EventService.GetNamespacesAsync(id);
                }
                catch (Exception ex)
                {
                    await ExHandler.HandleAsync(ex, "加载命名空间列表");
                }

                try
                {
                    events = await EventService.ListEventsAsync(new EventQueryRequest(id));
                    lastLoadedAt = DateTime.Now;
                }
                catch (Exception ex)
                {
                    await ExHandler.HandleAsync(ex, "加载事件列表");
                }
            }
            else
            {
                events = new();
                namespaces = new();
            }
        }
        catch (Exception ex)
        {
            await ExHandler.HandleAsync(ex, "加载集群详情");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (!EffectiveClusterId.HasValue) return;
        await LoadAsync(EffectiveClusterId.Value);
    }

    private void SelectCluster(int id)
    {
        NavigationManager.NavigateTo($"/events/{id}");
    }

    private void OnResetClick()
    {
        selectedNamespace = null;
        selectedType = null;
        selectedKind = "";
        keyword = "";
    }

    private async Task OpenDetail(EventListViewModel item)
    {
        var parameters = new DialogParameters { { "Event", item } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<EventDetailDialog>("事件详情", parameters, options);
    }

    private void NavigateToDetail(string route)
    {
        NavigationManager.NavigateTo(route);
    }

    private static Color GetClusterStatusColor(ClusterStatus status) => status switch
    {
        ClusterStatus.Online => Color.Success,
        ClusterStatus.Offline => Color.Error,
        _ => Color.Default
    };
}
